<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.BatchTagImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Client.Services"
    Background="#FFFFFF"
    BorderBrush="#E2E5F0"
    BorderThickness="1"
    CornerRadius="12"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid Width="780" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="微信通讯录管理 · 按标签批量导入" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="固定微信窗口尺寸 + RapidOCR 定位标签与行位 + 受控模拟点击抓资料卡并自动去重入库" />
            </StackPanel>

            <Button
                x:Name="CloseButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Style="{StaticResource DialogCloseButtonStyle}"
                ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!-- Row 1: Status Banner + Step 1 Locate & Scan Bar -->
        <Border
            Grid.Row="1"
            Padding="14,10"
            Background="#F8F7FF"
            BorderBrush="{StaticResource BrandSoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="ScanStatusTitle"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="步骤 1：定位微信「通讯录管理」窗口并扫描标签" />
                    <TextBlock
                        x:Name="ScanStatusSubText"
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="建议先在微信打开「通讯录管理」；未打开时系统也会尝试从微信主窗口自动点开。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    x:Name="ScanTagsButton"
                    Grid.Column="1"
                    Height="34"
                    Padding="14,0"
                    Click="ScanTagsButton_Click"
                    Content="定位窗口并扫描标签"
                    FontSize="12.5"
                    Style="{StaticResource PrimaryVioletButtonStyle}" />

                <Button
                    x:Name="ScrollMoreTagsButton"
                    Grid.Column="2"
                    Height="34"
                    Padding="10,0"
                    Click="ScrollMoreTagsButton_Click"
                    Content="下滚重扫"
                    FontSize="12"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                    ToolTipService.ToolTip="如标签较多，可向下滚动左侧标签栏重新扫描" />
            </Grid>
        </Border>

        <!-- Row 2: Two-Column Body (Left Tag Selector | Right Options & Live Progress) -->
        <Grid Grid.Row="2" ColumnSpacing="16" Height="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Detected WeChat Tags List + Manual Tag Entry -->
            <Border
                Grid.Column="0"
                Padding="12"
                Background="#FAFAFC"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="勾选要导入的微信标签" VerticalAlignment="Center" />
                        <Button
                            HorizontalAlignment="Right"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ToggleSelectAllButton_Click"
                            Content="全选/取消"
                            FontSize="11.5"
                            Foreground="{StaticResource BrandPrimaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel
                            x:Name="EmptyTagsHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="10"
                            Spacing="6">
                            <FontIcon FontSize="22" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE8EC;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="点击上方「定位窗口并扫描标签」&#x0a;自动读取微信左侧标签列表"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ListView x:Name="TagsListView" SelectionMode="None" Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2,2" />
                                    <Setter Property="MinHeight" Value="34" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:WeChatTagItem">
                                    <Border Padding="8,4" Background="#FFFFFF" BorderBrush="#EAECF2" BorderThickness="1" CornerRadius="7">
                                        <CheckBox
                                            Content="{x:Bind DisplayLabel}"
                                            FontSize="12.5"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            MinWidth="0" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Manual tag name fallback -->
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ManualTagBox"
                            Grid.Column="0"
                            Height="30"
                            Padding="8,4"
                            FontSize="12"
                            PlaceholderText="手动补充标签名..."
                            Style="{StaticResource SoftTextBoxStyle}" />
                        <Button
                            Grid.Column="1"
                            Height="30"
                            Padding="9,0"
                            Click="AddManualTagButton_Click"
                            Content="添加"
                            FontSize="11.5"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Strategy Settings + Live Progress & Logs -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Options Card -->
                <Border Grid.Row="0" Padding="12" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="去重处理方式" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="DedupSkipRadio" Content="自动去重跳过（推荐）" FontSize="12" GroupName="BatchDedup" IsChecked="True" MinWidth="0" Padding="4,0,0,0" />
                                <RadioButton x:Name="DedupOverwriteRadio" Content="覆盖更新（保留员工备注）" FontSize="12" GroupName="BatchDedup" MinWidth="0" Padding="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Padding="9,6" Background="{StaticResource WarningBgBrush}" CornerRadius="6">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource WarningTextBrush}"
                                Text="安全保护：导入期间请勿操作鼠标；随时移动鼠标或按 ESC 键可立即熔断停止。"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 4 Live Stat Cards + ProgressBar -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="10,7" Background="#F4F5F9" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="已识别" />
                                <TextBlock x:Name="StatProcessedText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="10,7" Background="{StaticResource SuccessBgBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource SuccessTextBrush}" Text="新增入库" />
                                <TextBlock x:Name="StatCreatedText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="10,7" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Text="覆盖更新" />
                                <TextBlock x:Name="StatUpdatedText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="10,7" Background="#F3F4F6" CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="去重跳过" />
                                <TextBlock x:Name="StatSkippedText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ProgressBar x:Name="ImportProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource BrandPrimaryBrush}" />
                </StackPanel>

                <!-- Live Log Console -->
                <Border Grid.Row="2" Padding="10,8" Background="#FAFAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer x:Name="LogScrollViewer">
                        <TextBlock
                            x:Name="LiveLogText"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="18"
                            Text="等待扫描微信标签..."
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 3: Footer -->
        <Border Grid.Row="3" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    x:Name="FooterStatusText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="请先点击「定位窗口并扫描标签」" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="StopImportButton"
                        Height="34"
                        Padding="16,0"
                        Click="StopImportButton_Click"
                        Content="停止导入"
                        FontSize="12.5"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="StartImportButton"
                        Height="34"
                        Padding="18,0"
                        Click="StartImportButton_Click"
                        Content="开始批量导入"
                        FontSize="12.5"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryVioletButtonStyle}" />

                    <Button
                        x:Name="DoneButton"
                        Height="34"
                        Padding="14,0"
                        Click="CloseButton_Click"
                        Content="关闭"
                        FontSize="12.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

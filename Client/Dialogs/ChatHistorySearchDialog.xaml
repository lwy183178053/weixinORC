<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ChatHistorySearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:Client.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="740" Height="610">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Dialog Header -->
        <Border
            Grid.Row="0"
            Padding="20,13,14,13"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{StaticResource BrandSoftBgBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <FontIcon FontSize="15" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE721;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="DialogTitleText"
                            FontSize="15.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="查找聊天记录" />
                        <TextBlock
                            x:Name="DialogSubtitleText"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="正在加载历史聊天记录..." />
                    </StackPanel>
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <!-- Row 1: Search Box + Calendar Date Picker + Type Filter -->
        <Border
            Grid.Row="1"
            Padding="18,12"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderSubtleBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="KeywordBox"
                        Grid.Column="0"
                        Height="34"
                        Padding="10,6"
                        FontSize="12.5"
                        PlaceholderText="输入关键词搜索聊天内容或发言人..."
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextChanged="KeywordBox_TextChanged" />

                    <CalendarDatePicker
                        x:Name="ChatDatePicker"
                        Grid.Column="1"
                        Width="166"
                        Height="34"
                        DateChanged="ChatDatePicker_DateChanged"
                        DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                        PlaceholderText="选择日期查看" />

                    <Button
                        x:Name="ClearDateButton"
                        Grid.Column="2"
                        Height="34"
                        Padding="10,0"
                        Click="ClearDateButton_Click"
                        Content="全部日期"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        Visibility="Collapsed" />
                </Grid>

                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="TypeAllBtn" Height="26" Padding="10,0" Click="MediaFilter_Click" Content="全部" CornerRadius="13" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="all" />
                        <Button x:Name="TypeTextBtn" Height="26" Padding="10,0" Click="MediaFilter_Click" Content="文字" CornerRadius="13" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="text" />
                        <Button x:Name="TypeImageBtn" Height="26" Padding="10,0" Click="MediaFilter_Click" Content="图片" CornerRadius="13" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="image" />
                        <Button x:Name="TypeAudioBtn" Height="26" Padding="10,0" Click="MediaFilter_Click" Content="语音" CornerRadius="13" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="audio" />
                        <Button x:Name="TypeVideoBtn" Height="26" Padding="10,0" Click="MediaFilter_Click" Content="视频" CornerRadius="13" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="video" />
                    </StackPanel>

                    <TextBlock
                        x:Name="MatchSummaryText"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="共 0 条结果" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Quick Active Dates Pill Bar -->
        <Border
            x:Name="DateChipsBar"
            Grid.Row="2"
            Padding="18,7"
            Background="{StaticResource AppCanvasBgBrush}"
            BorderBrush="{StaticResource AppBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="有记录日期：" />
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="DateChipsPanel" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Row 3: Results List / Loading / Empty -->
        <Grid Grid.Row="3" Background="{StaticResource AppSurfaceBrush}">
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    FontSize="12.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="正在加载历史聊天记录..." />
            </StackPanel>

            <StackPanel
                x:Name="EmptyResultsHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon FontSize="26" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE721;" />
                <TextBlock
                    x:Name="EmptyResultsTitle"
                    HorizontalAlignment="Center"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="未找到匹配的聊天记录" />
                <TextBlock
                    x:Name="EmptyResultsSub"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="试试切换关键词、选择其他日期或点击「全部日期」" />
            </StackPanel>

            <ListView
                x:Name="ResultsListView"
                Padding="14,8"
                IsItemClickEnabled="True"
                ItemClick="ResultsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,3" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:ChatHistorySearchItem">
                        <Border
                            Padding="12,10"
                            Background="{StaticResource AppSurfaceAltBrush}"
                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    Background="{x:Bind AvatarBgBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{x:Bind AvatarFgBrush}"
                                        Text="{x:Bind SenderInitial}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{x:Bind SenderName}" />
                                            <Border
                                                Padding="6,1"
                                                Background="{StaticResource InfoBgBrush}"
                                                CornerRadius="5"
                                                Visibility="{x:Bind MediaBadgeVisibility}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource InfoTextBrush}"
                                                    Text="{x:Bind MediaBadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="{x:Bind FullTimeText}" />
                                    </Grid>

                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        LineHeight="19"
                                        MaxLines="4"
                                        Text="{x:Bind DisplayPreview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <Button
                                        Height="26"
                                        Padding="8,0"
                                        Click="ViewImageButton_Click"
                                        Content="看图"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Visibility="{x:Bind HasImageVisibility}" />
                                    <Button
                                        Height="26"
                                        Padding="9,0"
                                        Click="JumpToMessageButton_Click"
                                        Content="定位"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="定位到主聊天界面此条消息" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Row 4: Footer -->
        <Border
            Grid.Row="4"
            Padding="18,10"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,10,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="FooterHintText"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="点击任意消息或右侧「定位」可直接跳转到主聊天记录对应位置" />
                    <Button
                        x:Name="LoadMoreHistoryButton"
                        Height="26"
                        Padding="10,0"
                        Click="LoadMoreHistoryButton_Click"
                        Content="继续加载更早记录"
                        FontSize="11.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    Height="30"
                    Padding="16,0"
                    Click="CloseButton_Click"
                    Content="关闭"
                    FontSize="12"
                    Style="{StaticResource SecondaryOutlineButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.EditCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="640" Height="550">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header + Clean 2-Tab Strip -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0">
            <StackPanel>
                <!-- Title Row -->
                <Grid Padding="20,14,14,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="HeaderAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="客" />
                                <Image x:Name="HeaderAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="编辑客户资料" />
                            <TextBlock x:Name="HeaderSubtitleText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="-" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        ToolTipService.ToolTip="关闭 (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- Tab Switcher: 基本资料 | 员工备注 -->
                <Grid Padding="20,0" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="TabProfileBtn"
                        Grid.Column="0"
                        Height="36"
                        Padding="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabSwitch_Click"
                        CornerRadius="0"
                        Tag="profile">
                        <Grid Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TabProfileIcon" FontSize="13" Glyph="&#xE77B;" />
                                <TextBlock x:Name="TabProfileText" FontSize="13" FontWeight="SemiBold" Text="基本资料" />
                            </StackPanel>
                            <Border x:Name="TabProfileLine" Height="2.5" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="TabNotesBtn"
                        Grid.Column="1"
                        Height="36"
                        Padding="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TabSwitch_Click"
                        CornerRadius="0"
                        Tag="notes">
                        <Grid Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TabNotesIcon" FontSize="13" Glyph="&#xE70B;" />
                                <TextBlock x:Name="TabNotesText" FontSize="13" Text="员工备注" />
                            </StackPanel>
                            <Border x:Name="TabNotesLine" Height="2.5" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 1: Tab Content Body -->
        <Grid Grid.Row="1" Background="{StaticResource ContentDialogBackground}">
            <!-- TAB 1: 基本资料 -->
            <ScrollViewer x:Name="ProfileTabScroll" Padding="20,16">
                <StackPanel Spacing="12">
                    <!-- Compact Avatar Card -->
                    <Border Padding="12" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="9">
                                <Grid>
                                    <TextBlock x:Name="PreviewAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="客" />
                                    <Image x:Name="PreviewAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="客户头像" />
                                <TextBlock x:Name="AvatarStatusText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="支持粘贴剪贴板图片或选择本地图片" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <Button Height="28" Padding="10,0" Click="PasteAvatarBtn_Click" Content="粘贴图片" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Height="28" Padding="10,0" Click="UploadAvatarBtn_Click" Content="本地上传" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button x:Name="ClearAvatarBtn" Height="28" Padding="8,0" Click="ClearAvatarBtn_Click" Content="清除" FontSize="11.5" Style="{StaticResource DangerOutlineButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Nickname & WeChat Account -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditNameBox" Grid.Column="0" Header="微信昵称" Style="{StaticResource SoftTextBoxStyle}" />
                        <TextBox x:Name="EditAccountBox" Grid.Column="1" Header="微信号" Style="{StaticResource SoftTextBoxStyle}" />
                    </Grid>

                    <!-- Row 2: Remark & Gender -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditRemarkBox" Grid.Column="0" Header="微信备注" Style="{StaticResource SoftTextBoxStyle}" />
                        <ComboBox x:Name="EditGenderBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="性别" SelectedIndex="0">
                            <ComboBoxItem Content="未知" />
                            <ComboBoxItem Content="男" />
                            <ComboBoxItem Content="女" />
                        </ComboBox>
                    </Grid>

                    <!-- Row 3: Region & Phone -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditRegionBox" Grid.Column="0" Header="地区" Style="{StaticResource SoftTextBoxStyle}" />
                        <TextBox x:Name="EditPhoneBox" Grid.Column="1" Header="电话" Style="{StaticResource SoftTextBoxStyle}" />
                    </Grid>

                    <!-- Row 4: Follow Status & Tags -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="EditFollowStatusBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="跟进状态" SelectedIndex="0">
                            <ComboBoxItem Content="未设置" />
                            <ComboBoxItem Content="新线索" />
                            <ComboBoxItem Content="跟进中" />
                            <ComboBoxItem Content="高意向" />
                            <ComboBoxItem Content="已报价" />
                            <ComboBoxItem Content="已成交" />
                            <ComboBoxItem Content="暂缓/流失" />
                        </ComboBox>
                        <TextBox x:Name="EditTagsBox" Grid.Column="1" Header="客户标签" PlaceholderText="如 VIP、高意向" Style="{StaticResource SoftTextBoxStyle}" />
                    </Grid>

                    <!-- Row 5: Source & Added Date -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="168" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EditSourceBox" Grid.Column="0" Header="来源" Style="{StaticResource SoftTextBoxStyle}" />
                        <TextBox x:Name="EditAddedDateBox" Grid.Column="1" Header="添加时间" Style="{StaticResource SoftTextBoxStyle}" />
                    </Grid>

                    <!-- Signature & Description -->
                    <TextBox x:Name="EditSignatureBox" Header="个性签名" Style="{StaticResource SoftTextBoxStyle}" TextWrapping="Wrap" />
                    <TextBox
                        x:Name="EditDescriptionBox"
                        MinHeight="68"
                        AcceptsReturn="True"
                        Header="客户描述"
                        PlaceholderText="公司、职位、业务背景等描述信息..."
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: 员工备注 (Spacious full-height editor) -->
            <Grid x:Name="NotesTabPanel" Padding="20,16" RowSpacing="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="员工跟进备注" />
                        <TextBlock x:Name="NoteCharCountText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="共 0 字" />
                    </StackPanel>

                    <Button
                        HorizontalAlignment="Right"
                        Height="28"
                        Padding="10,0"
                        Click="InsertDateStampBtn_Click"
                        Content="+ 插入当前日期"
                        FontSize="11.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                </Grid>

                <TextBox
                    x:Name="EditEmployeeNoteBox"
                    Grid.Row="1"
                    Padding="12,10"
                    AcceptsReturn="True"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    FontSize="13"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    PlaceholderText="详细记录客户需求、报价进度、意向判断、偏好习惯及下次跟进计划..."
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextChanged="EditEmployeeNoteBox_TextChanged"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <!-- Row 2: Footer Save/Cancel Bar -->
        <Border
            Grid.Row="2"
            Padding="20,12"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,10,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="修改将在点击「保存修改」后统一生效"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CancelBtn"
                        Height="34"
                        Padding="16,0"
                        Click="CloseButton_Click"
                        Content="取消"
                        FontSize="12.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    <Button
                        x:Name="SaveBtn"
                        Height="34"
                        Padding="18,0"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryVioletButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <ProgressRing x:Name="SaveSpinner" Width="14" Height="14" Foreground="#FFFFFF" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="SaveBtnText" FontSize="12.5" Text="保存修改" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

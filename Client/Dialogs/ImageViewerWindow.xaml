<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Client.Dialogs.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="图片查看器"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="#13161D"
        KeyDown="RootGrid_KeyDown"
        RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Dark Title Bar -->
        <Grid
            x:Name="TitleBarGrid"
            Grid.Row="0"
            Background="#1B1F29"
            BorderBrush="#292F3D"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon FontSize="14" Foreground="#8B7DFF" Glyph="&#xE91B;" />
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#F2F4F8"
                    Text="图片查看器"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Padding="8,2"
                    Background="#252A37"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="MetaInfoText"
                        FontSize="11.5"
                        Foreground="#B2BAC9"
                        Text="-" />
                </Border>
                <Border
                    x:Name="RotationBadge"
                    Padding="8,2"
                    Background="#252A37"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="RotationBadgeText"
                        FontSize="11.5"
                        Foreground="#8B7DFF"
                        Text="0°" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Interactive Image Canvas -->
        <Grid
            x:Name="ViewportGrid"
            Grid.Row="1"
            Background="#13161D"
            DoubleTapped="ViewportGrid_DoubleTapped"
            PointerMoved="ViewportGrid_PointerMoved"
            PointerPressed="ViewportGrid_PointerPressed"
            PointerReleased="ViewportGrid_PointerReleased"
            PointerCanceled="ViewportGrid_PointerCanceled"
            PointerCaptureLost="ViewportGrid_PointerCaptureLost"
            PointerWheelChanged="ViewportGrid_PointerWheelChanged"
            SizeChanged="ViewportGrid_SizeChanged">

            <!-- Centered Unconstrained Canvas so Image Always Keeps Exact Natural Size Before Transform -->
            <Canvas
                x:Name="ImageHostCanvas"
                Width="0"
                Height="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Image
                    x:Name="PreviewImage"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Uniform">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="ImageTransform" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <!-- Loading / Error Status -->
            <TextBlock
                x:Name="EmptyHintText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="#9AA3B5"
                Text="正在加载图片..."
                Visibility="Collapsed" />

            <!-- Brief Floating Toast Banner -->
            <Border
                x:Name="ToastBanner"
                Margin="0,18,0,0"
                Padding="14,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#E8242936"
                BorderBrush="#3B4254"
                BorderThickness="1"
                CornerRadius="16"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ToastText"
                    FontSize="12"
                    Foreground="#F2F4F8"
                    Text="" />
            </Border>

            <!-- Bottom Floating Control Toolbar -->
            <Border
                Margin="0,0,0,22"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#EC1E222D"
                BorderBrush="#343B4C"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ZoomOutButton_Click"
                        CornerRadius="17"
                        ToolTipService.ToolTip="缩小 (- / 滚轮向下)">
                        <FontIcon FontSize="14" Foreground="#E5E9F2" Glyph="&#xE71F;" />
                    </Button>

                    <Border
                        MinWidth="54"
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="#282E3D"
                        CornerRadius="14">
                        <TextBlock
                            x:Name="ZoomPercentText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#F4F6FA"
                            Text="100%" />
                    </Border>

                    <Button
                        Width="34"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ZoomInButton_Click"
                        CornerRadius="17"
                        ToolTipService.ToolTip="放大 (+ / 滚轮向上)">
                        <FontIcon FontSize="14" Foreground="#E5E9F2" Glyph="&#xE8A3;" />
                    </Button>

                    <Border Width="1" Height="18" Margin="4,0" Background="#343B4C" />

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="FitWindowButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="适应窗口 (快捷键 0)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="13" Foreground="#E5E9F2" Glyph="&#xE9A6;" />
                            <TextBlock FontSize="12" Foreground="#E5E9F2" Text="适应" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ActualSizeButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="原始比例 1:1 (快捷键 1)">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#E5E9F2" Text="1:1" />
                    </Button>

                    <Border Width="1" Height="18" Margin="4,0" Background="#343B4C" />

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RotateLeftButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="逆时针旋转 90° (快捷键 Q)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="13" Foreground="#E5E9F2" Glyph="&#xE7A7;" />
                            <TextBlock FontSize="12" Foreground="#E5E9F2" Text="左旋" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="RotateRightButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="顺时针旋转 90° (快捷键 E)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="13" Foreground="#E5E9F2" Glyph="&#xE7AD;" />
                            <TextBlock FontSize="12" Foreground="#E5E9F2" Text="右旋" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ResetViewButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="重置缩放与旋转角度">
                        <TextBlock FontSize="12" Foreground="#C4CCDC" Text="重置" />
                    </Button>

                    <Border Width="1" Height="18" Margin="4,0" Background="#343B4C" />

                    <Button
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CopyImageButton_Click"
                        CornerRadius="16"
                        ToolTipService.ToolTip="复制图片到剪贴板">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="13" Foreground="#E5E9F2" Glyph="&#xE8C8;" />
                            <TextBlock FontSize="12" Foreground="#E5E9F2" Text="复制" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

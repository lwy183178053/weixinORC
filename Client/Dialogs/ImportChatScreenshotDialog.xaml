<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportChatScreenshotDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Client.Services"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="780">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Unified Header + 2-Mode Switcher (截图识别导入 | 微信聊天记录批量导入) -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0">
            <StackPanel>
                <Grid Padding="22,15,16,10">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontSize="16.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="导入对话" />
                        <TextBlock
                            x:Name="DialogSubtitleText"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="支持截图识别单屏气泡，或自动打开微信「查找聊天内容」逐屏批量导入" />
                    </StackPanel>

                    <Button
                        x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        ToolTipService.ToolTip="关闭 (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- 2-Mode Tab Switcher -->
                <Grid Padding="22,0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="TabScreenshotBtn"
                        Grid.Column="0"
                        Height="38"
                        Padding="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ModeTab_Click"
                        CornerRadius="0"
                        Tag="screenshot">
                        <Grid Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TabScreenshotIcon" FontSize="13" Glyph="&#xE8FE;" />
                                <TextBlock x:Name="TabScreenshotText" FontSize="13" FontWeight="SemiBold" Text="截图识别导入" />
                            </StackPanel>
                            <Border x:Name="TabScreenshotLine" Height="2.5" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="TabBatchBtn"
                        Grid.Column="1"
                        Height="38"
                        Padding="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ModeTab_Click"
                        CornerRadius="0"
                        Tag="batch">
                        <Grid Height="38">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TabBatchIcon" FontSize="13" Glyph="&#xE8BD;" />
                                <TextBlock x:Name="TabBatchText" FontSize="13" Text="微信聊天记录批量导入" />
                            </StackPanel>
                            <Border x:Name="TabBatchLine" Height="2.5" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 1: Swappable Mode Content -->
        <Grid Grid.Row="1" Padding="22,16,22,18">
            <!-- ========================================================= -->
            <!-- MODE 1: Screenshot Bubble Recognition                     -->
            <!-- ========================================================= -->
            <Grid x:Name="ScreenshotModePanel" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="356" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Strip -->
                <Border
                    x:Name="StatusBanner"
                    Grid.Row="0"
                    Padding="12,8"
                    Background="{StaticResource BrandSoftBgBrush}"
                    CornerRadius="7"
                    Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" TextWrapping="Wrap" />
                </Border>

                <!-- Top Action Bar -->
                <Border
                    Grid.Row="1"
                    Padding="12,10"
                    Background="{StaticResource BrandCardTintBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="粘贴微信聊天窗口截图，自动区分左侧(对方)与右侧绿色(我方)气泡" />
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="截图复制后直接按 Ctrl+V，或点击右侧按钮选图；支持逐条切换方向、微调或删除" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="OcrSpinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                            <Button x:Name="PasteButton" Height="32" Click="PasteButton_Click" Content="粘贴截图 (Ctrl+V)" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                            <Button x:Name="UploadButton" Height="32" Click="UploadButton_Click" Content="选图片" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two-Column Result Area -->
                <Grid Grid.Row="2" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <StackPanel x:Name="EmptyPreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14" Spacing="8">
                                <Border Width="42" Height="42" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="10">
                                    <FontIcon FontSize="18" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8BD;" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="等待聊天截图&#x0a;支持 Ctrl+V 粘贴" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="12,0" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <TextBlock x:Name="ParsedCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="待识别消息列表（0 条）" />
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="10">
                                <StackPanel x:Name="ParsedListPanel" Spacing="8">
                                    <TextBlock
                                        x:Name="EmptyListHint"
                                        Margin="0,48,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12.5"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="粘贴聊天截图后，这里将按时间顺序展示双方对话，可一键切换方向或微调文本"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Screenshot Mode Footer -->
                <Border Grid.Row="3" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="提示：确认无误后将按顺序追加到当前对话记录" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Height="34" Padding="14,0" Click="CloseButton_Click" Content="取消" FontSize="12.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="ConfirmScreenshotButton" Height="34" Padding="18,0" Click="ConfirmScreenshotButton_Click" Content="确认导入消息" FontSize="12.5" Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- MODE 2: WeChat Auto Batch Chat History Import             -->
            <!-- ========================================================= -->
            <Grid x:Name="BatchModePanel" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="350" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 1: Target Search Account + Page Limit + Start/Stop -->
                <Border
                    Grid.Row="0"
                    Padding="14,10"
                    Background="{StaticResource BrandCardTintBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="138" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="BatchSearchKeywordBox"
                                Grid.Column="0"
                                Height="34"
                                Padding="10,6"
                                FontSize="12.5"
                                PlaceholderText="输入用于搜索的微信号 / 微信备注 / 昵称..."
                                Style="{StaticResource SoftTextBoxStyle}" />

                            <ComboBox x:Name="MaxMessagesComboBox" Grid.Column="1" Height="34" HorizontalAlignment="Stretch" SelectedIndex="1" ToolTipService.ToolTip="设置最多采集多少条有效消息（滑到底部也会自动停止）">
                                <ComboBoxItem Content="最多 20 条" Tag="20" />
                                <ComboBoxItem Content="最多 50 条" Tag="50" />
                                <ComboBoxItem Content="最多 100 条" Tag="100" />
                                <ComboBoxItem Content="最多 200 条" Tag="200" />
                                <ComboBoxItem Content="全部（不限条数）" Tag="0" />
                            </ComboBox>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="StartBatchCaptureButton"
                                    Height="34"
                                    Padding="14,0"
                                    Click="StartBatchCaptureButton_Click"
                                    Content="开始自动采集"
                                    FontSize="12.5"
                                    Style="{StaticResource PrimaryVioletButtonStyle}" />
                                <Button
                                    x:Name="StopBatchCaptureButton"
                                    Height="34"
                                    Padding="14,0"
                                    Click="StopBatchCaptureButton_Click"
                                    Content="停止采集"
                                    FontSize="12.5"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="自动按微信号→名称搜索 → 打开「查找聊天内容」→ 按目标条数采集（自动过滤表情与乱码，到底即停）"
                                TextTrimming="CharacterEllipsis" />
                            <CheckBox
                                x:Name="SkipDuplicateCheck"
                                HorizontalAlignment="Right"
                                MinWidth="0"
                                MinHeight="0"
                                IsChecked="True">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="跳过已有重复消息" />
                            </CheckBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Step 2: Left Live Log & Progress | Right Captured Messages Preview -->
                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Live Progress + Log Console -->
                    <Grid Grid.Column="0" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,7" Background="{StaticResource WarningBgBrush}" CornerRadius="7">
                            <TextBlock FontSize="11" Foreground="{StaticResource WarningTextBrush}" Text="安全保护：采集期间请勿动鼠标；移动鼠标或按 ESC 可立即安全熔断。" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="5">
                            <TextBlock x:Name="BatchProgressLabel" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="等待开始采集..." TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="BatchProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource BrandPrimaryBrush}" />
                        </StackPanel>

                        <Border Grid.Row="2" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="BatchLogScrollViewer">
                                <TextBlock
                                    x:Name="BatchLiveLogText"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="17"
                                    Text="点击「开始自动采集」后，系统将自动定位微信并扫描该联系人的聊天记录。"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Right: Virtualized Captured Messages Preview -->
                    <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="12,0" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <Grid>
                                    <TextBlock x:Name="BatchCapturedHeaderText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="已采集消息预览（0 条 · 时间正序）" />
                                    <Button
                                        x:Name="BatchToggleAllBtn"
                                        HorizontalAlignment="Right"
                                        Padding="4,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BatchToggleAllBtn_Click"
                                        Content="全选/取消"
                                        FontSize="11.5"
                                        Foreground="{StaticResource BrandPrimaryBrush}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <StackPanel x:Name="BatchEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18" Spacing="6">
                                    <FontIcon FontSize="22" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE8BD;" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="采集完成后将按时间先后列出对话，可勾选筛选或点击方向标签调整我方/对方" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <ListView x:Name="BatchMessagesListView" Padding="8,6" SelectionMode="None" Visibility="Collapsed">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,3" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="services:BatchCapturedChatMessage">
                                            <Border Padding="8,6" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Click="BatchItemCheck_Click"
                                                        IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                                                    <Button
                                                        Grid.Column="1"
                                                        Height="26"
                                                        Padding="4,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        Click="BatchFlipDirectionBtn_Click"
                                                        Content="{x:Bind DirectionLabel, Mode=OneWay}"
                                                        FontSize="11"
                                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                        ToolTipService.ToolTip="点击切换我方/对方" />

                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind MetaHeader}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Batch Mode Footer -->
                <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="BatchFooterStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="核对账号后点击「开始自动采集」" TextTrimming="CharacterEllipsis" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BatchCancelButton" Height="34" Padding="14,0" Click="CloseButton_Click" Content="取消" FontSize="12.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="ConfirmBatchImportButton" Height="34" Padding="18,0" Click="ConfirmBatchImportButton_Click" Content="确认导入消息" FontSize="12.5" IsEnabled="False" Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>

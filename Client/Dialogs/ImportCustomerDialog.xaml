<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Client.Services"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="780">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Unified Header + 2-Mode Switcher (截图识别新建 | 微信标签批量导入) -->
            <Border
                Grid.Row="0"
                Background="{StaticResource AppSurfaceAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="10,10,0,0">
                <StackPanel>
                    <Grid Padding="22,15,16,10">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                FontSize="16.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="添加客户" />
                            <TextBlock
                                x:Name="DialogSubtitleText"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="支持单条截图识别/手动建档，或按微信标签一键批量导入" />
                        </StackPanel>

                        <Button
                            x:Name="CloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="CloseButton_Click"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            ToolTipService.ToolTip="关闭 (Esc)">
                            <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>

                    <!-- Clean 2-Mode Tab Strip -->
                    <Grid Padding="22,0" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="TabSingleBtn"
                            Grid.Column="0"
                            Height="38"
                            Padding="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ModeTab_Click"
                            CornerRadius="0"
                            Tag="single">
                            <Grid Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabSingleIcon" FontSize="13" Glyph="&#xE8FE;" />
                                    <TextBlock x:Name="TabSingleText" FontSize="13" FontWeight="SemiBold" Text="截图识别 / 手动新建" />
                                </StackPanel>
                                <Border x:Name="TabSingleLine" Height="2.5" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="TabBatchBtn"
                            Grid.Column="1"
                            Height="38"
                            Padding="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ModeTab_Click"
                            CornerRadius="0"
                            Tag="batch">
                            <Grid Height="38">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon x:Name="TabBatchIcon" FontSize="13" Glyph="&#xE8EC;" />
                                    <TextBlock x:Name="TabBatchText" FontSize="13" Text="按微信标签批量导入" />
                                </StackPanel>
                                <Border x:Name="TabBatchLine" Height="2.5" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 1: Swappable Mode Content -->
            <Grid Grid.Row="1" Padding="22,16,22,18">
                <!-- ========================================================= -->
                <!-- MODE 1: Single Customer Screenshot OCR / Manual Creation  -->
                <!-- ========================================================= -->
                <Grid x:Name="SingleModePanel" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Inline Status / Error Banner -->
                    <Border
                        x:Name="StatusBanner"
                        Grid.Row="0"
                        Padding="12,8"
                        Background="{StaticResource BrandSoftBgBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="StatusText"
                            FontSize="12"
                            Foreground="{StaticResource BrandPrimaryBrush}"
                            TextWrapping="Wrap" />
                    </Border>

                    <!-- Two-Column Body -->
                    <Grid Grid.Row="1" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="264" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Screenshot Paste / Upload & Preview -->
                        <Border
                            Grid.Column="0"
                            Padding="13"
                            VerticalAlignment="Stretch"
                            Background="{StaticResource AppSurfaceAltBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="资料截图识别" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="截微信资料页后直接 Ctrl+V 或上传" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ProgressRing x:Name="OcrSpinner" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    MinHeight="230"
                                    MaxHeight="264"
                                    Background="{StaticResource AppSurfaceBrush}"
                                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <StackPanel x:Name="EmptyPreviewHint" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <Border Width="44" Height="44" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="10">
                                                <FontIcon FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8FE;" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="截图复制后按 Ctrl+V&#x0a;自动提取资料、性别与头像" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />

                                        <Border
                                            x:Name="ExtractedAvatarBadge"
                                            Margin="8"
                                            Padding="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="6">
                                                    <Image x:Name="ExtractedAvatarImage" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="已提取头像" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Spacing="7">
                                    <Button x:Name="PasteButton" Height="33" HorizontalAlignment="Stretch" Click="PasteButton_Click" Content="粘贴剪贴板截图 (Ctrl+V)" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                    <Button x:Name="UploadButton" Height="33" HorizontalAlignment="Stretch" Click="UploadButton_Click" Content="选择本地图片" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: Profile Form -->
                        <Grid Grid.Column="1" VerticalAlignment="Stretch" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RemarkBox" Grid.Column="0" Header="微信备注（名称）" PlaceholderText="微信里的备注名，无则留空" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="NameBox" Grid.Column="1" Header="微信昵称" PlaceholderText="好友微信昵称" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AccountBox" Grid.Column="0" Header="微信号" PlaceholderText="如 x15288732909" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="RegionBox" Grid.Column="1" Header="地区" PlaceholderText="如 山东 聊城" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="126" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PhoneBox" Grid.Column="0" Header="电话" PlaceholderText="手机号" Style="{StaticResource SoftTextBoxStyle}" />
                                <ComboBox x:Name="GenderBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="性别" SelectedIndex="0">
                                    <ComboBoxItem Content="未知" />
                                    <ComboBoxItem Content="男" />
                                    <ComboBoxItem Content="女" />
                                </ComboBox>
                                <TextBox x:Name="AddedDateBox" Grid.Column="2" Header="添加时间" PlaceholderText="YYYY-MM-DD" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Grid.Row="3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceBox" Grid.Column="0" Header="来源" PlaceholderText="如 通过搜索微信号添加" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="TagsBox" Grid.Column="1" Header="微信标签" PlaceholderText="自动提取或手填" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Grid.Row="4" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="个性签名" />
                                <TextBox
                                    x:Name="SignatureBox"
                                    Grid.Row="1"
                                    MinHeight="84"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    Padding="10,9"
                                    PlaceholderText="自动识别（支持多行）"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Single Mode Footer -->
                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="提示：导入后可在右侧客户信息区编辑员工跟进备注" />
                            <Button
                                x:Name="SubmitButton"
                                Height="35"
                                MinWidth="148"
                                Padding="20,0"
                                HorizontalAlignment="Right"
                                Click="SubmitButton_Click"
                                CornerRadius="8"
                                Style="{StaticResource PrimaryVioletButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="SubmitSpinner" Width="14" Height="14" Foreground="#FFFFFF" IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="SubmitButtonText" FontSize="13" FontWeight="SemiBold" Text="核验确认并导入" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- MODE 2: Batch Import by WeChat Contact Manager Tags       -->
                <!-- ========================================================= -->
                <Grid x:Name="BatchModePanel" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="350" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Step 1: Locate & Scan Bar -->
                    <Border
                        Grid.Row="0"
                        Padding="14,10"
                        Background="{StaticResource BrandCardTintBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ScanStatusTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="步骤 1：定位微信「通讯录管理」并扫描标签" />
                                <TextBlock x:Name="ScanStatusSubText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="微信未打开、最小化或在托盘中时，系统会自动启动或唤起微信并点开「通讯录管理」。" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button x:Name="ScanTagsButton" Grid.Column="1" Height="34" Padding="14,0" Click="ScanTagsButton_Click" Content="定位并扫描标签" FontSize="12.5" Style="{StaticResource PrimaryVioletButtonStyle}" />
                            <Button x:Name="ScrollMoreTagsButton" Grid.Column="2" Height="34" Padding="10,0" Click="ScrollMoreTagsButton_Click" Content="下滚重扫" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" ToolTipService.ToolTip="如标签较多，可向下滚动左侧标签栏重新扫描" />
                        </Grid>
                    </Border>

                    <!-- Step 2: Left Tag List | Right Options & Live Logs -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="264" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="12" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="勾选要导入的微信标签" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Padding="4,2" Background="Transparent" BorderThickness="0" Click="ToggleSelectAllButton_Click" Content="全选/取消" FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" />
                                </Grid>

                                <Grid Grid.Row="1">
                                    <StackPanel x:Name="EmptyTagsHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Spacing="6">
                                        <FontIcon FontSize="22" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE8EC;" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击上方「定位并扫描标签」&#x0a;自动读取微信左侧标签列表" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <ListView x:Name="TagsListView" SelectionMode="None" Visibility="Collapsed">
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection />
                                        </ListView.ItemContainerTransitions>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="2,2" />
                                                <Setter Property="MinHeight" Value="34" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:WeChatTagItem">
                                                <Border Padding="8,4" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
                                                    <CheckBox Content="{x:Bind DisplayLabel}" FontSize="12.5" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>

                                <Grid Grid.Row="2" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ManualTagBox" Grid.Column="0" Height="30" Padding="8,4" FontSize="12" PlaceholderText="手动补充标签名..." Style="{StaticResource SoftTextBoxStyle}" />
                                    <Button Grid.Column="1" Height="30" Padding="9,0" Click="AddManualTagButton_Click" Content="添加" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="5">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="去重处理方式" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <RadioButton x:Name="DedupSkipRadio" Content="自动去重并补全缺失项（推荐）" GroupName="UnifiedBatchDedup" IsChecked="True" />
                                            <RadioButton x:Name="DedupOverwriteRadio" Content="全量覆盖更新（保留员工备注）" GroupName="UnifiedBatchDedup" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Padding="9,6" Background="{StaticResource WarningBgBrush}" CornerRadius="6">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource WarningTextBrush}" Text="安全保护：导入期间请勿操作鼠标；随时移动鼠标或按 ESC 键可立即熔断停止。" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,7" Background="{StaticResource AppChromeBgBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="已识别" />
                                            <TextBlock x:Name="StatProcessedText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,7" Background="{StaticResource SuccessBgBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource SuccessTextBrush}" Text="新增入库" />
                                            <TextBlock x:Name="StatCreatedText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="10,7" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Text="覆盖更新" />
                                            <TextBlock x:Name="StatUpdatedText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Padding="10,7" Background="{StaticResource AppInputBgBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="去重跳过" />
                                            <TextBlock x:Name="StatSkippedText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ProgressBar x:Name="ImportProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource BrandPrimaryBrush}" />
                            </StackPanel>

                            <Border Grid.Row="2" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer x:Name="LogScrollViewer">
                                    <TextBlock x:Name="LiveLogText" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" LineHeight="18" Text="等待扫描微信标签..." TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Batch Mode Footer -->
                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="FooterStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="请先点击「定位并扫描标签」" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StopImportButton" Height="34" Padding="16,0" Click="StopImportButton_Click" Content="停止导入" FontSize="12.5" Style="{StaticResource DangerOutlineButtonStyle}" Visibility="Collapsed" />
                                <Button x:Name="StartImportButton" Height="34" Padding="18,0" Click="StartImportButton_Click" Content="开始批量导入" FontSize="12.5" IsEnabled="False" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                <Button x:Name="DoneButton" Height="34" Padding="14,0" Click="CloseButton_Click" Content="关闭" FontSize="12.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- In-Dialog Modal Overlay for Single-Import Duplicate Conflict -->
        <Grid
            x:Name="DuplicateOverlay"
            Background="#88141824"
            CornerRadius="12"
            Visibility="Collapsed">
            <Border
                Width="440"
                Padding="22,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource ContentDialogBackground}"
                BorderBrush="{StaticResource ContentDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="{StaticResource WarningBgBrush}" CornerRadius="9">
                            <FontIcon FontSize="16" Foreground="{StaticResource WarningTextBrush}" Glyph="&#xE7BA;" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="检测到重复客户档案" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="请选择如何处理本次识别到的客户信息" />
                        </StackPanel>
                    </StackPanel>

                    <Border Padding="12" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock x:Name="DuplicateSummaryText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="34" HorizontalAlignment="Stretch" Click="DuplicateOverwriteButton_Click" Content="覆盖已有客户" FontSize="12.5" Style="{StaticResource PrimaryVioletButtonStyle}" />
                        <Button Grid.Column="1" Height="34" HorizontalAlignment="Stretch" Click="DuplicateCreateNewButton_Click" Content="仍要新建" FontSize="12.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button Grid.Column="2" Height="34" Padding="14,0" Click="DuplicateCancelButton_Click" Content="取消" FontSize="12.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>

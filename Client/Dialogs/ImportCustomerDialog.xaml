<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportCustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#FFFFFF"
    BorderBrush="#E2E5F0"
    BorderThickness="1"
    CornerRadius="12"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="760">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Row 0: Clean Custom Header with Top-Right Close Button -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="新建客户 · 截图识别导入" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="粘贴或上传微信资料页截图，自动提取信息并核对入库" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                <Button
                    Height="30"
                    Padding="10,0"
                    Click="BatchTagImportButton_Click"
                    Style="{StaticResource SecondaryOutlineButtonStyle}"
                    ToolTipService.ToolTip="切换到微信「通讯录管理」按标签批量自动导入">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8EC;" />
                        <TextBlock FontSize="12" Text="微信标签批量导入" />
                    </StackPanel>
                </Button>
                <Button
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Inline Status / Error Banner -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="12,9"
            Background="{StaticResource BrandSoftBgBrush}"
            CornerRadius="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{StaticResource BrandPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <!-- Row 2: Two-Column Body (Left Preview Card & Right WeChat Profile Form Bottom-Aligned) -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Screenshot Paste / Upload & Preview -->
            <Border
                Grid.Column="0"
                Padding="14"
                VerticalAlignment="Stretch"
                Background="#F9FAFC"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="资料截图识别" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="截微信资料页后直接 Ctrl+V 或上传"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="OcrSpinner"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- Preview Surface -->
                    <Border
                        Grid.Row="1"
                        MinHeight="235"
                        MaxHeight="270"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel
                                x:Name="EmptyPreviewHint"
                                Padding="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Border
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BrandSoftBgBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                        Glyph="&#xE8FE;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="截图复制后按 Ctrl+V&#x0a;自动提取资料、性别与头像"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />

                            <!-- Auto-extracted Avatar Badge -->
                            <Border
                                x:Name="ExtractedAvatarBadge"
                                Margin="8"
                                Padding="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#EEFFFFFF"
                                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="6">
                                        <Image x:Name="ExtractedAvatarImage" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="已提取头像" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button
                            x:Name="PasteButton"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="PasteButton_Click"
                            Content="粘贴剪贴板截图 (Ctrl+V)"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                        <Button
                            x:Name="UploadButton"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="UploadButton_Click"
                            Content="选择本地图片"
                            FontSize="12"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Pure WeChat Profile Fields (Employee Notes are edited later in the right profile panel) -->
            <Grid Grid.Column="1" VerticalAlignment="Stretch" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="RemarkBox"
                        Grid.Column="0"
                        Header="微信备注（名称）"
                        PlaceholderText="微信里的备注名，无则留空"
                        Style="{StaticResource SoftTextBoxStyle}" />
                    <TextBox
                        x:Name="NameBox"
                        Grid.Column="1"
                        Header="微信昵称"
                        PlaceholderText="好友微信昵称"
                        Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="AccountBox"
                        Grid.Column="0"
                        Header="微信号"
                        PlaceholderText="如 x15288732909"
                        Style="{StaticResource SoftTextBoxStyle}" />
                    <TextBox
                        x:Name="RegionBox"
                        Grid.Column="1"
                        Header="地区"
                        PlaceholderText="如 山东 聊城"
                        Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PhoneBox"
                        Grid.Column="0"
                        Header="电话"
                        PlaceholderText="手机号"
                        Style="{StaticResource SoftTextBoxStyle}" />
                    <ComboBox
                        x:Name="GenderBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="性别"
                        SelectedIndex="0">
                        <ComboBoxItem Content="未知" />
                        <ComboBoxItem Content="男" />
                        <ComboBoxItem Content="女" />
                    </ComboBox>
                    <TextBox
                        x:Name="AddedDateBox"
                        Grid.Column="2"
                        Header="添加时间"
                        PlaceholderText="YYYY-MM-DD"
                        Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SourceBox"
                        Grid.Column="0"
                        Header="来源"
                        PlaceholderText="如 通过搜索微信号添加"
                        Style="{StaticResource SoftTextBoxStyle}" />
                    <TextBox
                        x:Name="TagsBox"
                        Grid.Column="1"
                        Header="微信标签"
                        PlaceholderText="自动提取或手填"
                        Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <!-- Signature stretches cleanly to align bottom with left screenshot card -->
                <Grid Grid.Row="4" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="个性签名" />
                    <TextBox
                        x:Name="SignatureBox"
                        Grid.Row="1"
                        MinHeight="88"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Padding="10,9"
                        PlaceholderText="自动识别（支持多行）"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 3: Clean Footer Bar -->
        <Border
            Grid.Row="3"
            Padding="0,12,0,0"
            BorderBrush="{StaticResource AppBorderSubtleBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="提示：员工跟进备注可在导入后点击客户，于右侧客户信息栏编辑" />

                <Button
                    x:Name="SubmitButton"
                    Height="36"
                    MinWidth="148"
                    Padding="22,0"
                    HorizontalAlignment="Right"
                    Click="SubmitButton_Click"
                    CornerRadius="8"
                    Style="{StaticResource PrimaryVioletButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="SubmitSpinner"
                            Width="14"
                            Height="14"
                            Foreground="#FFFFFF"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock x:Name="SubmitButtonText" FontSize="13" FontWeight="SemiBold" Text="核验确认并导入" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        </Grid>

        <!-- In-Dialog Modal Overlay for Duplicate Customer Conflict (Overwrite / Create New / Cancel) -->
        <Grid
            x:Name="DuplicateOverlay"
            Margin="-24"
            Background="#88141824"
            CornerRadius="12"
            Visibility="Collapsed">
            <Border
                Width="440"
                Padding="22,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#E2E5F0"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="{StaticResource WarningBgBrush}" CornerRadius="9">
                            <FontIcon FontSize="16" Foreground="{StaticResource WarningTextBrush}" Glyph="&#xE7BA;" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="检测到重复客户档案" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="请选择如何处理本次识别到的客户信息" />
                        </StackPanel>
                    </StackPanel>

                    <Border Padding="12" Background="#F8F9FC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock
                            x:Name="DuplicateSummaryText"
                            FontSize="12.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            LineHeight="20"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="DuplicateOverwriteButton_Click"
                            Content="覆盖已有客户"
                            FontSize="12.5"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                        <Button
                            Grid.Column="1"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="DuplicateCreateNewButton_Click"
                            Content="仍要新建"
                            FontSize="12.5"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Height="34"
                            Padding="14,0"
                            Click="DuplicateCancelButton_Click"
                            Content="取消"
                            FontSize="12.5"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>

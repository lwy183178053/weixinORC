<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="760" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Clean Custom Header with Top-Right Close Button -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="新建群组 · 截图识别导入" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="粘贴或上传群信息截图，自动提取群名称、人数与成员" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Style="{StaticResource DialogCloseButtonStyle}"
                ToolTipService.ToolTip="关闭 (Esc)">
                <FontIcon FontSize="12" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!-- Row 1: Status Banner -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Padding="12,9"
            Background="{StaticResource BrandSoftBgBrush}"
            CornerRadius="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{StaticResource BrandPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <!-- Row 2: Two-Column Body -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Screenshot Drop/Paste Zone -->
            <Border
                Grid.Column="0"
                Padding="14"
                VerticalAlignment="Stretch"
                Background="{StaticResource AppSurfaceAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="群截图识别" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="截群信息或群成员面板后按 Ctrl+V"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="OcrSpinner"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        MinHeight="230"
                        MaxHeight="265"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <StackPanel
                                x:Name="EmptyPreviewHint"
                                Padding="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Border
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BrandSoftBgBrush}"
                                    CornerRadius="10">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                        Glyph="&#xE716;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="截图复制后按 Ctrl+V&#x0a;自动提取群名、人数与成员"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button
                            x:Name="PasteButton"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="PasteButton_Click"
                            Content="粘贴剪贴板截图 (Ctrl+V)"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                        <Button
                            x:Name="UploadButton"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="UploadButton_Click"
                            Content="选择本地图片"
                            FontSize="12"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Editable Group Form (Aligned Bottom with Left Card) -->
            <Grid Grid.Column="1" VerticalAlignment="Stretch" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="GroupNameBox"
                    Grid.Row="0"
                    Header="群组名称"
                    PlaceholderText="例如 2025级项目对接群"
                    Style="{StaticResource SoftTextBoxStyle}" />

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="GroupKeyBox"
                        Grid.Column="0"
                        Header="群标识"
                        PlaceholderText="选填"
                        Style="{StaticResource SoftTextBoxStyle}" />
                    <TextBox
                        x:Name="MemberCountBox"
                        Grid.Column="1"
                        Header="成员人数"
                        PlaceholderText="0"
                        Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <Grid Grid.Row="2" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="群成员列表" />
                    <TextBox
                        x:Name="MembersTextBox"
                        Grid.Row="1"
                        MinHeight="96"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Padding="10,9"
                        PlaceholderText="自动提取或手动输入群成员昵称（顿号或换行分隔）"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="3" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="员工群备注（仅本员工可见）" />
                    <TextBox
                        x:Name="NoteBox"
                        Grid.Row="1"
                        MinHeight="96"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Padding="10,9"
                        PlaceholderText="记录群性质、核心联系人、跟进重点..."
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 3: Clean Footer Bar -->
        <Border
            Grid.Row="3"
            Padding="0,12,0,0"
            BorderBrush="{StaticResource AppBorderSubtleBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="提示：支持直接按 Ctrl+V 粘贴群截图，按 Esc 关闭窗口" />

                <Button
                    x:Name="SubmitButton"
                    Height="36"
                    MinWidth="148"
                    Padding="22,0"
                    HorizontalAlignment="Right"
                    Click="SubmitButton_Click"
                    CornerRadius="8"
                    Style="{StaticResource PrimaryVioletButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="SubmitSpinner"
                            Width="14"
                            Height="14"
                            Foreground="#FFFFFF"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock x:Name="SubmitButtonText" FontSize="13" FontWeight="SemiBold" Text="核验确认并导入" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

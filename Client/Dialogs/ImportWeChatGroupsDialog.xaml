<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportWeChatGroupsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wx4="using:Client.Services.WeChat4Db"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="680" Height="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border
            Grid.Row="0"
            Padding="20,13,14,13"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <FontIcon FontSize="15" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE716;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="从微信添加群聊" />
                        <TextBlock x:Name="HeaderSubtitleText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="选择要管理的微信群，自动导入群头像、群成员与群聊天记录，并持续监听新消息" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="ReloadWeChatButton"
                        Height="30"
                        Padding="10,0"
                        Click="ReloadWeChatButton_Click"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        ToolTipService.ToolTip="重新从电脑微信读取最新群聊列表">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新群聊" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        ToolTipService.ToolTip="关闭 (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Inline Status / Progress Banner -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Margin="16,10,16,0"
            Padding="12,8"
            Background="{StaticResource BrandSoftBgBrush}"
            BorderBrush="{StaticResource BrandSoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBannerText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="ImportProgressBar" Maximum="100" Minimum="0" Value="0" Visibility="Collapsed" />
                </StackPanel>
                <Button
                    x:Name="RelaunchAdminButton"
                    Grid.Column="1"
                    Height="28"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Click="RelaunchAdminButton_Click"
                    Content="以管理员身份重启"
                    FontSize="11.5"
                    Style="{StaticResource DangerOutlineButtonStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Row 2: Main Content -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <!-- Loading State -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" />
                <TextBlock x:Name="LoadingText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="正在读取本机微信群聊列表..." />
            </StackPanel>

            <!-- Groups Selection Body -->
            <Grid x:Name="PickerBodyGrid" Visibility="Collapsed" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,9" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="GroupSearchBox"
                            Grid.Column="0"
                            Height="30"
                            Padding="9,4"
                            FontSize="12"
                            PlaceholderText="搜索群名称..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="GroupSearchBox_TextChanged" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Height="28" Padding="9,0" Click="SelectWithMsgs_Click" Content="选有聊天群" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button Height="28" Padding="9,0" Click="SelectAllVisible_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button Height="28" Padding="9,0" Click="ClearAllVisible_Click" Content="清空" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView
                    x:Name="GroupsListView"
                    Grid.Row="1"
                    Padding="12,8"
                    IsItemClickEnabled="True"
                    ItemClick="GroupsListView_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="wx4:WeChat4Group">
                            <Border Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Click="GroupCheckBox_Click"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                    <Border
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        Background="{StaticResource InfoBgBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource InfoTextBrush}"
                                                Text="{x:Bind AvatarInitial}"
                                                Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                            <Image
                                                Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SubLine}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="3"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SuccessBgBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind ImportedBadgeVisibility, Mode=OneWay}">
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="已导入" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Row 3: Footer Actions -->
        <Border
            Grid.Row="3"
            Padding="18,12"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,10,10">
            <Grid>
                <TextBlock
                    x:Name="SelectionSummaryText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="请勾选要导入管理的微信群" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CancelButton"
                        Height="34"
                        Padding="16,0"
                        Click="CloseButton_Click"
                        Content="取消"
                        FontSize="12.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    <Button
                        x:Name="ConfirmImportButton"
                        Height="34"
                        Padding="18,0"
                        Click="ConfirmImportButton_Click"
                        Content="导入所选群聊"
                        FontSize="12.5"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryVioletButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

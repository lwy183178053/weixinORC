<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.ImportWeComContactsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="820" Height="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border
            Grid.Row="0"
            Padding="20,13,14,13"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <FontIcon FontSize="15" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE731;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="从企业微信添加联系人" />
                        <TextBlock x:Name="HeaderSubtitleText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="按不同企业浏览企业微信联系人，按需勾选导入监控（导入后实时只读监听消息更新）" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="ReloadWeComButton"
                        Height="30"
                        Padding="10,0"
                        Click="ReloadWeComButton_Click"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        ToolTipService.ToolTip="重新扫描本机企业微信最新企业与联系人">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE895;" />
                            <TextBlock Text="刷新联系人" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        ToolTipService.ToolTip="关闭 (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Inline Status Banner -->
        <Border
            x:Name="StatusBanner"
            Grid.Row="1"
            Margin="16,10,16,0"
            Padding="12,8"
            Background="{StaticResource BrandSoftBgBrush}"
            BorderBrush="{StaticResource BrandSoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Row 2: Main Content -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <!-- Loading State -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" />
                <TextBlock x:Name="LoadingText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="正在只读扫描本机企业微信账号与联系人..." />
            </StackPanel>

            <!-- Two-Column Enterprise & Contact Picker -->
            <Grid x:Name="PickerBodyGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Enterprises Category List -->
                <Border
                    Grid.Column="0"
                    Background="{StaticResource AppSurfaceAltBrush}"
                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                    BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,9" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="企业微信空间" />
                        </Border>

                        <ListView
                            x:Name="CorpsListView"
                            Grid.Row="1"
                            Padding="6,6"
                            SelectionChanged="CorpsListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,1" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WeComCorpFilterOption">
                                    <Grid Padding="8,7" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="CorpSelectAllCheckBox_Click"
                                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                            ToolTipService.ToolTip="勾选或取消该企业下的全部联系人" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{x:Bind DisplayLabel}"
                                            TextTrimming="CharacterEllipsis" />

                                        <Border
                                            Grid.Column="2"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BrandSoftBgBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneWay}">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind SelectedCountText, Mode=OneWay}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right: Contacts List inside Active Enterprise -->
                <Grid Grid.Column="1" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,8" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="ContactSearchBox"
                                Grid.Column="0"
                                Height="30"
                                Padding="9,4"
                                FontSize="12"
                                PlaceholderText="搜索联系人姓名、备注、对方企业..."
                                Style="{StaticResource SoftTextBoxStyle}"
                                TextChanged="ContactSearchBox_TextChanged" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Button Height="28" Padding="8,0" Click="SelectWithMsgs_Click" Content="选有聊天" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Height="28" Padding="8,0" Click="SelectExternal_Click" Content="选外部客户" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Height="28" Padding="8,0" Click="SelectAllVisible_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Height="28" Padding="8,0" Click="ClearVisible_Click" Content="取消" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="ContactsListView"
                        Grid.Row="1"
                        Padding="10,6"
                        IsItemClickEnabled="True"
                        ItemClick="ContactsListView_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:WeComContactPickItem">
                                <Border Padding="9,7" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            Click="ContactCheckBox_Click"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                        <Border
                                            Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            Background="{StaticResource BrandSoftBgBrush}"
                                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13.5"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BrandPrimaryBrush}"
                                                    Text="{x:Bind AvatarInitial}"
                                                    Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                <Image
                                                    Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <Border Padding="5,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="5">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind TypeBadgeText}" MaxWidth="96" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SubLine}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="3"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource SuccessBgBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind ImportedBadgeVisibility}">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="已导入" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 3: Footer Actions -->
        <Border
            Grid.Row="3"
            Padding="18,12"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,10,10">
            <Grid>
                <TextBlock
                    x:Name="SelectionSummaryText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="请勾选要导入监控的企业微信联系人" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button
                        Height="34"
                        Padding="16,0"
                        Click="CloseButton_Click"
                        Content="取消"
                        FontSize="12.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    <Button
                        x:Name="ConfirmImportButton"
                        Height="34"
                        Padding="18,0"
                        Click="ConfirmImportButton_Click"
                        Content="导入所选联系人"
                        FontSize="12.5"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryVioletButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Client.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="0"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="700" Height="460">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="152" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Clean Navigation Sidebar (3 Sections Only: 通用 / 账号 / 服务) -->
        <Border
            Grid.Column="0"
            Padding="12,18,12,16"
            Background="{StaticResource AppRailBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="10,0,0,10">
            <StackPanel Spacing="6">
                <TextBlock
                    Margin="10,0,0,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="设置" />

                <Button
                    x:Name="NavGeneralButton"
                    Height="36"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NavCategory_Click"
                    CornerRadius="8"
                    Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <FontIcon x:Name="NavGeneralIcon" FontSize="14" Glyph="&#xE713;" />
                        <TextBlock x:Name="NavGeneralText" FontSize="13" Text="通用" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="NavAccountButton"
                    Height="36"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NavCategory_Click"
                    CornerRadius="8"
                    Tag="account">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <FontIcon x:Name="NavAccountIcon" FontSize="14" Glyph="&#xE77B;" />
                        <TextBlock x:Name="NavAccountText" FontSize="13" Text="账号" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="NavServerButton"
                    Height="36"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NavCategory_Click"
                    CornerRadius="8"
                    Tag="server">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <FontIcon x:Name="NavServerIcon" FontSize="14" Glyph="&#xE774;" />
                        <TextBlock x:Name="NavServerText" FontSize="13" Text="服务" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Settings Content Pane -->
        <Grid Grid.Column="1" Background="{StaticResource ContentDialogBackground}" CornerRadius="0,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar + Optional Back Button + Close Button -->
            <Grid Grid.Row="0" Padding="24,18,16,12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="BackToServerButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="BackToServerButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        ToolTipService.ToolTip="返回服务设置"
                        Visibility="Collapsed">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SectionTitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="通用" />
                        <TextBlock x:Name="SectionSubtitleText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="工作台基础偏好配置" />
                    </StackPanel>
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- Panel Body -->
            <Grid Grid.Row="1" Padding="24,4,24,18">
                <!-- 1. GENERAL PANEL -->
                <ScrollViewer x:Name="GeneralPanel">
                    <Border
                        Padding="22,30"
                        VerticalAlignment="Top"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <Border Width="42" Height="42" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="11">
                                <FontIcon FontSize="18" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE713;" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="暂无可配置的通用项" />
                            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="后续新增的工作台通用选项将集中在此展示。" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 2. ACCOUNT PANEL -->
                <ScrollViewer x:Name="AccountPanel" Visibility="Collapsed">
                    <Border
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="44" Height="44" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="22">
                                    <TextBlock x:Name="AccountAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Text="E" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountHeadlineName" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                                    <TextBlock x:Name="AccountHeadlineSub" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="当前已登录账号" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                            <Grid>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="员工姓名" />
                                <TextBlock x:Name="AccountNameText" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                            <Grid>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="登录账号" />
                                <TextBlock x:Name="AccountLoginText" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                            <Grid>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="员工编号" />
                                <TextBlock x:Name="AccountIdText" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="-" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 3. SERVER PANEL -->
                <ScrollViewer x:Name="ServerPanel" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <Border
                            Padding="16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="服务端地址 (IP / 域名)" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BackendUrlBox"
                                            Grid.Column="0"
                                            Height="36"
                                            PlaceholderText="例如 http://127.0.0.1:28765"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                        <Button
                                            x:Name="TestBackendBtn"
                                            Grid.Column="1"
                                            Height="36"
                                            Padding="14,0"
                                            Click="TestBackendBtn_Click"
                                            Content="保存并测连通"
                                            FontSize="12.5"
                                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <Border
                                    x:Name="ServerPingBanner"
                                    Padding="11,8"
                                    Background="{StaticResource AppInputBgBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="ServerPingText"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="修改服务端地址后点击右侧按钮保存并检测连通性。"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="16,13"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="运行日志" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="查看服务连接、识别与运行输出记录" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="32"
                                    Padding="12,0"
                                    Click="OpenLogsSubView_Click"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontSize="12.5" Glyph="&#xE756;" />
                                        <TextBlock FontSize="12" Text="查看运行日志" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. LIGHTWEIGHT INLINE LOGS SUB-VIEW (Opened from 服务 -> 查看运行日志) -->
                <Grid x:Name="LogsPanel" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Compact Filter & Action Toolbar -->
                    <Grid Grid.Row="0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="LogLevelFilterCombo"
                            Grid.Column="0"
                            Width="90"
                            Height="30"
                            FontSize="12"
                            SelectedIndex="0"
                            SelectionChanged="LogFilter_Changed">
                            <ComboBoxItem Content="全部" Tag="all" />
                            <ComboBoxItem Content="信息" Tag="info" />
                            <ComboBoxItem Content="成功" Tag="ok" />
                            <ComboBoxItem Content="警告" Tag="warn" />
                            <ComboBoxItem Content="错误" Tag="err" />
                        </ComboBox>

                        <TextBox
                            x:Name="LogSearchBox"
                            Grid.Column="1"
                            Height="30"
                            Padding="9,4"
                            FontSize="12"
                            PlaceholderText="筛选关键字..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="LogSearchBox_TextChanged" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Height="30" Padding="9,0" Click="RunSelfCheck_Click" Content="自检" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button Height="30" Padding="9,0" Click="CopyLogs_Click" Content="复制" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button Height="30" Padding="9,0" Click="ClearLogs_Click" Content="清空" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Clean Light/Dark Adaptive Log Stream -->
                    <Border
                        Grid.Row="1"
                        Background="{StaticResource AppCanvasBgBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <Grid>
                            <TextBlock
                                x:Name="EmptyLogsHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="暂无匹配的运行日志"
                                Visibility="Collapsed" />

                            <ListView
                                x:Name="LogsListView"
                                Padding="8,6"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="2,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:CompactLogRow">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{x:Bind TimeLabel}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind LevelBrush}"
                                                Text="{x:Bind LevelLabel}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{StaticResource BrandPrimaryBrush}"
                                                Text="{x:Bind ModuleLabel}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Message}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Subtle Footer Bar -->
                    <Grid Grid.Row="2">
                        <TextBlock
                            x:Name="LogCountText"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="共 0 条记录" />
                        <TextBlock
                            x:Name="LogCopyFeedbackText"
                            HorizontalAlignment="Right"
                            FontSize="11.5"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>

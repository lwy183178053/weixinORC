<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Client.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource ContentDialogBackground}"
    BorderBrush="{StaticResource ContentDialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="14"
    mc:Ignorable="d">

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="760" Height="520" Margin="-24,-18,-24,-24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar (Modern Clean Settings Rail) -->
        <Border
            Grid.Column="0"
            Padding="14,18,12,16"
            Background="{StaticResource AppRailBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="14,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,0,0,14" Spacing="2">
                    <TextBlock
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="工作台设置" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4">
                    <Button
                        x:Name="NavAppearanceButton"
                        Height="36"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavCategory_Click"
                        CornerRadius="8"
                        Tag="appearance">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAppearanceIcon" FontSize="14" Glyph="&#xE790;" />
                            <TextBlock x:Name="NavAppearanceText" FontSize="13" Text="外观与主题" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="NavGeneralButton"
                        Height="36"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavCategory_Click"
                        CornerRadius="8"
                        Tag="general">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon x:Name="NavGeneralIcon" FontSize="14" Glyph="&#xE713;" />
                            <TextBlock x:Name="NavGeneralText" FontSize="13" Text="通用与导入" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="NavServerButton"
                        Height="36"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavCategory_Click"
                        CornerRadius="8"
                        Tag="server">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon x:Name="NavServerIcon" FontSize="14" Glyph="&#xE774;" />
                            <TextBlock x:Name="NavServerText" FontSize="13" Text="服务与账号" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="NavAboutButton"
                        Height="36"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NavCategory_Click"
                        CornerRadius="8"
                        Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon x:Name="NavAboutIcon" FontSize="14" Glyph="&#xE946;" />
                            <TextBlock x:Name="NavAboutText" FontSize="13" Text="关于工作台" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Signed-In Employee Chip -->
                <Border
                    Grid.Row="2"
                    Padding="9,8"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="13">
                            <TextBlock x:Name="SidebarAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" Text="E" />
                        </Border>
                        <StackPanel Spacing="1">
                            <TextBlock x:Name="SidebarEmployeeName" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="96" Text="员工" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarEmployeeAccount" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" MaxWidth="96" Text="demo" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Settings Content Pane -->
        <Grid Grid.Column="1" Background="{StaticResource ContentDialogBackground}" CornerRadius="0,14,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar + Close Button -->
            <Grid Grid.Row="0" Padding="24,18,18,12">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SectionTitleText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="外观与主题" />
                    <TextBlock x:Name="SectionSubtitleText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="自由切换明亮 / 黑夜界面风格，修改后实时生效并自动保存。" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- Scrollable Panel Body -->
            <ScrollViewer Grid.Row="1" Padding="24,4,24,20">
                <Grid>
                    <!-- 1. APPEARANCE PANEL -->
                    <StackPanel x:Name="AppearancePanel" Spacing="16">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="界面配色主题" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Light Mode Card -->
                            <Button
                                x:Name="LightThemeCard"
                                Grid.Column="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SelectLightTheme_Click"
                                CornerRadius="10">
                                <Border
                                    x:Name="LightThemeCardBorder"
                                    Padding="14"
                                    Background="{StaticResource AppSurfaceBrush}"
                                    BorderBrush="{StaticResource BrandPrimaryBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Light UI Mockup -->
                                        <Border Height="68" Background="#F4F5F9" BorderBrush="#E2E5F0" BorderThickness="1" CornerRadius="7" Padding="6">
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#EAECEF" CornerRadius="4" />
                                                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E6E8F0" BorderThickness="1" CornerRadius="4" Padding="6">
                                                    <StackPanel Spacing="4">
                                                        <Border Width="54" Height="6" HorizontalAlignment="Left" Background="#7C5CFC" CornerRadius="3" />
                                                        <Border Width="96" Height="5" HorizontalAlignment="Left" Background="#D8DCE6" CornerRadius="2" />
                                                        <Border Width="72" Height="5" HorizontalAlignment="Left" Background="#EAECF2" CornerRadius="2" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE706;" />
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="明亮模式" />
                                            </StackPanel>
                                            <Border x:Name="LightActiveBadge" HorizontalAlignment="Right" Padding="7,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="当前使用" />
                                            </Border>
                                        </Grid>

                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="清爽明亮的白底柔和工作台，适合日间办公环境。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Dark Mode Card -->
                            <Button
                                x:Name="DarkThemeCard"
                                Grid.Column="1"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SelectDarkTheme_Click"
                                CornerRadius="10">
                                <Border
                                    x:Name="DarkThemeCardBorder"
                                    Padding="14"
                                    Background="{StaticResource AppSurfaceBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                    <StackPanel Spacing="10">
                                        <!-- Mini Dark UI Mockup -->
                                        <Border Height="68" Background="#0E1016" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="6">
                                            <Grid ColumnSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#141722" CornerRadius="4" />
                                                <Border Grid.Column="1" Background="#161922" BorderBrush="#262B38" BorderThickness="1" CornerRadius="4" Padding="6">
                                                    <StackPanel Spacing="4">
                                                        <Border Width="54" Height="6" HorizontalAlignment="Left" Background="#8B6EFF" CornerRadius="3" />
                                                        <Border Width="96" Height="5" HorizontalAlignment="Left" Background="#343B4E" CornerRadius="2" />
                                                        <Border Width="72" Height="5" HorizontalAlignment="Left" Background="#252A38" CornerRadius="2" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE708;" />
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="黑夜模式" />
                                            </StackPanel>
                                            <Border x:Name="DarkActiveBadge" HorizontalAlignment="Right" Padding="7,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="当前使用" />
                                            </Border>
                                        </Grid>

                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="深邃曜石黑低眩光界面，夜间长时间使用更护眼。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>

                        <Border Padding="14,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="左下角快捷主题切换" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="主界面左下角已提供一键明亮 / 黑夜切换图标，随时切换无需进入设置。" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="30" Padding="12,0" Click="QuickFlipTheme_Click" Content="立即切换" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2. GENERAL & IMPORT PANEL -->
                    <StackPanel x:Name="GeneralPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="批量导入与识别默认行为" />

                        <Border Padding="14,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="默认去重策略" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="打开「微信标签批量导入」弹窗时默认选中的处理方式" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="3" Background="{StaticResource AppInputBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="SegBackfillBtn" Height="26" Padding="10,0" BorderThickness="0" Click="SegBackfillBtn_Click" Content="补全缺失" CornerRadius="6" FontSize="11.5" />
                                            <Button x:Name="SegOverwriteBtn" Height="26" Padding="10,0" BorderThickness="0" Click="SegOverwriteBtn_Click" Content="全量覆盖" CornerRadius="6" FontSize="11.5" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="快捷粘贴截图导入 (Ctrl + V)" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="在客户档案页与群组页按 Ctrl+V 时直接弹出识别导入窗口" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CtrlVPasteToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="GeneralToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="窗口识别默认显示定位框" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="在「窗口识别」预览画布中叠加显示 RapidOCR 文本区域框" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ShowOverlayToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="GeneralToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="14,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="离线文字识别引擎" />
                                    <TextBlock x:Name="OcrEngineDetailText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="RapidOCR PP-OCRv5（全本地离线推理）" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="OcrStatusPill" Grid.Column="1" Padding="9,4" Background="{StaticResource SuccessBgBrush}" CornerRadius="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="OcrStatusPillText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="已就绪" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 3. SERVER & ACCOUNT PANEL -->
                    <StackPanel x:Name="ServerPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="后端服务连接" />

                        <Border Padding="14,14" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="服务端 API 地址" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BackendUrlBox" Grid.Column="0" Height="34" PlaceholderText="http://127.0.0.1:28765" Style="{StaticResource SoftTextBoxStyle}" />
                                        <Button x:Name="TestBackendBtn" Grid.Column="1" Height="34" Padding="14,0" Click="TestBackendBtn_Click" Content="保存并测连通" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <Border x:Name="ServerPingBanner" Padding="10,7" Background="{StaticResource AppInputBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <TextBlock x:Name="ServerPingText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="点击右侧按钮测试后端连通性与响应延迟。" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="当前登录会话" />

                        <Border Padding="14,12" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="员工姓名" />
                                    <TextBlock x:Name="AccountNameText" HorizontalAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />
                                <Grid>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="登录账号" />
                                    <TextBlock x:Name="AccountLoginText" HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />
                                <Grid>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="隔离员工 ID" />
                                    <TextBlock x:Name="AccountIdText" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="-" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. ABOUT PANEL -->
                    <StackPanel x:Name="AboutPanel" Spacing="14" Visibility="Collapsed">
                        <Border Padding="16" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="10">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" Text="智" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="智美微信智能工作台" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="WinUI 3 + Go + RapidOCR PP-OCRv5 · v1.0" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" Text="本客户端采用纯界面可见信息识别与受控辅助交互方案，不注入微信进程、不读取微信加密数据库，所有客户档案按员工账号独立隔离存储。" TextWrapping="Wrap" />

                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="本地配置文件位置" />
                                    <TextBlock x:Name="SettingsPathText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Height="32" Padding="12,0" Click="OpenSettingsFolderBtn_Click" Content="打开配置目录" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="32" Padding="12,0" Click="JumpToLogsBtn_Click" Content="查看运行日志" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>

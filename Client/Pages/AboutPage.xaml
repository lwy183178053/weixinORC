<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{StaticResource AppCanvasBgBrush}" Padding="26,20">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Spacing="16">
            <StackPanel Spacing="3">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="OCR 引擎与运行环境状态" />
                <TextBlock FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="双引擎可插拔架构诊断与 V1 原型能力清单" />
            </StackPanel>

            <Border Padding="20" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="已注册 OCR 引擎" />
                    <TextBlock x:Name="EnginesSummaryText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="本机 Windows OCR 语言包" />
                    <TextBlock x:Name="WindowsLanguagesText" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="运行模式与已打通能力" />
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="• 非打包原生 WinUI 3 桌面进程（避免管理员账号下 MSIX 输入法挂起问题）" TextWrapping="Wrap" />
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="• 强制登录门禁：未登录仅展示登录界面，认证通过后进入工作台，支持随时登出" TextWrapping="Wrap" />
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="• 微信（WeChat / Weixin）与企业微信（WXWork）窗口检测、显隐控制与暂停标记" TextWrapping="Wrap" />
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="• 窗口截图与本地图片 OCR、紫色定位框可视化、登录/掉线判定及人工核验落库" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

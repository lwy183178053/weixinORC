<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Client.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}" Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Clean Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="运行日志" />

                <Border
                    x:Name="ServiceStatePill"
                    Padding="10,4"
                    Background="{StaticResource SuccessBgBrush}"
                    CornerRadius="12"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="ServiceStateDot" Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                        <TextBlock
                            x:Name="ServiceStateText"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Text="运行正常" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox
                    x:Name="LevelFilterCombo"
                    Width="112"
                    Height="32"
                    FontSize="12"
                    SelectedIndex="0"
                    SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="全部级别" Tag="all" />
                    <ComboBoxItem Content="信息 INFO" Tag="info" />
                    <ComboBoxItem Content="成功 OK" Tag="ok" />
                    <ComboBoxItem Content="警告 WARN" Tag="warn" />
                    <ComboBoxItem Content="错误 ERR" Tag="err" />
                </ComboBox>

                <TextBox
                    x:Name="LogSearchBox"
                    Width="200"
                    Height="32"
                    Padding="10,5"
                    FontSize="12"
                    PlaceholderText="筛选关键字..."
                    Style="{StaticResource SoftTextBoxStyle}"
                    TextChanged="LogSearchBox_TextChanged" />

                <Button
                    Height="32"
                    Padding="12,0"
                    Click="RunSelfCheckButton_Click"
                    Content="运行自检"
                    FontSize="12"
                    Style="{StaticResource SecondaryOutlineButtonStyle}" />

                <Button
                    Height="32"
                    Padding="12,0"
                    Click="CopyLogsButton_Click"
                    Content="复制日志"
                    FontSize="12"
                    Style="{StaticResource SecondaryOutlineButtonStyle}" />

                <Button
                    Height="32"
                    Padding="12,0"
                    Click="ClearLogsButton_Click"
                    Content="清空"
                    FontSize="12"
                    Style="{StaticResource SecondaryOutlineButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Row 1: CMD-style Terminal Output Console -->
        <Border
            Grid.Row="1"
            Background="#14171D"
            BorderBrush="#272C38"
            BorderThickness="1"
            CornerRadius="10"
            RequestedTheme="Dark">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <Border
                    Grid.Row="0"
                    Padding="14,9"
                    Background="#1C2029"
                    BorderBrush="#272C38"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontSize="13" Foreground="#8B949E" Glyph="&#xE756;" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#C9D1D9"
                                Text="CONSOLE  ·  实时运行监控" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="LogCountText"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="11.5"
                                Foreground="#8B949E"
                                Text="0 lines" />
                            <CheckBox
                                x:Name="AutoScrollCheck"
                                MinWidth="0"
                                MinHeight="22"
                                Padding="6,0,0,0"
                                IsChecked="True">
                                <TextBlock FontSize="11.5" Foreground="#9BA3B4" Text="自动滚动" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Terminal Log Stream -->
                <ListView
                    x:Name="LogsListView"
                    Grid.Row="1"
                    Padding="12,10"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="2,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LogRowViewModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    Foreground="#6E7789"
                                    Text="{x:Bind TimeLabel}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind LevelBrush}"
                                    Text="{x:Bind LevelLabel}" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    Foreground="#A78BFA"
                                    Text="{x:Bind ModuleLabel}" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    Foreground="#E6EDF3"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Subtle CMD Status Prompt Footer -->
                <Border
                    Grid.Row="2"
                    Padding="14,7"
                    Background="#181C24"
                    BorderBrush="#272C38"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                    <Grid>
                        <TextBlock
                            x:Name="ConsolePromptText"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            Foreground="#8B949E"
                            Text="&gt; 监听中，等待新事件输出..." />
                        <TextBlock
                            x:Name="CopyFeedbackText"
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            Foreground="#3FB950"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>

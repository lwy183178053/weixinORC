<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.AutoReplyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:Client.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header & Global Master Switch -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource SuccessTextBrush}" />
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="群 @ AI 自动回复" />
                            <Border x:Name="StatusBadge" Padding="8,2" Background="{StaticResource SuccessBgBrush}" CornerRadius="9">
                                <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="待命中" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="检测到已启用群聊有人 @自己 后，结合问答示例生成回答，自动打开微信搜索进群并粘贴回复（操作期间按 ESC 可立即中止）" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch
                        x:Name="GlobalEnabledToggle"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent="全局暂停"
                        OnContent="全局开启"
                        Toggled="GlobalEnabledToggle_Toggled" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Sub-Tab Navigation Strip -->
        <Border
            Grid.Row="1"
            Padding="24,0"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    x:Name="TabExamplesButton"
                    Height="42"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SubTab_Click"
                    CornerRadius="0"
                    Tag="examples">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="TabExamplesIcon" FontSize="13" Glyph="&#xE8F2;" />
                            <TextBlock x:Name="TabExamplesText" FontSize="13" FontWeight="SemiBold" Text="问答示例库" />
                        </StackPanel>
                        <Border x:Name="TabExamplesLine" Height="2.5" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                    </Grid>
                </Button>

                <Button
                    x:Name="TabSettingsButton"
                    Height="42"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SubTab_Click"
                    CornerRadius="0"
                    Tag="settings">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="TabSettingsIcon" FontSize="13" Glyph="&#xE713;" />
                            <TextBlock x:Name="TabSettingsText" FontSize="13" Text="规则与安全设置" />
                        </StackPanel>
                        <Border x:Name="TabSettingsLine" Height="2.5" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                    </Grid>
                </Button>

                <Button
                    x:Name="TabLogsButton"
                    Height="42"
                    Padding="14,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SubTab_Click"
                    CornerRadius="0"
                    Tag="logs">
                    <Grid Height="42">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="TabLogsIcon" FontSize="13" Glyph="&#xE756;" />
                            <TextBlock x:Name="TabLogsText" FontSize="13" Text="执行记录与诊断日志" />
                        </StackPanel>
                        <Border x:Name="TabLogsLine" Height="2.5" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- Row 2: Tab Panels -->
        <Grid Grid.Row="2">
            <!-- TAB 1: Q&A Examples Library -->
            <ScrollViewer
                x:Name="ExamplesTabView"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
                    <Grid Padding="24,16">
                        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Spacing="14">

                            <!-- Action Toolbar -->
                            <Border
                                Padding="16,13"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="问题与标准回答示例库" />
                                            <Border Padding="7,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                                <TextBlock x:Name="ExamplesCountText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0 条示例" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="配置常见问题与标准回复示例：默认作为高优先级参考注入 AI 生成自然回复，也可设为「关键词直出」秒回固定话术。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Height="32"
                                            Padding="12,0"
                                            Click="LoadStarterTemplatesButton_Click"
                                            Content="载入示例模板"
                                            FontSize="12"
                                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button
                                            Height="32"
                                            Padding="14,0"
                                            Click="NewExampleButton_Click"
                                            Content="+ 新增问答示例"
                                            FontSize="12"
                                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        <!-- Inline Add / Edit Q&A Example Form -->
                        <Border
                            x:Name="ExampleEditorCard"
                            Padding="18,16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="11"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock x:Name="ExampleEditorTitleText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="新增问答示例" />
                                    <Button HorizontalAlignment="Right" Padding="6,2" Background="Transparent" BorderThickness="0" Click="CancelEditExampleButton_Click" Content="✕" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="EditorCategoryBox"
                                        Grid.Column="0"
                                        Header="分类标签"
                                        PlaceholderText="例如：价格咨询、发货物流、售后支持、预约引导"
                                        Style="{StaticResource SoftTextBoxStyle}" />
                                    <ComboBox
                                        x:Name="EditorMatchModeCombo"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Header="触发模式"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="AI 参考示例生成（推荐）" Tag="ai" />
                                        <ComboBoxItem Content="命中关键词直接回复（极速）" Tag="direct" />
                                    </ComboBox>
                                </Grid>

                                <TextBox
                                    x:Name="EditorQuestionBox"
                                    Header="典型问题 / 触发关键词（多个问法用 / 或逗号分隔）"
                                    PlaceholderText="例如：什么时候发货 / 发货时间 / 几天能收到"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextWrapping="Wrap" />

                                <TextBox
                                    x:Name="EditorAnswerBox"
                                    MinHeight="84"
                                    AcceptsReturn="True"
                                    Header="标准回答示例"
                                    PlaceholderText="输入希望展示给群友的标准话术与回答风格，AI 会严格参考其中的口径与事实..."
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextWrapping="Wrap" />

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Height="32" Padding="14,0" Click="CancelEditExampleButton_Click" Content="取消" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="32" Padding="16,0" Click="SaveExampleButton_Click" Content="保存该条示例" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Examples List Card -->
                        <Border
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <StackPanel
                                    x:Name="EmptyExamplesHint"
                                    Margin="24,36"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂未配置问答示例" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="添加常见群内提问与标准回复后，AI 将优先按您的业务口径和语气自动应答；也可点右上角「载入示例模板」快速上手。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <ListView
                                    x:Name="ExamplesListView"
                                    Padding="12,10"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,4" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:AutoReplyExampleItem">
                                            <Border
                                                Padding="14,12"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Opacity="{x:Bind CardOpacity, Mode=OneWay}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        MinWidth="0"
                                                        VerticalAlignment="Top"
                                                        Click="ExampleEnabledCheckBox_Click"
                                                        IsChecked="{x:Bind Enabled, Mode=OneWay}"
                                                        Tag="{x:Bind Id}" />

                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <Border Padding="7,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="6">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind CategoryDisplay, Mode=OneWay}" />
                                                            </Border>
                                                            <Border Padding="7,1" Background="{StaticResource InfoBgBrush}" CornerRadius="6">
                                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InfoTextBrush}" Text="{x:Bind MatchModeLabel, Mode=OneWay}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                            <Run Foreground="{StaticResource BrandPrimaryBrush}" Text="问：" />
                                                            <Run Text="{x:Bind QuestionPattern, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap">
                                                            <Run Foreground="{StaticResource SuccessTextBrush}" Text="答：" />
                                                            <Run Text="{x:Bind AnswerExample, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal" Spacing="6">
                                                        <Button Height="28" Padding="10,0" Click="EditExampleButton_Click" Content="编辑" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" Tag="{x:Bind Id}" />
                                                        <Button Height="28" Padding="10,0" Click="DeleteExampleButton_Click" Content="删除" FontSize="11.5" Style="{StaticResource DangerOutlineButtonStyle}" Tag="{x:Bind Id}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- TAB 2: Rules, Persona, Automation Safety & Manual Test -->
                <ScrollViewer
                    x:Name="SettingsTabView"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    Visibility="Collapsed">
                    <Grid Padding="24,16">
                        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Spacing="14">

                            <!-- Card B: Trigger & Anti-Spam Rules -->
                            <Border
                                Padding="18,16"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="触发识别与防骚扰规则" />
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="TriggerRulesSavedHint" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource SuccessTextBrush}" Text="✓ 已保存" Visibility="Collapsed" />
                                            <Button Height="28" Padding="12,0" Click="SaveTriggerRulesButton_Click" Content="保存触发规则" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ExtraTriggerNamesBox"
                                            Grid.Column="0"
                                            Header="额外触发称呼（逗号分隔，自动兼容群昵称与微信昵称）"
                                            PlaceholderText="例如：小美,客服助理,顾问"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                        <TextBox
                                            x:Name="BlockedKeywordsBox"
                                            Grid.Column="1"
                                            Header="敏感词黑名单（命中时自动跳过，交由人工处理）"
                                            PlaceholderText="例如：转账,汇款,验证码,密码,退款"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CooldownSecondsBox"
                                            Grid.Column="0"
                                            Header="同群同人防刷屏冷却（秒，0=不限）"
                                            PlaceholderText="10"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                        <TextBox
                                            x:Name="MaxMessageAgeBox"
                                            Grid.Column="1"
                                            Header="仅响应多久内的新消息（秒）"
                                            PlaceholderText="180"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                        <TextBox
                                            x:Name="MaxReplyCharsBox"
                                            Grid.Column="2"
                                            Header="单条回复最大字数（40~2000）"
                                            PlaceholderText="1000"
                                            Style="{StaticResource SoftTextBoxStyle}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <CheckBox x:Name="IgnoreAtAllCheck" Content="忽略 @所有人（防止误回复群公告）" />
                                        <CheckBox x:Name="PrefixMentionSenderCheck" Content="回复开头自动加上 @提问者" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card C: Persona Prompt & Fallback -->
                            <Border
                                Padding="18,16"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="AI 回复人设与兜底策略" />
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="PersonaSavedHint" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource SuccessTextBrush}" Text="✓ 已保存" Visibility="Collapsed" />
                                            <Button Height="28" Padding="12,0" Click="SavePersonaButton_Click" Content="保存人设与兜底" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBox
                                        x:Name="CustomPromptBox"
                                        MinHeight="78"
                                        AcceptsReturn="True"
                                        Header="专属回复人设与语气要求"
                                        PlaceholderText="例如：你是亲切专业的客户服务助理，回答简明扼要、口语自然..."
                                        Style="{StaticResource SoftTextBoxStyle}"
                                        TextWrapping="Wrap" />

                                    <TextBox
                                        x:Name="FallbackReplyBox"
                                        Header="AI 服务异常/超时时的兜底话术（留空则安全跳过，不向群内发消息）"
                                        PlaceholderText="留空推荐；如需兜底可填：收到啦，我稍后核实完立刻回复您～"
                                        Style="{StaticResource SoftTextBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Card D: WeChat UI Automation & Visual Overlay Safety -->
                            <Border
                                Padding="18,16"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="微信界面操控与安全防护" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="勾选即实时生效" />
                                    </Grid>

                                    <CheckBox x:Name="AutoSendAfterPasteCheck" Checked="AutomationOptionCheck_Changed" Content="粘贴 AI 回复后自动点击微信「发送」按钮（关闭则仅自动打开对应群并粘贴至输入框，供人工确认）" Unchecked="AutomationOptionCheck_Changed" />
                                    <CheckBox x:Name="PreOpenGroupWhileGeneratingCheck" Checked="AutomationOptionCheck_Changed" Content="AI 生成回答期间提前唤起并切换到目标群聊（并行提速：生成完直接核对标题后秒发，推荐开启）" Unchecked="AutomationOptionCheck_Changed" />
                                    <CheckBox x:Name="ShowClickOverlayCheck" Checked="AutomationOptionCheck_Changed" Content="显示鼠标点击位置可视化瞄准遮罩（执行点击时在屏幕上闪烁定位圆环，便于观察）" Unchecked="AutomationOptionCheck_Changed" />
                                    <CheckBox x:Name="VerifyGroupTitleCheck" Checked="AutomationOptionCheck_Changed" Content="粘贴前校验右侧聊天窗群标题一致（强安全保护：防止搜不到或进错群时误发消息）" Unchecked="AutomationOptionCheck_Changed" />
                                    <CheckBox x:Name="RestoreClipboardCheck" Checked="AutomationOptionCheck_Changed" Content="自动回复完成后恢复操作前的剪贴板文本内容" Unchecked="AutomationOptionCheck_Changed" />
                                    <CheckBox x:Name="SlowStableModeCheck" Checked="AutomationOptionCheck_Changed" Content="稳健慢速模式（每步多等待 260ms，适合电脑负载高或微信界面响应偏慢时开启）" Unchecked="AutomationOptionCheck_Changed" />
                                </StackPanel>
                            </Border>

                            <!-- Card E: Live End-to-End Dry Run / Test -->
                            <Border
                                Padding="18,16"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="手动测试自动回复流程（可视化联调）" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="模拟一次群友 @提问：生成 AI 回答 → 唤起微信 → 识别搜索栏并搜群名 → 点击进入群聊 → 点击输入框并粘贴（可按 ESC 随时中断）。" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="TestGroupCombo"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            PlaceholderText="选择测试群聊" />
                                        <TextBox
                                            x:Name="TestQuestionBox"
                                            Grid.Column="1"
                                            PlaceholderText="输入模拟的群友提问..."
                                            Style="{StaticResource SoftTextBoxStyle}"
                                            Text="请问工作时间是几点？" />
                                        <Button
                                            x:Name="RunTestButton"
                                            Grid.Column="2"
                                            Height="34"
                                            Padding="14,0"
                                            Click="RunTestButton_Click"
                                            Content="开始测试流程"
                                            FontSize="12"
                                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                                    </Grid>

                                    <CheckBox x:Name="TestSendImmediatelyCheck" Content="测试时直接点击「发送」（不勾选则仅粘贴到输入框，最安全）" IsChecked="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- TAB 3: Execution History & Structured Diagnostic Logs -->
                <Grid x:Name="LogsTabView" Padding="24,16" RowSpacing="14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1.15*" />
                    </Grid.RowDefinitions>

                    <!-- Top Half: Recent Auto-Reply Executions -->
                    <Border
                        Grid.Row="0"
                        MaxWidth="960"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="最近自动回复执行记录" />
                                        <TextBlock x:Name="RecordsCountText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="0 条" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Height="26" Padding="10,0" Click="ClearRecordsButton_Click" Content="清空记录" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <TextBlock
                                    x:Name="EmptyRecordsHint"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="暂无自动回复执行记录；当开启群内有人 @你 或运行手动测试时将实时显示。" />

                                <ListView
                                    x:Name="RecordsListView"
                                    Padding="12,6"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,3" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:AutoReplyExecutionRecord">
                                            <Border
                                                Padding="12,9"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="4">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind HeaderLine}" />
                                                            <Border Padding="6,1" Background="{x:Bind StatusBgBrush}" CornerRadius="6">
                                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{x:Bind StatusFgBrush}" Text="{x:Bind StatusLabel}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind MetaLine}" />
                                                    </Grid>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                        <Run Foreground="{StaticResource TextMutedBrush}" Text="触发：" />
                                                        <Run Text="{x:Bind TriggerMessage}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind ReplyVisibility}">
                                                        <Run Foreground="{StaticResource BrandPrimaryBrush}" Text="回复：" />
                                                        <Run Text="{x:Bind GeneratedReply}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" Visibility="{x:Bind DetailVisibility}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Bottom Half: Live Diagnostic System Log Viewer -->
                    <Border
                        Grid.Row="1"
                        MaxWidth="960"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="14,9" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="系统诊断日志" />

                                    <ComboBox x:Name="DiagLevelCombo" Grid.Column="1" Width="76" Height="28" FontSize="11.5" SelectedIndex="0" SelectionChanged="DiagLogFilter_Changed">
                                        <ComboBoxItem Content="全部" Tag="all" />
                                        <ComboBoxItem Content="信息" Tag="info" />
                                        <ComboBoxItem Content="成功" Tag="ok" />
                                        <ComboBoxItem Content="警告" Tag="warn" />
                                        <ComboBoxItem Content="错误" Tag="err" />
                                    </ComboBox>

                                    <ComboBox x:Name="DiagModuleCombo" Grid.Column="2" Width="118" Height="28" FontSize="11.5" SelectedIndex="0" SelectionChanged="DiagLogFilter_Changed">
                                        <ComboBoxItem Content="自动回复链路" Tag="AUTOREPLY_CHAIN" />
                                        <ComboBoxItem Content="全部模块" Tag="all" />
                                        <ComboBoxItem Content="触发与生成 (REPLY)" Tag="REPLY" />
                                        <ComboBoxItem Content="微信操控 (AUTO)" Tag="AUTO" />
                                        <ComboBoxItem Content="文字识别 (OCR)" Tag="OCR" />
                                        <ComboBoxItem Content="鼠标点击 (CLICK)" Tag="CLICK" />
                                        <ComboBoxItem Content="微信监听 (WX4)" Tag="WX4" />
                                        <ComboBoxItem Content="窗口管理 (WIN)" Tag="WIN" />
                                        <ComboBoxItem Content="AI 引擎 (AI)" Tag="AI" />
                                    </ComboBox>

                                    <TextBox
                                        x:Name="DiagSearchBox"
                                        Grid.Column="3"
                                        Height="28"
                                        Padding="8,3"
                                        FontSize="11.5"
                                        PlaceholderText="搜索日志关键词..."
                                        Style="{StaticResource SoftTextBoxStyle}"
                                        TextChanged="DiagSearchBox_TextChanged" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5">
                                        <Button Height="28" Padding="9,0" Click="OpenLogFolderButton_Click" Content="打开日志目录" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button Height="28" Padding="9,0" Click="CopyDiagLogsButton_Click" Content="复制日志" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button Height="28" Padding="9,0" Click="ClearDiagLogsButton_Click" Content="清空" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListView
                                x:Name="DiagLogsListView"
                                Grid.Row="1"
                                Padding="12,6"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="dialogs:CompactLogRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                            <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind LevelBrush}" Text="{x:Bind LevelLabel}" />
                                            <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind ModuleLabel}" />
                                            <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.ConnectorBridgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="BridgeStatusDot" Width="10" Height="10" Fill="{StaticResource TextMutedBrush}" />
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="甲方连接器接口服务（双端口无 Hook 适配）" />
                            <Border Padding="8,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="9">
                                <TextBlock x:Name="BridgeBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="检测中" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="兼容智美 IM 连接器标准本地接口协议：企业微信 127.0.0.1:8989/api 与 个人微信 127.0.0.1:8990/api（只读 DB + RPA 零注入替代）" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Button
                        Height="32"
                        Padding="12,0"
                        Click="RefreshAllStatusButton_Click"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        ToolTipService.ToolTip="刷新个人微信 8990 与企业微信 8989 端口适配状态">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE895;" />
                            <TextBlock Text="刷新同步" />
                        </StackPanel>
                    </Button>
                    <ToggleSwitch
                        x:Name="BridgeMasterToggle"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent="已停止"
                        OnContent="服务运行中"
                        Toggled="BridgeMasterToggle_Toggled" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="24,18">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="16">

                    <!-- Dual Port Overview Cards -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Port 1: Personal WeChat 8990 -->
                        <Border
                            Grid.Column="0"
                            Padding="18,16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" Background="{StaticResource SuccessBgBrush}" CornerRadius="8">
                                            <FontIcon FontSize="14" Foreground="{StaticResource SuccessTextBrush}" Glyph="&#xE8BD;" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="个人微信接口端口" />
                                            <TextBlock x:Name="WxEndpointText" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" IsTextSelectionEnabled="True" Text="http://127.0.0.1:8990/api" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="WxStatusPill" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AppInputBgBrush}" CornerRadius="9">
                                        <TextBlock x:Name="WxStatusPillText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未启动" />
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="WxAccountInfoText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="当前在线：等待检测..." TextWrapping="Wrap" />
                                    <TextBlock x:Name="WxCountsText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="好友 0 · 群聊 0 · 推送回调 http://127.0.0.1:9001" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="已支持 type: 1(状态) 3(资料) 5(好友/群) 6(群成员) 7/8/9/13/14(发送) 19(详情) 29(群昵称) 47(语音目录) 48(PID) 73~75(下载)" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Height="28" Padding="10,0" Click="TestWxHealth_Click" Content="自检 /health" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="TestWxProfile_Click" Content="测 type=3 资料" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="TestWxContacts_Click" Content="测 type=5 好友" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="CopyWxEndpoint_Click" Content="复制地址" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Port 2: Enterprise WeCom 8989 -->
                        <Border
                            Grid.Column="1"
                            Padding="18,16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                            <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE731;" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="企业微信接口端口" />
                                            <TextBlock x:Name="WcEndpointText" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" IsTextSelectionEnabled="True" Text="http://127.0.0.1:8989/api" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="WcStatusPill" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AppInputBgBrush}" CornerRadius="9">
                                        <TextBlock x:Name="WcStatusPillText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未启动" />
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="WcAccountInfoText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="当前企业：等待检测..." TextWrapping="Wrap" />
                                    <TextBlock x:Name="WcCountsText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="联系人 0 · 群聊 0 · 推送回调 http://127.0.0.1:9000" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="已支持 type: 1000(状态) 1002(资料) 2000(联系人) 2002(群) 2003(群成员) 3000~3004/3009(发送) 4007(详情) 5008(群详) 9001~9004(下载) 10004(PID)" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Primary WeCom Corp Switcher for 8989 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="8989绑定企业:" />
                                    <ComboBox
                                        x:Name="WeComAccountCombo"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        FontSize="11.5"
                                        PlaceholderText="自动选择最活跃企业"
                                        SelectionChanged="WeComAccountCombo_SelectionChanged" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Height="28" Padding="10,0" Click="TestWcHealth_Click" Content="自检 /health" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="TestWcProfile_Click" Content="测 type=1002 资料" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="TestWcGroups_Click" Content="测 type=2002 群" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    <Button Height="28" Padding="10,0" Click="CopyWcEndpoint_Click" Content="复制地址" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live JSON Self-Test Console -->
                    <Border
                        Padding="16,14"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE756;" />
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="接口实时响应预览（点击上方任意自检按钮即可现场联调验证）" />
                                </StackPanel>
                                <TextBlock x:Name="TestResultHeaderText" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="尚未发起测试" />
                            </Grid>

                            <Border
                                MaxHeight="260"
                                Padding="12,10"
                                Background="{StaticResource AppInputBgBrush}"
                                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="TestResponseJsonText"
                                        FontFamily="Consolas"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="点击上方 8990 或 8989 卡片中的自检按钮，实时查看接口返回的原始 JSON"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Live Traffic & Push Log Panel -->
                    <Border
                        Padding="16,14"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE9D2;" />
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="双端口实时调用与推送日志" />
                                </StackPanel>
                                <Button Height="26" Padding="10,0" HorizontalAlignment="Right" Click="ClearTrafficLogsButton_Click" Content="清空日志" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </Grid>

                            <ListView x:Name="TrafficLogListView" Height="200" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="6,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    mc:Ignorable="d">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left: Clean Apifox-style Customer Table -->
        <Grid Grid.Column="0" Padding="20,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Search Bar -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="客户档案库" />
                    <TextBlock x:Name="OwnerSubtitleText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="按当前员工身份严格隔离" />
                </StackPanel>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="34"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索昵称、微信号或备注..."
                    Style="{StaticResource SoftTextBoxStyle}"
                    TextChanged="SearchBox_TextChanged" />

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Height="34"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click"
                    Content="刷新列表"
                    Style="{StaticResource SecondaryOutlineButtonStyle}" />
            </Grid>

            <!-- Status Strip -->
            <Border
                x:Name="StatusBanner"
                Grid.Row="1"
                Padding="12,8"
                Background="{StaticResource BrandSoftBgBrush}"
                CornerRadius="7"
                Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" />
            </Border>

            <!-- Structured Data Table -->
            <Border
                Grid.Row="2"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Column Header -->
                    <Border
                        Grid.Row="0"
                        Padding="16,0"
                        Background="{StaticResource AppCanvasBgBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="ID" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="微信昵称" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="微信号" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="员工备注" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <Grid Grid.Row="1">
                        <TextBlock
                            x:Name="EmptyTableHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="当前员工名下暂无客户档案，可在右侧新增或在“微信OCR”页核验导入。"
                            Visibility="Collapsed" />

                        <ListView x:Name="CustomersListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerDto">
                                    <Border
                                        Padding="4,10"
                                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                Padding="7,2"
                                                Background="{StaticResource BrandSoftBgBrush}"
                                                CornerRadius="4">
                                                <TextBlock FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind Id}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind WechatName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind WechatAccount}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Note}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: Quick Add Customer Drawer -->
        <Border
            Grid.Column="1"
            Padding="20,18"
            Background="{StaticResource AppCanvasBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1,0,0,0">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="手动新建客户" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="直接写入当前登录员工名下的 Go 后端数据库" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="微信昵称" />
                            <TextBox x:Name="NewNameBox" PlaceholderText="请输入客户微信昵称" Style="{StaticResource SoftTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="微信号" />
                            <TextBox x:Name="NewAccountBox" PlaceholderText="请输入核验后的微信号" Style="{StaticResource SoftTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="员工备注" />
                            <TextBox
                                x:Name="NewNoteBox"
                                Height="84"
                                AcceptsReturn="True"
                                PlaceholderText="客户来源、跟进状态或需求备注..."
                                Style="{StaticResource SoftTextBoxStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Name="CreateButton"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            Click="CreateButton_Click"
                            Content="+ 添加到我的客户库"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>

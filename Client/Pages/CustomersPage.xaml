<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    xmlns:services="using:Client.Services"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="268" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="450" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="356" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: WeChat-style Customer List Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + Top-Left "+" Popup Import Button -->
                <Border
                    Grid.Row="0"
                    Padding="12,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Height="34"
                            Padding="10,6"
                            FontSize="12.5"
                            PlaceholderText="搜索客户昵称、微信号..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Click="BatchTagImportButton_Click"
                            CornerRadius="7"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="按微信标签批量导入（通讯录管理）">
                            <FontIcon FontSize="13.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8EC;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Click="AddCustomerButton_Click"
                            CornerRadius="7"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="新建客户 / 截图识别导入">
                            <FontIcon FontSize="14" Foreground="#FFFFFF" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Customer Conversation List -->
                <Grid Grid.Row="1">
                    <StackPanel
                        x:Name="EmptyListHint"
                        Margin="20,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无客户档案" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击上方「+」弹窗截图识别导入，或截图复制后直接按 Ctrl+V。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Height="32"
                            Click="AddCustomerButton_Click"
                            Content="+ 新建 / 截图导入"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>

                    <ListView
                        x:Name="CustomersListView"
                        Padding="6,6"
                        SelectionChanged="CustomersListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomerDto">
                                <Grid Padding="6,9" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Background="{StaticResource BrandSoftBgBrush}"
                                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrandPrimaryBrush}"
                                                Text="{x:Bind AvatarInitial}"
                                                Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                            <Image
                                                Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" RowSpacing="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeShort}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxLines="1" Text="{x:Bind PreviewLine}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- Column 1: Left Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: WeChat-style IM Chat History & Draggable Composer -->
        <Grid x:Name="ChatStageGrid" Grid.Column="2" Background="{StaticResource AppChatCanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="ComposerRow" Height="168" MinHeight="120" MaxHeight="440" />
            </Grid.RowDefinitions>

            <!-- Chat Header -->
            <Border
                Grid.Row="0"
                Padding="18,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ActiveCustomerTitle" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="请选择左侧客户" />
                        <TextBlock x:Name="ActiveCustomerMeta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="点左上角「+」可弹出截图识别导入窗口" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MultiSelectMessagesButton" Height="30" Padding="10,0" Click="MultiSelectMessagesButton_Click" Content="多选" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button Height="30" Padding="10,0" Click="RefreshButton_Click" Content="刷新" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Bubbles -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Multi-Select Action Bar -->
                <Border
                    x:Name="MessageMultiSelectBar"
                    Grid.Row="0"
                    Padding="14,8"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <TextBlock x:Name="SelectedMessagesCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="已选 0 条消息" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectAllMessagesButton" Height="26" Padding="10,0" Click="SelectAllMessagesButton_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="DeleteSelectedMessagesButton" Height="26" Padding="10,0" Click="DeleteSelectedMessagesButton_Click" Content="删除所选" FontSize="11.5" IsEnabled="False" Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button Height="26" Padding="10,0" Click="ExitMultiSelectButton_Click" Content="完成" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyChatHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <FontIcon FontSize="22" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8BD;" />
                    </Border>
                    <TextBlock x:Name="EmptyChatTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无聊天记录" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="可在下方输入或点击“粘贴截图提取文字”记录对话" />
                </StackPanel>

                <ListView x:Name="MessagesListView" Grid.Row="1" Padding="18,14" IsItemClickEnabled="True" ItemClick="MessagesListView_ItemClick" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubbleItem">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,4,10,0"
                                    VerticalAlignment="Top"
                                    Click="BubbleCheckBox_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    Visibility="{x:Bind SelectionCheckVisibility, Mode=OneWay}" />

                                <Grid Grid.Column="1">
                                    <!-- Incoming (Left white bubble) -->
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind IncomingVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind SenderInitial}" Visibility="{x:Bind SenderInitialVisibility}" />
                                                <Image Source="{x:Bind SenderAvatar}" Stretch="UniformToFill" Visibility="{x:Bind SenderAvatarVisibility}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatIncomingBgBrush}" BorderBrush="{StaticResource ChatIncomingBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <TextBlock FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Outgoing (Right WeChat-green bubble) -->
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind OutgoingVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatOutgoingBgBrush}" CornerRadius="10,4,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <TextBlock FontSize="13.5" Foreground="{StaticResource ChatOutgoingTextBrush}" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Text="我" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Draggable Horizontal Splitter -->
            <controls:HorizontalResizeSplitter
                x:Name="ComposerSplitter"
                Grid.Row="2"
                Background="{StaticResource AppChatCanvasBgBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                ToolTipService.ToolTip="上下拖动可调整输入框高度">
                <Border
                    Width="40"
                    Height="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppSplitterGripBrush}"
                    CornerRadius="2" />
            </controls:HorizontalResizeSplitter>

            <!-- Bottom IM Composer -->
            <Border Grid.Row="3" Padding="14,10,14,12" Background="{StaticResource AppSurfaceBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <RadioButton x:Name="DirOutgoingRadio" Content="我方回复(绿)" GroupName="CustomerMsgDir" IsChecked="True" />
                            <RadioButton x:Name="DirIncomingRadio" Content="客户发来(白)" GroupName="CustomerMsgDir" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ImportChatScreenshotButton" Height="28" Padding="9,0" Click="ImportChatScreenshotButton_Click" Content="截图导入对话" FontSize="11.5" IsEnabled="False" Style="{StaticResource PrimaryVioletButtonStyle}" ToolTipService.ToolTip="导入整张微信聊天截图，自动区分左右气泡并批量入库" />
                            <Button Height="28" Padding="9,0" Click="OcrChatClipboardButton_Click" Content="粘贴提取单条" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="MessageInputBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Background="{StaticResource AppInputBgBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,7"
                        PlaceholderText="输入聊天内容，或粘贴聊天截图自动提取文字..."
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ComposerHintText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="内容将保存至当前客户沟通记录" />
                        <Button
                            x:Name="SendMessageButton"
                            HorizontalAlignment="Right"
                            Height="30"
                            Padding="18,0"
                            Click="SendMessageButton_Click"
                            Content="发送记录"
                            FontSize="12.5"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Column 3: Right Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Tabbed Right Customer Panel (基本资料 / AI 总结 / AI 对话) -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top 3-Tab Header Strip -->
                <Border Grid.Row="0" Padding="10,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="RightTabProfileBtn"
                            Grid.Column="0"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="profile">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabProfileIcon" FontSize="13" Glyph="&#xE77B;" />
                                    <TextBlock x:Name="RightTabProfileText" FontSize="13" FontWeight="SemiBold" Text="基本资料" />
                                </StackPanel>
                                <Border x:Name="RightTabProfileLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabSummaryBtn"
                            Grid.Column="1"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="summary">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabSummaryIcon" FontSize="13" Glyph="&#xE734;" />
                                    <TextBlock x:Name="RightTabSummaryText" FontSize="13" Text="AI 总结" />
                                </StackPanel>
                                <Border x:Name="RightTabSummaryLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabChatBtn"
                            Grid.Column="2"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="aichat">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabChatIcon" FontSize="13" Glyph="&#xE8F2;" />
                                    <TextBlock x:Name="RightTabChatText" FontSize="13" Text="AI 对话" />
                                </StackPanel>
                                <Border x:Name="RightTabChatLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty Selection State (applies to all right tabs when no customer is selected) -->
                <StackPanel
                    x:Name="EmptyProfileHint"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Spacing="10">
                    <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="12">
                        <FontIcon FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE77B;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未选择客户" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="在左侧选择客户即可查看基本资料、一键 AI 总结或与 AI 讨论跟进方案。" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- TAB 1: 基本资料 (Scrollable profile + bottom Edit/Delete bar) -->
                <Grid x:Name="ProfileTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ProfileContentScroll" Grid.Row="0" Padding="16,14">
                    <StackPanel Spacing="14">
                        <!-- Feedback Banner -->
                        <Border x:Name="ProfileStatusBanner" Padding="10,7" Background="{StaticResource SuccessBgBrush}" CornerRadius="7" Visibility="Collapsed">
                            <TextBlock x:Name="ProfileStatusText" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Top Avatar & Name Identity (Avatar supports 1-click screen capture / paste / upload) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Width="58"
                                Height="58"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="11"
                                ToolTipService.ToolTip="点击拾取/更换客户头像">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Click="PasteAvatar_Click" Text="从剪贴板粘贴头像">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="UploadAvatar_Click" Text="从本地选择图片">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B9;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="ClearAvatarMenuItem" Click="ClearAvatar_Click" Text="清除当前头像">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Grid Width="56" Height="56">
                                    <Border Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <TextBlock x:Name="ProfileAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="客" />
                                            <Image x:Name="ProfileAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <!-- Subtle camera capture indicator badge -->
                                    <Border
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource BrandPrimaryBrush}"
                                        BorderBrush="{StaticResource AppSurfaceBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                        <FontIcon FontSize="9.5" Foreground="#FFFFFF" Glyph="&#xE722;" />
                                    </Border>
                                </Grid>
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileHeaderNameText" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" TextTrimming="CharacterEllipsis" />
                                    <Border x:Name="ProfileGenderBadge" Padding="6,1" Background="{StaticResource GenderMaleBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                        <TextBlock x:Name="ProfileGenderBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GenderMaleTextBrush}" Text="♂ 男" />
                                    </Border>
                                    <Border x:Name="ProfileStatusPill" Padding="6,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                        <TextBlock x:Name="ProfileStatusPillText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="跟进中" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ProfileHeaderAccountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="微信号：-" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ProfileHeaderRegionText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="地区：-" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                        <!-- VIEW MODE: Complete WeChat & CRM Profile Card -->
                        <StackPanel x:Name="ProfileViewModePanel" Spacing="11">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="微信基础资料" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="微信备注" />
                                <TextBlock x:Name="ViewRemarkText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="微信昵称" />
                                <TextBlock x:Name="ViewNicknameText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="性别" />
                                <TextBlock x:Name="ViewGenderText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="未知" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="电话" />
                                <TextBlock x:Name="ViewPhoneText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="个性签名" />
                                <TextBlock x:Name="ViewSignatureText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="来源" />
                                <TextBlock x:Name="ViewSourceText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="添加时间" />
                                <TextBlock x:Name="ViewAddedDateText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Border Height="1" Margin="0,3" Background="{StaticResource AppBorderSubtleBrush}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="客户画像与跟进" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="跟进状态" />
                                <TextBlock x:Name="ViewFollowStatusText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="客户标签" />
                                <TextBlock x:Name="ViewTagsText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="客户描述" />
                                <TextBlock x:Name="ViewDescriptionText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel x:Name="ViewSystemIdsPanel" Spacing="6" Visibility="Collapsed">
                                <Border Height="1" Margin="0,2" Background="{StaticResource AppBorderSubtleBrush}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="本地键" />
                                    <TextBlock x:Name="ViewLocalKeyText" Grid.Column="1" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="原生 ID" />
                                    <TextBlock x:Name="ViewNativeIdText" Grid.Column="1" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Margin="0,3" Background="{StaticResource AppBorderSubtleBrush}" />

                            <!-- Dedicated Bottom Employee Follow-up Notes Card (Read Mode) -->
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="员工跟进备注" />
                                        <Border HorizontalAlignment="Right" Padding="7,2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrandPrimaryBrush}" Text="员工专属" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        x:Name="ViewEmployeeNoteText"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        LineHeight="20"
                                        Text="暂无员工备注，点击「编辑」即可补充客户意向与跟进内容。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- EDIT MODE: Full Editable Fields + Avatar Capture Bar + Employee Notes -->
                        <StackPanel x:Name="ProfileEditModePanel" Spacing="9" Visibility="Collapsed">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="正在编辑客户资料与头像" />

                            <!-- Quick Avatar Action Strip -->
                            <Border Padding="10" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="更换客户头像" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="28" Padding="6,0" HorizontalAlignment="Stretch" Click="PasteAvatar_Click" Content="粘贴图片" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button Grid.Column="1" Height="28" Padding="6,0" HorizontalAlignment="Stretch" Click="UploadAvatar_Click" Content="本地上传" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="EditNameBox" Header="微信昵称" Style="{StaticResource SoftTextBoxStyle}" />
                            <TextBox
                                x:Name="EditRemarkBox"
                                AcceptsReturn="True"
                                Header="微信备注"
                                MaxHeight="88"
                                Style="{StaticResource SoftTextBoxStyle}"
                                TextWrapping="Wrap" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditAccountBox" Grid.Column="0" Header="微信号" Style="{StaticResource SoftTextBoxStyle}" />
                                <ComboBox x:Name="EditGenderBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="性别" SelectedIndex="0">
                                    <ComboBoxItem Content="未知" />
                                    <ComboBoxItem Content="男" />
                                    <ComboBoxItem Content="女" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditRegionBox" Grid.Column="0" Header="地区" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="EditPhoneBox" Grid.Column="1" Header="电话" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <TextBox x:Name="EditSignatureBox" Header="个性签名" Style="{StaticResource SoftTextBoxStyle}" TextWrapping="Wrap" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditSourceBox" Grid.Column="0" Header="来源" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="EditAddedDateBox" Grid.Column="1" Header="添加时间" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Border Height="1" Margin="0,2" Background="{StaticResource AppBorderSubtleBrush}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="EditFollowStatusBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="跟进状态" SelectedIndex="0">
                                    <ComboBoxItem Content="未设置" />
                                    <ComboBoxItem Content="新线索" />
                                    <ComboBoxItem Content="跟进中" />
                                    <ComboBoxItem Content="高意向" />
                                    <ComboBoxItem Content="已报价" />
                                    <ComboBoxItem Content="已成交" />
                                    <ComboBoxItem Content="暂缓/流失" />
                                </ComboBox>
                                <TextBox x:Name="EditTagsBox" Grid.Column="1" Header="客户标签" PlaceholderText="如 VIP、高意向" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <TextBox
                                x:Name="EditDescriptionBox"
                                MinHeight="64"
                                AcceptsReturn="True"
                                Header="客户描述"
                                PlaceholderText="公司、职位、业务背景等描述信息..."
                                Style="{StaticResource SoftTextBoxStyle}"
                                TextWrapping="Wrap" />

                            <!-- Dedicated Bottom Employee Follow-up Notes Card (Edit Mode) -->
                            <Border Margin="0,4,0,0" Padding="12" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="员工跟进备注" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="可随时补充跟进要点" />
                                    </Grid>
                                    <TextBox
                                        x:Name="EditEmployeeNoteBox"
                                        MinHeight="88"
                                        AcceptsReturn="True"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                        CornerRadius="7"
                                        Padding="10,8"
                                        PlaceholderText="填写客户需求、报价记录、意向程度或下次跟进时间..."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Collapsible System IDs (local_key / native_id) -->
                            <Expander HorizontalAlignment="Stretch" Header="高级标识（本地键 / 原生 ID）" IsExpanded="False">
                                <StackPanel Padding="0,4" Spacing="8">
                                    <TextBox x:Name="EditLocalKeyBox" Header="本地对象键 (local_key)" PlaceholderText="客户端本地检索键" Style="{StaticResource SoftTextBoxStyle}" />
                                    <TextBox x:Name="EditNativeIdBox" Header="微信原生 ID (native_id)" PlaceholderText="默认留空，核验后绑定" Style="{StaticResource SoftTextBoxStyle}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Action Bar strictly inside 基本资料 Tab -->
                <Border
                    Grid.Row="1"
                    Padding="14,10"
                    Background="{StaticResource AppSurfaceAltBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- Read Mode: Edit & Delete -->
                        <Grid x:Name="ViewActionsBar" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="EditProfileButton"
                                Grid.Column="0"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="EditProfileButton_Click"
                                Content="编辑资料"
                                FontSize="12.5"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                x:Name="DeleteCustomerButton"
                                Grid.Column="1"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="DeleteCustomerButton_Click"
                                Content="删除客户"
                                FontSize="12.5"
                                IsEnabled="False"
                                Style="{StaticResource DangerOutlineButtonStyle}" />
                        </Grid>

                        <!-- Edit Mode: Cancel & Save -->
                        <Grid x:Name="EditActionsBar" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CancelEditButton"
                                Grid.Column="0"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="CancelEditButton_Click"
                                Content="取消"
                                FontSize="12.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                x:Name="SaveProfileButton"
                                Grid.Column="1"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="SaveProfileButton_Click"
                                Content="保存修改"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- TAB 2: AI 总结 -->
                <Grid x:Name="AiSummaryTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Summary Context Header -->
                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="客户完整信息 AI 总结" />
                                <TextBlock x:Name="AiSummaryContextText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="基于：基本资料 · 备注 · 0 条聊天记录" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Name="RegenerateSummaryTopButton"
                                Height="28"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="GenerateAiSummaryButton_Click"
                                Content="重新总结"
                                FontSize="11.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Empty State (Before First Summary) -->
                    <StackPanel
                        x:Name="AiSummaryEmptyPanel"
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="14">
                            <FontIcon FontSize="22" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="一键 AI 总结客户画像" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            LineHeight="19"
                            Text="自动结合该客户的基础资料、标签、员工跟进备注与历史聊天记录，提炼客户意向与跟进建议。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="GenerateAiSummaryButton"
                            Height="36"
                            Margin="0,4,0,0"
                            Padding="20,0"
                            HorizontalAlignment="Center"
                            Click="GenerateAiSummaryButton_Click"
                            Content="一键 AI 总结"
                            FontSize="13"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>

                    <!-- Generating State -->
                    <StackPanel
                        x:Name="AiSummaryLoadingPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <ProgressRing x:Name="AiSummarySpinner" Width="28" Height="28" IsActive="False" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="正在梳理客户完整资料与对话要点..." />
                    </StackPanel>

                    <!-- Generated Summary Card -->
                    <ScrollViewer x:Name="AiSummaryResultScroll" Grid.Row="1" Padding="14,12" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="AI 客户档案总结" />
                                        </StackPanel>
                                        <TextBlock x:Name="AiSummaryTimeText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrandSoftBorderBrush}" Opacity="0.65" />
                                    <TextBlock
                                        x:Name="AiSummaryContentText"
                                        FontSize="13"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        LineHeight="21"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AiSummaryNoticeText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="当前为界面本地预览，后续接入服务端 AI 接口后将由大模型深度生成。" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Summary Actions -->
                    <Border
                        x:Name="AiSummaryFooterBar"
                        Grid.Row="2"
                        Padding="14,10"
                        Background="{StaticResource AppSurfaceAltBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="CopyAiSummaryButton_Click"
                                Content="复制总结"
                                FontSize="12.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="GenerateAiSummaryButton_Click"
                                Content="重新总结"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 3: AI 对话 (Scoped per customer, context saved locally) -->
                <Grid x:Name="AiChatTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Context Strip -->
                    <Border Grid.Row="0" Padding="14,9" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="AiChatContextTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="基于当前客户完整资料讨论" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="对话上下文仅保存于本地" />
                            </StackPanel>
                            <Button
                                x:Name="ClearAiChatButton"
                                Height="26"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ClearAiChatButton_Click"
                                Content="清空对话"
                                FontSize="11.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Conversation Area -->
                    <Grid Grid.Row="1">
                        <!-- Empty Starter State -->
                        <StackPanel
                            x:Name="AiChatEmptyPanel"
                            Padding="18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <Border Width="44" Height="44" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="12">
                                <FontIcon FontSize="19" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8F2;" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="与 AI 讨论该客户跟进策略" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="AI 将基于当前客户的完整资料、备注与聊天记录回答问题，试试下方快捷提问："
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <StackPanel Margin="0,4,0,0" Spacing="6">
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="分析这位客户的当前意向与关键需求" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="结合最近对话帮我起草一条跟进话术" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="梳理目前沟通中需要注意的风险点" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Messages Thread -->
                        <ListView x:Name="AiChatListView" Padding="12,10" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,5" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:AiChatMessageItem">
                                    <Grid>
                                        <!-- User Message (Right) -->
                                        <StackPanel HorizontalAlignment="Right" MaxWidth="270" Spacing="3" Visibility="{x:Bind UserVisibility}">
                                            <Border Padding="10,8" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="10,4,10,10">
                                                <TextBlock FontSize="12.5" Foreground="#FFFFFF" IsTextSelectionEnabled="True" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Timestamp}" />
                                        </StackPanel>

                                        <!-- AI Assistant Message (Left) -->
                                        <StackPanel HorizontalAlignment="Left" MaxWidth="290" Spacing="3" Visibility="{x:Bind AssistantVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="AI 助手" />
                                            </StackPanel>
                                            <Border Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" LineHeight="19" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Timestamp}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Bottom Input Bar -->
                    <Border
                        Grid.Row="2"
                        Padding="12,10"
                        Background="{StaticResource AppSurfaceAltBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AiChatInputBox"
                                Grid.Column="0"
                                MaxHeight="88"
                                Padding="10,7"
                                AcceptsReturn="True"
                                FontSize="12.5"
                                KeyDown="AiChatInputBox_KeyDown"
                                PlaceholderText="围绕该客户向 AI 提问..."
                                Style="{StaticResource SoftTextBoxStyle}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="AiChatSendButton"
                                Grid.Column="1"
                                Height="34"
                                Padding="14,0"
                                VerticalAlignment="Bottom"
                                Click="AiChatSendButton_Click"
                                Content="发送"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    xmlns:services="using:Client.Services"
    mc:Ignorable="d">

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="268" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="450" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="356" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: WeChat-style Tag-Grouped Customer List Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + Compact Multi-Select & Unified Add Customer Button -->
                <Border
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Height="32"
                            Padding="8,5"
                            FontSize="12"
                            PlaceholderText="搜索客户/标签..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            x:Name="MultiSelectCustomersButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="MultiSelectCustomersButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="多选批量删除客户">
                            <FontIcon x:Name="MultiSelectCustomersIcon" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE762;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="AddCustomerButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="从微信添加/导入客户">
                            <FontIcon FontSize="13" Foreground="#FFFFFF" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Compact Batch Delete Bar (Visible in Customer Multi-Select Mode) -->
                <Border
                    x:Name="CustomerMultiSelectBar"
                    Grid.Row="1"
                    Padding="8,5"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="4">
                        <TextBlock
                            x:Name="SelectedCustomersCountText"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandHighlightTextBrush}"
                            Text="已选 0" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="SelectAllCustomersButton"
                                Height="24"
                                Padding="7,0"
                                Click="SelectAllCustomersButton_Click"
                                Content="全选"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                x:Name="DeleteSelectedCustomersButton"
                                Height="24"
                                Padding="7,0"
                                Click="DeleteSelectedCustomersButton_Click"
                                Content="删除"
                                FontSize="11"
                                IsEnabled="False"
                                Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button
                                Height="24"
                                Padding="7,0"
                                Click="ExitCustomerMultiSelectButton_Click"
                                Content="取消"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tag-Grouped Collapsible Customer List -->
                <Grid Grid.Row="2">
                    <ListView
                        x:Name="CustomersListView"
                        Padding="6,4"
                        IsItemClickEnabled="True"
                        ItemClick="CustomersListView_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomerListRow">
                                <Grid>
                                    <!-- Tag Group Header Row -->
                                    <Border
                                        Margin="0,4,0,1"
                                        Padding="6,4"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Visibility="{x:Bind GroupHeaderVisibility}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="SelectTagGroupMenuItem_Click" Text="勾选此标签下全部客户">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="ExpandAllGroupsMenuItem_Click" Text="展开全部标签">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="CollapseAllGroupsMenuItem_Click" Text="折叠全部标签">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76C;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="GroupHeaderCheckBox_Click"
                                                IsChecked="{x:Bind IsGroupAllSelected, Mode=OneWay}"
                                                Visibility="{x:Bind GroupCheckVisibility, Mode=OneWay}" />

                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="9.5"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontSize="10" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8EC;" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{x:Bind TagName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="3"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource AppBorderSubtleBrush}"
                                                CornerRadius="8">
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind GroupCountText}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Compact Customer Row -->
                                    <Border
                                        Margin="0,1"
                                        Padding="6,6"
                                        Background="{x:Bind RowBackground, Mode=OneWay}"
                                        BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Visibility="{x:Bind CustomerRowVisibility}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="MultiSelectCustomerRowMenuItem_Click" Text="多选批量管理">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="DeleteCustomerRowMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除此客户">
                                                    <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="CustomerRowCheckBox_Click"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Visibility="{x:Bind CustomerCheckVisibility, Mode=OneWay}" />

                                            <Border
                                                Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                Background="{StaticResource BrandSoftBgBrush}"
                                                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                                <Grid>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="13.5"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                                        Text="{x:Bind AvatarInitial}"
                                                        Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                    <Image
                                                        Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                        Stretch="UniformToFill"
                                                        Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeShort}" />
                                                </Grid>

                                                <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" MaxLines="1" Text="{x:Bind PreviewLine}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyListHint"
                        Margin="20,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无客户档案" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击下方或左上角「+」，按微信标签挑选好友导入，导入后自动监听消息更新。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Height="32"
                            Click="AddCustomerButton_Click"
                            Content="从微信选择好友导入"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Column 1: Left Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: WeChat-style IM Chat History & Draggable Composer -->
        <Grid x:Name="ChatStageGrid" Grid.Column="2" Background="{StaticResource AppChatCanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="ComposerRow" Height="168" MinHeight="120" MaxHeight="440" />
            </Grid.RowDefinitions>

            <!-- Chat Header -->
            <Border
                Grid.Row="0"
                Padding="18,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ActiveCustomerTitle" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="请选择左侧客户" />
                        <TextBlock x:Name="ActiveCustomerMeta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="点击左上角「+」按微信标签挑选并导入客户，导入后自动监听新消息" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SyncTagsNowButton"
                            Height="30"
                            Padding="11,0"
                            Click="SyncTagsNowButton_Click"
                            FontSize="12"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="同步已导入客户的最新微信资料与聊天记录并刷新列表">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE895;" />
                                <TextBlock Text="刷新同步" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MultiSelectMessagesButton" Height="30" Padding="10,0" Click="MultiSelectMessagesButton_Click" Content="多选" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Bubbles -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Load Older Messages Strip (Visible when history has more pages) -->
                <Border
                    x:Name="LoadOlderMessagesBar"
                    Grid.Row="0"
                    Padding="0,6,0,2"
                    Background="Transparent"
                    Visibility="Collapsed">
                    <Button
                        x:Name="LoadOlderMessagesButton"
                        Height="26"
                        Padding="12,0"
                        HorizontalAlignment="Center"
                        Click="LoadOlderMessagesButton_Click"
                        CornerRadius="13"
                        FontSize="11.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE81C;" />
                            <TextBlock x:Name="LoadOlderMessagesText" Text="查看更早聊天记录" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Multi-Select Action Bar -->
                <Border
                    x:Name="MessageMultiSelectBar"
                    Grid.Row="1"
                    Padding="14,8"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <TextBlock x:Name="SelectedMessagesCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="已选 0 条消息" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectAllMessagesButton" Height="26" Padding="10,0" Click="SelectAllMessagesButton_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="DeleteSelectedMessagesButton" Height="26" Padding="10,0" Click="DeleteSelectedMessagesButton_Click" Content="删除所选" FontSize="11.5" IsEnabled="False" Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button Height="26" Padding="10,0" Click="ExitMultiSelectButton_Click" Content="完成" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyChatHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <FontIcon FontSize="22" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8BD;" />
                    </Border>
                    <TextBlock x:Name="EmptyChatTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无聊天记录" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="可点击顶部「刷新同步」拉取微信聊天记录，或在下方直接补充对话" />
                </StackPanel>

                <ListView x:Name="MessagesListView" Grid.Row="2" Padding="18,14" IsItemClickEnabled="False" ItemClick="MessagesListView_ItemClick" SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubbleItem">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,4,10,0"
                                    VerticalAlignment="Top"
                                    Click="BubbleCheckBox_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    Visibility="{x:Bind SelectionCheckVisibility, Mode=OneWay}" />

                                <Grid Grid.Column="1">
                                    <!-- Incoming (Left white bubble) -->
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind IncomingVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind SenderInitial}" Visibility="{x:Bind SenderInitialVisibility}" />
                                                <Image Source="{x:Bind SenderAvatar}" Stretch="UniformToFill" Visibility="{x:Bind SenderAvatarVisibility}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatIncomingBgBrush}" BorderBrush="{StaticResource ChatIncomingBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout Opening="BubbleContextFlyout_Opening">
                                                        <MenuFlyoutItem Click="TranscribeVoiceBubbleMenuItem_Click" Tag="VoiceTranscribe" Text="语音转文字" Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="EditBubbleMenuItem_Click" Text="编辑消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertAboveBubbleMenuItem_Click" Text="在上方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertBelowBubbleMenuItem_Click" Text="在下方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Spacing="6">
                                                    <controls:WeChatMessageContentView
                                                        AudioUrl="{x:Bind AudioUrl, Mode=OneWay}"
                                                        IsOutgoing="False"
                                                        Text="{x:Bind Content, Mode=OneWay}"
                                                        VideoUrl="{x:Bind VideoUrl, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentOrAudioVisibility, Mode=OneWay}" />
                                                    <Button
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="ChatBubbleImage_Click"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="点击查看大图"
                                                        Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}">
                                                        <Border
                                                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <Grid>
                                                                <Image
                                                                    MaxWidth="240"
                                                                    MaxHeight="240"
                                                                    Source="{x:Bind BubbleImage, Mode=OneWay}"
                                                                    Stretch="Uniform" />
                                                                <Grid Visibility="{x:Bind VideoPlayOverlayVisibility, Mode=OneWay}">
                                                                    <Border
                                                                        Margin="6"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Background="#A6000000"
                                                                        CornerRadius="5">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                            <FontIcon FontSize="11" Foreground="#FFFFFF" Glyph="&#xE714;" />
                                                                            <TextBlock FontSize="10.5" Foreground="#FFFFFF" Text="{x:Bind VideoDurationBadge, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Outgoing (Right WeChat-green bubble) -->
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind OutgoingVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatOutgoingBgBrush}" CornerRadius="10,4,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout Opening="BubbleContextFlyout_Opening">
                                                        <MenuFlyoutItem Click="TranscribeVoiceBubbleMenuItem_Click" Tag="VoiceTranscribe" Text="语音转文字" Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="EditBubbleMenuItem_Click" Text="编辑消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertAboveBubbleMenuItem_Click" Text="在上方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertBelowBubbleMenuItem_Click" Text="在下方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Spacing="6">
                                                    <controls:WeChatMessageContentView
                                                        AudioUrl="{x:Bind AudioUrl, Mode=OneWay}"
                                                        IsOutgoing="True"
                                                        Text="{x:Bind Content, Mode=OneWay}"
                                                        VideoUrl="{x:Bind VideoUrl, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentOrAudioVisibility, Mode=OneWay}" />
                                                    <Button
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="ChatBubbleImage_Click"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="点击查看大图"
                                                        Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}">
                                                        <Border
                                                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <Grid>
                                                                <Image
                                                                    MaxWidth="240"
                                                                    MaxHeight="240"
                                                                    Source="{x:Bind BubbleImage, Mode=OneWay}"
                                                                    Stretch="Uniform" />
                                                                <Grid Visibility="{x:Bind VideoPlayOverlayVisibility, Mode=OneWay}">
                                                                    <Border
                                                                        Margin="6"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Background="#A6000000"
                                                                        CornerRadius="5">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                            <FontIcon FontSize="11" Foreground="#FFFFFF" Glyph="&#xE714;" />
                                                                            <TextBlock FontSize="10.5" Foreground="#FFFFFF" Text="{x:Bind VideoDurationBadge, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Text="我" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Draggable Horizontal Splitter -->
            <controls:HorizontalResizeSplitter
                x:Name="ComposerSplitter"
                Grid.Row="2"
                Background="{StaticResource AppChatCanvasBgBrush}"
                BorderThickness="0"
                ToolTipService.ToolTip="上下拖动可调整输入框高度">
                <Border
                    Width="36"
                    Height="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource AppSplitterGripBrush}"
                    CornerRadius="2"
                    Opacity="0.7" />
            </controls:HorizontalResizeSplitter>

            <!-- Codex-Style Floating Rounded Customer Chat Composer -->
            <Grid Grid.Row="3" Padding="16,4,16,14" Background="{StaticResource AppChatCanvasBgBrush}">
                <Border
                    Padding="13,10,12,9"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Pending Chat Image Attachment Preview Strip -->
                        <Border
                            x:Name="PendingChatImageBar"
                            Grid.Row="0"
                            Padding="7,5"
                            Background="{StaticResource AppCanvasBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PreviewPendingChatImage_Click"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="点击放大查看待发送图片">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Image x:Name="PendingChatImageThumb" Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                                <TextBlock
                                    x:Name="PendingChatImageNameText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="已附加图片"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ClearPendingChatImage_Click"
                                    CornerRadius="12"
                                    ToolTipService.ToolTip="移除图片">
                                    <FontIcon FontSize="11" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Borderless Seamless Multi-line Input -->
                        <TextBox
                            x:Name="MessageInputBox"
                            Grid.Row="1"
                            Padding="3,2"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13.5"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            KeyDown="MessageInputBox_KeyDown"
                            Paste="MessageInputBox_Paste"
                            PlaceholderText="输入聊天内容...（Enter 发送，Shift+Enter 换行，可点下方上传图片）"
                            TextWrapping="Wrap">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Bottom Toolbar inside Rounded Card -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <!-- Direction Segmented Pill -->
                                <Border
                                    Padding="2"
                                    Background="{StaticResource AppCanvasBgBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button
                                            x:Name="DirOutgoingBtn"
                                            Height="24"
                                            Padding="10,0"
                                            BorderThickness="0"
                                            Click="DirToggleBtn_Click"
                                            CornerRadius="12"
                                            FontSize="11.5"
                                            Tag="outgoing"
                                            Content="我方" />
                                        <Button
                                            x:Name="DirIncomingBtn"
                                            Height="24"
                                            Padding="10,0"
                                            BorderThickness="0"
                                            Click="DirToggleBtn_Click"
                                            CornerRadius="12"
                                            FontSize="11.5"
                                            Tag="incoming"
                                            Content="客户" />
                                    </StackPanel>
                                </Border>

                                <!-- Upload Chat Image Icon Button -->
                                <Button
                                    x:Name="UploadChatImageButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Click="UploadChatImageButton_Click"
                                    CornerRadius="15"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="上传图片消息（或聚焦输入框后 Ctrl+V 粘贴图片）">
                                    <FontIcon FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE91B;" />
                                </Button>
                            </StackPanel>

                            <TextBlock
                                x:Name="ComposerHintText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="6,0"
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                x:Name="SendMessageButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="SendMessageButton_Click"
                                CornerRadius="16"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryVioletButtonStyle}"
                                ToolTipService.ToolTip="发送记录 (Enter)">
                                <FontIcon FontSize="13" Foreground="#FFFFFF" Glyph="&#xE74A;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Column 3: Right Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Tabbed Right Customer Panel (基本资料 / AI 总结 / AI 对话) -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top 3-Tab Header Strip -->
                <Border Grid.Row="0" Padding="10,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="RightTabProfileBtn"
                            Grid.Column="0"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="profile">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabProfileIcon" FontSize="13" Glyph="&#xE77B;" />
                                    <TextBlock x:Name="RightTabProfileText" FontSize="13" FontWeight="SemiBold" Text="基本资料" />
                                </StackPanel>
                                <Border x:Name="RightTabProfileLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabSummaryBtn"
                            Grid.Column="1"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="summary">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabSummaryIcon" FontSize="13" Glyph="&#xE734;" />
                                    <TextBlock x:Name="RightTabSummaryText" FontSize="13" Text="AI 总结" />
                                </StackPanel>
                                <Border x:Name="RightTabSummaryLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabChatBtn"
                            Grid.Column="2"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="aichat">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabChatIcon" FontSize="13" Glyph="&#xE8F2;" />
                                    <TextBlock x:Name="RightTabChatText" FontSize="13" Text="AI 对话" />
                                </StackPanel>
                                <Border x:Name="RightTabChatLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty Selection State (applies to all right tabs when no customer is selected) -->
                <StackPanel
                    x:Name="EmptyProfileHint"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Spacing="10">
                    <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="12">
                        <FontIcon FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE77B;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未选择客户" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="在左侧选择客户即可查看基本资料、一键 AI 总结或与 AI 讨论跟进方案。" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- TAB 1: 基本资料 (Clean view card; edit opens modal dialog) -->
                <Grid x:Name="ProfileTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer x:Name="ProfileContentScroll" Padding="16,14">
                    <StackPanel Spacing="14">
                        <!-- Feedback Banner -->
                        <Border x:Name="ProfileStatusBanner" Padding="10,7" Background="{StaticResource SuccessBgBrush}" CornerRadius="7" Visibility="Collapsed">
                            <TextBlock x:Name="ProfileStatusText" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Top Avatar & Name Identity (Avatar supports 1-click screen capture / paste / upload) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Width="58"
                                Height="58"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="11"
                                ToolTipService.ToolTip="点击拾取/更换客户头像">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Click="PasteAvatar_Click" Text="从剪贴板粘贴头像">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="UploadAvatar_Click" Text="从本地选择图片">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B9;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="ClearAvatarMenuItem" Click="ClearAvatar_Click" Text="清除当前头像">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Grid Width="56" Height="56">
                                    <Border Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <TextBlock x:Name="ProfileAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="客" />
                                            <Image x:Name="ProfileAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <!-- Subtle camera capture indicator badge -->
                                    <Border
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource BrandPrimaryBrush}"
                                        BorderBrush="{StaticResource AppSurfaceBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                        <FontIcon FontSize="9.5" Foreground="#FFFFFF" Glyph="&#xE722;" />
                                    </Border>
                                </Grid>
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileHeaderNameText" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" TextTrimming="CharacterEllipsis" />
                                    <Border x:Name="ProfileGenderBadge" Padding="6,1" Background="{StaticResource GenderMaleBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                        <TextBlock x:Name="ProfileGenderBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GenderMaleTextBrush}" Text="♂ 男" />
                                    </Border>
                                    <Border x:Name="ProfileStatusPill" Padding="6,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                        <TextBlock x:Name="ProfileStatusPillText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="跟进中" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ProfileHeaderAccountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="微信号：-" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProfileHeaderRegionText" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="地区：-" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="5">
                                        <Button
                                            x:Name="EditProfileButton"
                                            Width="26"
                                            Height="26"
                                            Padding="0"
                                            Click="EditProfileButton_Click"
                                            CornerRadius="6"
                                            IsEnabled="False"
                                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                                            ToolTipService.ToolTip="编辑客户资料与备注">
                                            <FontIcon FontSize="11.5" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            x:Name="DeleteCustomerButton"
                                            Width="26"
                                            Height="26"
                                            Padding="0"
                                            Click="DeleteCustomerButton_Click"
                                            CornerRadius="6"
                                            IsEnabled="False"
                                            Style="{StaticResource DangerOutlineButtonStyle}"
                                            ToolTipService.ToolTip="删除客户">
                                            <FontIcon FontSize="11.5" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                        <!-- VIEW MODE: Complete WeChat & CRM Profile Card -->
                        <StackPanel x:Name="ProfileViewModePanel" Spacing="11">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="微信基础资料" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="微信备注" />
                                <TextBlock x:Name="ViewRemarkText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="微信昵称" />
                                <TextBlock x:Name="ViewNicknameText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="性别" />
                                <TextBlock x:Name="ViewGenderText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="未知" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="电话" />
                                <TextBlock x:Name="ViewPhoneText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="个性签名" />
                                <TextBlock x:Name="ViewSignatureText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="添加时间" />
                                <TextBlock x:Name="ViewAddedDateText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Border Height="1" Margin="0,3" Background="{StaticResource AppBorderSubtleBrush}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="客户画像与跟进" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="跟进状态" />
                                <TextBlock x:Name="ViewFollowStatusText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Text="-" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="客户标签" />
                                <TextBlock x:Name="ViewTagsText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Text="客户描述" />
                                <TextBlock x:Name="ViewDescriptionText" Grid.Column="1" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="-" TextWrapping="Wrap" />
                            </Grid>

                            <Border Height="1" Margin="0,3" Background="{StaticResource AppBorderSubtleBrush}" />

                            <!-- Dedicated Bottom Employee Follow-up Notes Card (Read Mode) -->
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="员工跟进备注" />
                                    <TextBlock
                                        x:Name="ViewEmployeeNoteText"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        LineHeight="20"
                                        Text="暂无员工备注，点击上方编辑图标即可补充客户意向与跟进内容。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- TAB 2: AI 总结 -->
                <Grid x:Name="AiSummaryTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Summary Context Header -->
                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="客户 AI 总结" />
                            <TextBlock x:Name="AiSummaryContextText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="0 条对话" />
                        </Grid>
                    </Border>

                    <!-- Empty State (Before First Summary) -->
                    <StackPanel
                        x:Name="AiSummaryEmptyPanel"
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="14">
                            <FontIcon FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="暂无客户总结" />
                        <Border
                            x:Name="AiSummaryErrorBanner"
                            Padding="10,7"
                            Background="{StaticResource DangerBgBrush}"
                            CornerRadius="7"
                            Visibility="Collapsed">
                            <TextBlock x:Name="AiSummaryErrorText" FontSize="11.5" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Button
                            x:Name="GenerateAiSummaryButton"
                            Height="34"
                            Padding="20,0"
                            HorizontalAlignment="Center"
                            Click="GenerateAiSummaryButton_Click"
                            Content="生成总结"
                            FontSize="12.5"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>

                    <!-- Generating State -->
                    <StackPanel
                        x:Name="AiSummaryLoadingPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <ProgressRing x:Name="AiSummarySpinner" Width="28" Height="28" IsActive="False" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="正在生成客户总结..." />
                    </StackPanel>

                    <!-- Generated Summary Card (Markdown Rendered) -->
                    <ScrollViewer x:Name="AiSummaryResultScroll" Grid.Row="1" Padding="14,12" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="客户画像与跟进总结" />
                                        </StackPanel>
                                        <TextBlock x:Name="AiSummaryTimeText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrandSoftBorderBrush}" Opacity="0.65" />
                                    <controls:MarkdownTextView x:Name="AiSummaryMarkdownView" BaseFontSize="12.5" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AiSummaryNoticeText" FontSize="11.5" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Summary Actions -->
                    <Border
                        x:Name="AiSummaryFooterBar"
                        Grid.Row="2"
                        Padding="14,10"
                        Background="{StaticResource AppSurfaceAltBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="CopyAiSummaryButton_Click"
                                Content="复制总结"
                                FontSize="12.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="GenerateAiSummaryButton_Click"
                                Content="重新总结"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 3: AI 对话 (Scoped per customer) -->
                <Grid x:Name="AiChatTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Context Strip -->
                    <Border Grid.Row="0" Padding="14,9" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <TextBlock x:Name="AiChatContextTitle" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="AI 对话" TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ClearAiChatButton"
                                Height="26"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ClearAiChatButton_Click"
                                Content="清空"
                                FontSize="11.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </Grid>
                    </Border>

                    <!-- Conversation Area -->
                    <Grid Grid.Row="1">
                        <!-- Empty Starter State -->
                        <StackPanel
                            x:Name="AiChatEmptyPanel"
                            Padding="18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <Border Width="42" Height="42" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="12">
                                <FontIcon FontSize="18" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8F2;" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="快捷提问" />

                            <StackPanel Margin="0,2,0,0" Spacing="6">
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="分析这位客户的当前意向与关键需求" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="结合最近对话帮我起草一条跟进话术" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="梳理目前沟通中需要注意的风险点" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Messages Thread (Markdown + Live Replying Indicator) -->
                        <ListView x:Name="AiChatListView" Padding="12,10" SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,5" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:AiChatMessageItem">
                                    <Grid>
                                        <!-- User Message (Right) -->
                                        <StackPanel HorizontalAlignment="Right" MaxWidth="270" Spacing="3" Visibility="{x:Bind UserVisibility}">
                                            <Border Padding="10,8" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="10,4,10,10">
                                                <StackPanel Spacing="6">
                                                    <ItemsControl ItemsSource="{x:Bind Images}" Visibility="{x:Bind UserImagesVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Width="62" Height="62" CornerRadius="6">
                                                                    <controls:DataUriImage DataUri="{x:Bind}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock FontSize="12.5" Foreground="#FFFFFF" IsTextSelectionEnabled="True" Text="{x:Bind Content}" TextWrapping="Wrap" Visibility="{x:Bind UserTextVisibility}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Timestamp}" />
                                        </StackPanel>

                                        <!-- AI Assistant Message (Left) -->
                                        <StackPanel HorizontalAlignment="Left" MaxWidth="304" Spacing="3" Visibility="{x:Bind AssistantVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="AI 助手" />
                                            </StackPanel>

                                            <!-- Codex-Style Tool Execution Trace -->
                                            <controls:CodexToolTraceView
                                                HorizontalAlignment="Stretch"
                                                LegacySummary="{x:Bind ToolTraceSummary}"
                                                TraceItems="{x:Bind ToolTrace}"
                                                Visibility="{x:Bind ToolTraceVisibility}" />

                                            <!-- Live Thinking / Replying Bubble -->
                                            <Border
                                                Padding="10,8"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,10,10,10"
                                                Visibility="{x:Bind PendingVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsPending}" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Content}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Markdown Rendered Assistant Bubble -->
                                            <Border
                                                Padding="10,9"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,10,10,10"
                                                Visibility="{x:Bind AssistantContentVisibility}">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyAiChatMessageMenuItem_Click" Text="复制回复">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <controls:MarkdownTextView BaseFontSize="12.5" Text="{x:Bind Content}" />
                                            </Border>

                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{x:Bind Timestamp}"
                                                Visibility="{x:Bind TimestampVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Codex-Style Compact Rounded Input Card -->
                    <Grid Grid.Row="2" Padding="10,6,10,10">
                        <Border
                            Padding="10,8,9,8"
                            Background="{StaticResource AppCanvasBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Attached Image Preview Strip -->
                                <ScrollViewer
                                    x:Name="AiChatPendingImagesScroll"
                                    Grid.Row="0"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled"
                                    Visibility="Collapsed">
                                    <ItemsControl x:Name="AiChatPendingImagesItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:AiImageAttachment">
                                                <Grid Width="48" Height="48">
                                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="7">
                                                        <Image Source="{x:Bind Preview}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Button
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,2,2,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#CC1E2430"
                                                        BorderThickness="0"
                                                        Click="RemoveCustomerAiImage_Click"
                                                        CornerRadius="8"
                                                        Tag="{x:Bind Id}">
                                                        <FontIcon FontSize="8" Foreground="#FFFFFF" Glyph="&#xE8BB;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Borderless Multi-line Input -->
                                <TextBox
                                    x:Name="AiChatInputBox"
                                    Grid.Row="1"
                                    MinHeight="34"
                                    MaxHeight="96"
                                    Padding="2,2"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    KeyDown="AiChatInputBox_KeyDown"
                                    Paste="AiChatInputBox_Paste"
                                    PlaceholderText="输入问题，支持粘贴或上传图片..."
                                    TextWrapping="Wrap">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- Bottom Action Bar (+ Image | Circular Send) -->
                                <Grid Grid.Row="2">
                                    <Button
                                        x:Name="AiChatAttachButton"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        ToolTipService.ToolTip="添加图片">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                                <MenuFlyoutItem Click="UploadCustomerAiImage_Click" Text="上传本地图片">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8B9;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="PasteCustomerAiImage_Click" Text="粘贴剪贴板图片">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE77F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE710;" />
                                    </Button>

                                    <Button
                                        x:Name="AiChatSendButton"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="AiChatSendButton_Click"
                                        CornerRadius="14"
                                        Style="{StaticResource PrimaryVioletButtonStyle}"
                                        ToolTipService.ToolTip="发送 (Enter)">
                                        <Grid>
                                            <FontIcon x:Name="AiChatSendIcon" FontSize="12" Foreground="#FFFFFF" Glyph="&#xE74A;" />
                                            <ProgressRing x:Name="AiChatSendBusyRing" Width="13" Height="13" Foreground="#FFFFFF" IsActive="False" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    xmlns:services="using:Client.Services"
    mc:Ignorable="d">

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="268" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="450" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="356" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: WeChat-style Group List Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + Compact Multi-Select & Unified "+" Add Group Button -->
                <Border
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Height="32"
                            Padding="8,5"
                            FontSize="12"
                            PlaceholderText="搜索群名称/成员..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            x:Name="MultiSelectGroupsButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="MultiSelectGroupsButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="多选批量删除群组">
                            <FontIcon x:Name="MultiSelectGroupsIcon" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE762;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="AddGroupButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="从微信添加/导入群聊">
                            <FontIcon FontSize="13" Foreground="#FFFFFF" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Compact Batch Delete Bar (Visible in Group Multi-Select Mode) -->
                <Border
                    x:Name="GroupMultiSelectBar"
                    Grid.Row="1"
                    Padding="8,5"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="4">
                        <TextBlock
                            x:Name="SelectedGroupsCountText"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandHighlightTextBrush}"
                            Text="已选 0" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="SelectAllGroupsButton"
                                Height="24"
                                Padding="7,0"
                                Click="SelectAllGroupsButton_Click"
                                Content="全选"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                x:Name="DeleteSelectedGroupsButton"
                                Height="24"
                                Padding="7,0"
                                Click="DeleteSelectedGroupsButton_Click"
                                Content="删除"
                                FontSize="11"
                                IsEnabled="False"
                                Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button
                                Height="24"
                                Padding="7,0"
                                Click="ExitGroupMultiSelectButton_Click"
                                Content="取消"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Groups List -->
                <Grid Grid.Row="2">
                    <ListView
                        x:Name="GroupsListView"
                        Padding="6,4"
                        IsItemClickEnabled="True"
                        ItemClick="GroupsListView_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupDto">
                                <Border
                                    Margin="0,1"
                                    Padding="6,6"
                                    Background="{x:Bind RowBackground, Mode=OneWay}"
                                    BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="MultiSelectGroupRowMenuItem_Click" Text="多选批量管理">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="DeleteGroupRowMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除此群组">
                                                <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Click="GroupRowCheckBox_Click"
                                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                            Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />

                                        <Border
                                            Grid.Column="1"
                                            Width="34"
                                            Height="34"
                                            Background="{StaticResource InfoBgBrush}"
                                            BorderBrush="{StaticResource InfoBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13.5"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource InfoTextBrush}"
                                                    Text="{x:Bind AvatarInitial}"
                                                    Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                <Image
                                                    Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayTitleWithCount}" TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource SuccessBgBrush}"
                                                    CornerRadius="4"
                                                    ToolTipService.ToolTip="已开启 AI 自动回复"
                                                    Visibility="{x:Bind AutoReplyBadgeVisibility, Mode=OneWay}">
                                                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" Text="AI" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeShort}" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" MaxLines="1" Text="{x:Bind PreviewLine}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyListHint"
                        Margin="20,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无群组档案" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击下方或左上角「+」，勾选要管理的微信群导入群头像、成员与聊天记录，并自动巡检同步。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Height="32"
                            Click="AddGroupButton_Click"
                            Content="从微信选择群聊导入"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Column 1: Left Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: WeChat-style Group IM Chat Stage -->
        <Grid x:Name="ChatStageGrid" Grid.Column="2" Background="{StaticResource AppChatCanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="ComposerRow" Height="172" MinHeight="128" MaxHeight="440" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ActiveGroupTitle" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="请选择左侧群组" />
                        <TextBlock x:Name="ActiveGroupMeta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="点击左上角「+」选择要管理的微信群，导入后自动巡检监听新消息" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SearchMessagesButton"
                            Height="30"
                            Padding="10,0"
                            Click="SearchMessagesButton_Click"
                            FontSize="12"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="按关键词或日期查找历史群聊记录">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE721;" />
                                <TextBlock Text="查找记录" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SyncActiveGroupsNowButton"
                            Height="30"
                            Padding="11,0"
                            Click="SyncActiveGroupsNowButton_Click"
                            FontSize="12"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="同步已导入群聊的最新群消息、群成员与群头像并刷新列表">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE895;" />
                                <TextBlock Text="刷新同步" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MultiSelectMessagesButton" Height="30" Padding="10,0" Click="MultiSelectMessagesButton_Click" Content="多选" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Group Chat Bubbles -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Load Older Group Messages Strip -->
                <Border
                    x:Name="LoadOlderMessagesBar"
                    Grid.Row="0"
                    Padding="0,6,0,2"
                    Background="Transparent"
                    Visibility="Collapsed">
                    <Button
                        x:Name="LoadOlderMessagesButton"
                        Height="26"
                        Padding="12,0"
                        HorizontalAlignment="Center"
                        Click="LoadOlderMessagesButton_Click"
                        CornerRadius="13"
                        FontSize="11.5"
                        Style="{StaticResource SecondaryOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE81C;" />
                            <TextBlock x:Name="LoadOlderMessagesText" Text="查看更早群聊记录" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Multi-Select Action Bar -->
                <Border
                    x:Name="MessageMultiSelectBar"
                    Grid.Row="1"
                    Padding="14,8"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <TextBlock x:Name="SelectedMessagesCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="已选 0 条消息" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectAllMessagesButton" Height="26" Padding="10,0" Click="SelectAllMessagesButton_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="DeleteSelectedMessagesButton" Height="26" Padding="10,0" Click="DeleteSelectedMessagesButton_Click" Content="删除所选" FontSize="11.5" IsEnabled="False" Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button Height="26" Padding="10,0" Click="ExitMultiSelectButton_Click" Content="完成" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyChatHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <FontIcon FontSize="22" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock x:Name="EmptyChatTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无群聊记录" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="可点击顶部「刷新同步」拉取微信群聊记录，或在下方直接补充对话" />
                </StackPanel>

                <ListView x:Name="MessagesListView" Grid.Row="2" Padding="18,14" IsItemClickEnabled="False" ItemClick="MessagesListView_ItemClick" SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubbleItem">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,4,10,0"
                                    VerticalAlignment="Top"
                                    Click="BubbleCheckBox_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    Visibility="{x:Bind SelectionCheckVisibility, Mode=OneWay}" />

                                <Grid Grid.Column="1">
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind IncomingVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="{x:Bind SenderInitial}" Visibility="{x:Bind SenderInitialVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind SenderAvatar, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind SenderAvatarVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="460" Spacing="3">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SenderName, Mode=OneWay}" Visibility="{x:Bind SenderNameVisibility, Mode=OneWay}" />
                                            <Border Padding="12,9" Background="{StaticResource ChatIncomingBgBrush}" BorderBrush="{StaticResource ChatIncomingBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout Opening="BubbleContextFlyout_Opening">
                                                        <MenuFlyoutItem Click="TranscribeVoiceBubbleMenuItem_Click" Tag="VoiceTranscribe" Text="语音转文字" Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="EditBubbleMenuItem_Click" Text="编辑消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertAboveBubbleMenuItem_Click" Text="在上方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertBelowBubbleMenuItem_Click" Text="在下方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Spacing="6">
                                                    <controls:WeChatMessageContentView
                                                        AudioUrl="{x:Bind AudioUrl, Mode=OneWay}"
                                                        IsOutgoing="False"
                                                        Text="{x:Bind Content, Mode=OneWay}"
                                                        VideoUrl="{x:Bind VideoUrl, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentOrAudioVisibility, Mode=OneWay}" />
                                                    <Button
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="ChatBubbleImage_Click"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="点击查看大图"
                                                        Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}">
                                                        <Border
                                                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <Grid>
                                                                <Image
                                                                    MaxWidth="240"
                                                                    MaxHeight="240"
                                                                    Source="{x:Bind BubbleImage, Mode=OneWay}"
                                                                    Stretch="Uniform" />
                                                                <Grid Visibility="{x:Bind VideoPlayOverlayVisibility, Mode=OneWay}">
                                                                    <Border
                                                                        Margin="6"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Background="#A6000000"
                                                                        CornerRadius="5">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                            <FontIcon FontSize="11" Foreground="#FFFFFF" Glyph="&#xE714;" />
                                                                            <TextBlock FontSize="10.5" Foreground="#FFFFFF" Text="{x:Bind VideoDurationBadge, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="10" Visibility="{x:Bind OutgoingVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatOutgoingBgBrush}" CornerRadius="10,4,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout Opening="BubbleContextFlyout_Opening">
                                                        <MenuFlyoutItem Click="TranscribeVoiceBubbleMenuItem_Click" Tag="VoiceTranscribe" Text="语音转文字" Visibility="Collapsed">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C1;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="EditBubbleMenuItem_Click" Text="编辑消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertAboveBubbleMenuItem_Click" Text="在上方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="InsertBelowBubbleMenuItem_Click" Text="在下方插入消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <StackPanel Spacing="6">
                                                    <controls:WeChatMessageContentView
                                                        AudioUrl="{x:Bind AudioUrl, Mode=OneWay}"
                                                        IsOutgoing="True"
                                                        Text="{x:Bind Content, Mode=OneWay}"
                                                        VideoUrl="{x:Bind VideoUrl, Mode=OneWay}"
                                                        Visibility="{x:Bind ContentOrAudioVisibility, Mode=OneWay}" />
                                                    <Button
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="ChatBubbleImage_Click"
                                                        CornerRadius="8"
                                                        ToolTipService.ToolTip="点击查看大图"
                                                        Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}">
                                                        <Border
                                                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <Grid>
                                                                <Image
                                                                    MaxWidth="240"
                                                                    MaxHeight="240"
                                                                    Source="{x:Bind BubbleImage, Mode=OneWay}"
                                                                    Stretch="Uniform" />
                                                                <Grid Visibility="{x:Bind VideoPlayOverlayVisibility, Mode=OneWay}">
                                                                    <Border
                                                                        Margin="6"
                                                                        Padding="7,3"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Background="#A6000000"
                                                                        CornerRadius="5">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                            <FontIcon FontSize="11" Foreground="#FFFFFF" Glyph="&#xE714;" />
                                                                            <TextBlock FontSize="10.5" Foreground="#FFFFFF" Text="{x:Bind VideoDurationBadge, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Text="我" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Floating New Messages Pill (shown when sync appends messages while user scrolled up) -->
                <Button
                    x:Name="NewMessagesJumpButton"
                    Grid.Row="2"
                    Margin="0,0,18,14"
                    Padding="11,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="NewMessagesJumpButton_Click"
                    CornerRadius="14"
                    Style="{StaticResource PrimaryVioletButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon FontSize="11" Foreground="#FFFFFF" Glyph="&#xE74B;" />
                        <TextBlock x:Name="NewMessagesJumpText" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" Text="有新消息" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Draggable Horizontal Splitter -->
            <controls:HorizontalResizeSplitter
                x:Name="ComposerSplitter"
                Grid.Row="2"
                Background="{StaticResource AppChatCanvasBgBrush}"
                BorderThickness="0"
                ToolTipService.ToolTip="上下拖动可调整输入框高度">
                <Border Width="36" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource AppSplitterGripBrush}" CornerRadius="2" Opacity="0.7" />
            </controls:HorizontalResizeSplitter>

            <!-- Codex-Style Floating Rounded Group Chat Composer -->
            <Grid Grid.Row="3" Padding="16,4,16,14" Background="{StaticResource AppChatCanvasBgBrush}">
                <Border
                    Padding="13,10,12,9"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Pending Group Chat Image Attachment Preview Strip -->
                        <Border
                            x:Name="PendingChatImageBar"
                            Grid.Row="0"
                            Padding="7,5"
                            Background="{StaticResource AppCanvasBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PreviewPendingChatImage_Click"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="点击放大查看待发送图片">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Image x:Name="PendingChatImageThumb" Stretch="UniformToFill" />
                                    </Border>
                                </Button>
                                <TextBlock
                                    x:Name="PendingChatImageNameText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="已附加图片"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ClearPendingChatImage_Click"
                                    CornerRadius="12"
                                    ToolTipService.ToolTip="移除图片">
                                    <FontIcon FontSize="11" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Borderless Seamless Multi-line Input -->
                        <TextBox
                            x:Name="MessageInputBox"
                            Grid.Row="1"
                            Padding="3,2"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13.5"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            KeyDown="MessageInputBox_KeyDown"
                            Paste="MessageInputBox_Paste"
                            PlaceholderText="输入群聊内容...（Enter 发送，Shift+Enter 换行，可点下方上传图片）"
                            TextWrapping="Wrap">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Bottom Toolbar inside Rounded Card -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <!-- Direction Segmented Pill -->
                                <Border
                                    Padding="2"
                                    Background="{StaticResource AppCanvasBgBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button
                                            x:Name="DirOutgoingBtn"
                                            Height="24"
                                            Padding="10,0"
                                            BorderThickness="0"
                                            Click="DirToggleBtn_Click"
                                            CornerRadius="12"
                                            FontSize="11.5"
                                            Tag="outgoing"
                                            Content="我方" />
                                        <Button
                                            x:Name="DirIncomingBtn"
                                            Height="24"
                                            Padding="10,0"
                                            BorderThickness="0"
                                            Click="DirToggleBtn_Click"
                                            CornerRadius="12"
                                            FontSize="11.5"
                                            Tag="incoming"
                                            Content="群成员" />
                                    </StackPanel>
                                </Border>

                                <!-- Inline Sender Name Input (shown when 群成员 selected) -->
                                <TextBox
                                    x:Name="SenderNameBox"
                                    Width="88"
                                    Height="30"
                                    Padding="9,4"
                                    CornerRadius="15"
                                    FontSize="11.5"
                                    PlaceholderText="发言人"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    Visibility="Collapsed" />

                                <!-- Upload Chat Image Icon Button -->
                                <Button
                                    x:Name="UploadChatImageButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Click="UploadChatImageButton_Click"
                                    CornerRadius="15"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="上传图片消息（或聚焦输入框后 Ctrl+V 粘贴图片）">
                                    <FontIcon FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE91B;" />
                                </Button>
                            </StackPanel>

                            <TextBlock
                                x:Name="ComposerHintText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="6,0"
                                FontSize="11.5"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                x:Name="SendMessageButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="SendMessageButton_Click"
                                CornerRadius="16"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryVioletButtonStyle}"
                                ToolTipService.ToolTip="发送记录 (Enter)">
                                <FontIcon FontSize="13" Foreground="#FFFFFF" Glyph="&#xE74A;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Column 3: Right Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Tabbed Right Group Panel (群组资料 / AI 总结 / AI 对话) -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top 3-Tab Header Strip -->
                <Border Grid.Row="0" Padding="10,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="RightTabProfileBtn"
                            Grid.Column="0"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="profile">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabProfileIcon" FontSize="13" Glyph="&#xE716;" />
                                    <TextBlock x:Name="RightTabProfileText" FontSize="13" FontWeight="SemiBold" Text="群组资料" />
                                </StackPanel>
                                <Border x:Name="RightTabProfileLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabSummaryBtn"
                            Grid.Column="1"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="summary">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabSummaryIcon" FontSize="13" Glyph="&#xE734;" />
                                    <TextBlock x:Name="RightTabSummaryText" FontSize="13" Text="AI 总结" />
                                </StackPanel>
                                <Border x:Name="RightTabSummaryLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="RightTabChatBtn"
                            Grid.Column="2"
                            Height="55"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RightTab_Click"
                            CornerRadius="0"
                            Tag="aichat">
                            <Grid Height="55">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="RightTabChatIcon" FontSize="13" Glyph="&#xE8F2;" />
                                    <TextBlock x:Name="RightTabChatText" FontSize="13" Text="AI 对话" />
                                </StackPanel>
                                <Border x:Name="RightTabChatLine" Height="2.5" Margin="14,0" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="2" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty Selection -->
                <StackPanel x:Name="EmptyDetailHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Spacing="10">
                    <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource InfoBgBrush}" CornerRadius="12">
                        <FontIcon FontSize="20" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未选择群组" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="选择左侧群组查看群成员、AI 总结与 AI 对话，或点左上角「+」自动采集新群。" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- TAB 1: Group Profile & Members (Unified with Customer Profile card layout) -->
                <Grid x:Name="ProfileTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer x:Name="DetailContentScroll" Padding="16,14">
                        <StackPanel Spacing="14">
                            <!-- Top Avatar & Group Identity + Compact Icon Actions -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="56" Height="56" Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <TextBlock x:Name="DetailAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="群" />
                                        <Image x:Name="DetailAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="DetailHeaderNameText" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DetailHeaderCountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="成员人数：-" TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DetailHeaderKeyText" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="我在本群：-" TextTrimming="CharacterEllipsis" />
                                        <StackPanel x:Name="ViewActionsBar" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="5">
                                            <Button
                                                x:Name="AutoReplyToggleButton"
                                                Height="26"
                                                Padding="7,0"
                                                Click="AutoReplyToggleButton_Click"
                                                CornerRadius="6"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                ToolTipService.ToolTip="开启后，群内有人 @我 时自动生成 AI 回复并写入微信">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse x:Name="AutoReplyToggleDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                                                    <TextBlock x:Name="AutoReplyToggleText" FontSize="11" Text="AI回复" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="EditGroupButton"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Click="EditGroupButton_Click"
                                                CornerRadius="6"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryOutlineButtonStyle}"
                                                ToolTipService.ToolTip="编辑群组资料与备注">
                                                <FontIcon FontSize="11.5" Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                x:Name="DeleteGroupButton"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                Click="DeleteGroupButton_Click"
                                                CornerRadius="6"
                                                IsEnabled="False"
                                                Style="{StaticResource DangerOutlineButtonStyle}"
                                                ToolTipService.ToolTip="删除群组">
                                                <FontIcon FontSize="11.5" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="EditActionsBar" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                            <Button Height="26" Padding="9,0" Click="CancelEditButton_Click" Content="取消" CornerRadius="6" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                            <Button x:Name="SaveGroupButton" Height="26" Padding="10,0" Click="SaveGroupButton_Click" Content="保存" CornerRadius="6" FontSize="11.5" Style="{StaticResource PrimaryVioletButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        x:Name="DetailHeaderOwnerWeChatText"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                            <!-- VIEW MODE -->
                            <StackPanel x:Name="DetailViewModePanel" Spacing="12">
                                <!-- Structured Group Members Cards -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock x:Name="StructuredMembersHeaderText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="已建档群成员 (0)" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="点击成员查看档案" />
                                    </Grid>

                                    <Border
                                        x:Name="MembersTextFallbackCard"
                                        Padding="10"
                                        Background="{StaticResource AppCanvasBgBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock x:Name="ViewMembersText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" LineHeight="19" Text="暂无已建档成员，点击顶部「刷新同步」即可拉取群成员。" TextWrapping="Wrap" />
                                    </Border>

                                    <ListView
                                        x:Name="GroupMembersListView"
                                        MaxHeight="300"
                                        IsItemClickEnabled="True"
                                        ItemClick="GroupMembersListView_ItemClick"
                                        SelectionMode="None"
                                        Visibility="Collapsed">
                                        <ListView.ItemContainerTransitions>
                                            <TransitionCollection />
                                        </ListView.ItemContainerTransitions>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0,2" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:GroupMemberDto">
                                                <Border
                                                    Padding="7,6"
                                                    Background="{StaticResource AppSurfaceAltBrush}"
                                                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                    <Grid ColumnSpacing="9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            Background="{StaticResource BrandSoftBgBrush}"
                                                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <Grid>
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{StaticResource BrandPrimaryBrush}"
                                                                    Text="{x:Bind AvatarInitial}"
                                                                    Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                                <Image
                                                                    Source="{x:Bind AvatarImage, Mode=OneWay}"
                                                                    Stretch="UniformToFill"
                                                                    Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Dedicated Bottom Employee Notes Card -->
                                <Border Padding="13" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="7">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="员工群跟进备注" />
                                        <TextBlock
                                            x:Name="ViewGroupNoteText"
                                            FontSize="12.5"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            LineHeight="19"
                                            Text="暂无员工群备注，点击上方编辑图标即可补充群属性与跟进计划。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- EDIT MODE -->
                            <StackPanel x:Name="DetailEditModePanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="正在编辑群组信息与备注" />
                                <TextBox x:Name="EditGroupNameBox" Header="群组名称" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="EditMyNicknameBox" Header="我在本群的昵称（用于区分我方发言）" PlaceholderText="请输入我在本群的昵称" Style="{StaticResource SoftTextBoxStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EditGroupKeyBox" Grid.Column="0" Header="群标识" Style="{StaticResource SoftTextBoxStyle}" />
                                    <TextBox x:Name="EditMemberCountBox" Grid.Column="1" Header="成员人数" Style="{StaticResource SoftTextBoxStyle}" />
                                </Grid>
                                <TextBox x:Name="EditMembersTextBox" Header="群成员名单文本" Height="88" AcceptsReturn="True" Style="{StaticResource SoftTextBoxStyle}" TextWrapping="Wrap" />

                                <Border Margin="0,4,0,0" Padding="12" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="员工群跟进备注" />
                                        <TextBox
                                            x:Name="EditGroupNoteBox"
                                            MinHeight="88"
                                            AcceptsReturn="True"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                            CornerRadius="7"
                                            Padding="10,8"
                                            PlaceholderText="填写客户群特点、关键联系人、待办事项..."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: AI 群总结 -->
                <Grid x:Name="AiSummaryTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="群聊 AI 总结" />
                            <TextBlock x:Name="AiSummaryContextText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="0 位成员 · 0 条对话" />
                        </Grid>
                    </Border>

                    <StackPanel
                        x:Name="AiSummaryEmptyPanel"
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="14">
                            <FontIcon FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="暂无群聊总结" />
                        <Border
                            x:Name="AiSummaryErrorBanner"
                            Padding="10,7"
                            Background="{StaticResource DangerBgBrush}"
                            CornerRadius="7"
                            Visibility="Collapsed">
                            <TextBlock x:Name="AiSummaryErrorText" FontSize="11.5" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Button
                            x:Name="GenerateAiSummaryButton"
                            Height="34"
                            Padding="20,0"
                            HorizontalAlignment="Center"
                            Click="GenerateAiSummaryButton_Click"
                            Content="生成群总结"
                            FontSize="12.5"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AiSummaryLoadingPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <ProgressRing x:Name="AiSummarySpinner" Width="28" Height="28" IsActive="False" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="正在生成群聊总结..." />
                    </StackPanel>

                    <ScrollViewer x:Name="AiSummaryResultScroll" Grid.Row="1" Padding="14,12" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontSize="13" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="群聊概况与跟进总结" />
                                        </StackPanel>
                                        <TextBlock x:Name="AiSummaryTimeText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="" />
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BrandSoftBorderBrush}" Opacity="0.65" />
                                    <controls:MarkdownTextView x:Name="AiSummaryMarkdownView" BaseFontSize="12.5" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AiSummaryNoticeText" FontSize="11.5" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        x:Name="AiSummaryFooterBar"
                        Grid.Row="2"
                        Padding="14,10"
                        Background="{StaticResource AppSurfaceAltBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="CopyAiSummaryButton_Click"
                                Content="复制总结"
                                FontSize="12.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="GenerateAiSummaryButton_Click"
                                Content="重新总结"
                                FontSize="12.5"
                                Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 3: AI 群对话 (Scoped per group) -->
                <Grid x:Name="AiChatTabContainer" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,9" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <TextBlock x:Name="AiChatContextTitle" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="AI 群对话" TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ClearAiChatButton"
                                Height="26"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ClearAiChatButton_Click"
                                Content="清空"
                                FontSize="11.5"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel
                            x:Name="AiChatEmptyPanel"
                            Padding="18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <Border Width="42" Height="42" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="12">
                                <FontIcon FontSize="18" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8F2;" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="快捷提问" />

                            <StackPanel Margin="0,2,0,0" Spacing="6">
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="总结最近群里大家主要讨论了哪些事项" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="梳理群内关键成员及各自关注点" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                <Button Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AiQuickPrompt_Click" Content="帮我起草一条得体的群回复或通知" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <ListView x:Name="AiChatListView" Padding="12,10" SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,5" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:AiChatMessageItem">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Right" MaxWidth="270" Spacing="3" Visibility="{x:Bind UserVisibility}">
                                            <Border Padding="10,8" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="10,4,10,10">
                                                <StackPanel Spacing="6">
                                                    <ItemsControl ItemsSource="{x:Bind Images}" Visibility="{x:Bind UserImagesVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Width="62" Height="62" CornerRadius="6">
                                                                    <controls:DataUriImage DataUri="{x:Bind}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock FontSize="12.5" Foreground="#FFFFFF" IsTextSelectionEnabled="True" Text="{x:Bind Content}" TextWrapping="Wrap" Visibility="{x:Bind UserTextVisibility}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Timestamp}" />
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Left" MaxWidth="304" Spacing="3" Visibility="{x:Bind AssistantVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontSize="11" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE734;" />
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="AI 助手" />
                                            </StackPanel>

                                            <!-- Codex-Style Tool Execution Trace -->
                                            <controls:CodexToolTraceView
                                                HorizontalAlignment="Stretch"
                                                TraceItems="{x:Bind ToolTrace}"
                                                Visibility="{x:Bind ToolTraceVisibility}" />

                                            <Border
                                                Padding="10,8"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,10,10,10"
                                                Visibility="{x:Bind PendingVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsPending}" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Content}" />
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                Padding="10,9"
                                                Background="{StaticResource AppSurfaceAltBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4,10,10,10"
                                                Visibility="{x:Bind AssistantContentVisibility}">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyAiChatMessageMenuItem_Click" Text="复制回复">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <controls:MarkdownTextView BaseFontSize="12.5" Text="{x:Bind Content}" />
                                            </Border>

                                            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind Timestamp}" Visibility="{x:Bind TimestampVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Codex-Style Compact Rounded AI Chat Input Card -->
                    <Grid Grid.Row="2" Padding="10,6,10,10">
                        <Border
                            Padding="10,8,9,8"
                            Background="{StaticResource AppCanvasBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer
                                    x:Name="AiChatPendingImagesScroll"
                                    Grid.Row="0"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled"
                                    Visibility="Collapsed">
                                    <ItemsControl x:Name="AiChatPendingImagesItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:AiImageAttachment">
                                                <Grid Width="48" Height="48">
                                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="7">
                                                        <Image Source="{x:Bind Preview}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <Button
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,2,2,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#CC1E2430"
                                                        BorderThickness="0"
                                                        Click="RemoveGroupAiImage_Click"
                                                        CornerRadius="8"
                                                        Tag="{x:Bind Id}">
                                                        <FontIcon FontSize="8" Foreground="#FFFFFF" Glyph="&#xE8BB;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBox
                                    x:Name="AiChatInputBox"
                                    Grid.Row="1"
                                    MinHeight="34"
                                    MaxHeight="96"
                                    Padding="2,2"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    KeyDown="AiChatInputBox_KeyDown"
                                    Paste="AiChatInputBox_Paste"
                                    PlaceholderText="围绕本群提问，支持粘贴或上传图片..."
                                    TextWrapping="Wrap">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>

                                <Grid Grid.Row="2">
                                    <Button
                                        x:Name="AiChatAttachButton"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        ToolTipService.ToolTip="添加图片">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                                <MenuFlyoutItem Click="UploadGroupAiImage_Click" Text="上传本地图片">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Click="PasteGroupAiImage_Click" Text="粘贴剪贴板图片">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE710;" />
                                    </Button>

                                    <Button
                                        x:Name="AiChatSendButton"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="AiChatSendButton_Click"
                                        CornerRadius="14"
                                        Style="{StaticResource PrimaryVioletButtonStyle}"
                                        ToolTipService.ToolTip="发送 (Enter)">
                                        <Grid>
                                            <FontIcon x:Name="AiChatSendIcon" FontSize="12" Foreground="#FFFFFF" Glyph="&#xE74A;" />
                                            <ProgressRing x:Name="AiChatSendBusyRing" Width="14" Height="14" Foreground="#FFFFFF" IsActive="False" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

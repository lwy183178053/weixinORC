<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="268" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="450" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="356" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: WeChat-style Group List Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + Top-Left "+" Popup Group Import Button -->
                <Border
                    Grid.Row="0"
                    Padding="12,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Height="34"
                            Padding="10,6"
                            FontSize="12.5"
                            PlaceholderText="搜索群名称、成员或备注..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Click="AddGroupButton_Click"
                            CornerRadius="7"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="新建群组 / 截图识别导入">
                            <FontIcon FontSize="14" Foreground="#FFFFFF" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Groups List -->
                <Grid Grid.Row="1">
                    <StackPanel
                        x:Name="EmptyListHint"
                        Margin="20,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无群组档案" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击上方「+」弹窗截图识别建群，或截图复制后直接按 Ctrl+V。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Center"
                            Height="32"
                            Click="AddGroupButton_Click"
                            Content="+ 新建 / 截图导入"
                            FontSize="12"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>

                    <ListView
                        x:Name="GroupsListView"
                        Padding="6,6"
                        SelectionChanged="GroupsListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupDto">
                                <Grid Padding="6,9" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Background="{StaticResource InfoBgBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource InfoTextBrush}"
                                            Text="{x:Bind AvatarInitial}" />
                                    </Border>

                                    <Grid Grid.Column="1" RowSpacing="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayTitleWithCount}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeShort}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource TextMutedBrush}" MaxLines="1" Text="{x:Bind PreviewLine}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- Column 1: Left Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: WeChat-style Group IM Chat Stage -->
        <Grid x:Name="ChatStageGrid" Grid.Column="2" Background="{StaticResource AppChatCanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="ComposerRow" Height="172" MinHeight="128" MaxHeight="440" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ActiveGroupTitle" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="请选择左侧群组" />
                        <TextBlock x:Name="ActiveGroupMeta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="点左上角「+」可弹出截图识别建群窗口" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MultiSelectMessagesButton" Height="30" Padding="10,0" Click="MultiSelectMessagesButton_Click" Content="多选" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button Height="30" Padding="10,0" Click="RefreshButton_Click" Content="刷新" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Group Chat Bubbles -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Multi-Select Action Bar -->
                <Border
                    x:Name="MessageMultiSelectBar"
                    Grid.Row="0"
                    Padding="14,8"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <TextBlock x:Name="SelectedMessagesCountText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="已选 0 条消息" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SelectAllMessagesButton" Height="26" Padding="10,0" Click="SelectAllMessagesButton_Click" Content="全选" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="DeleteSelectedMessagesButton" Height="26" Padding="10,0" Click="DeleteSelectedMessagesButton_Click" Content="删除所选" FontSize="11.5" IsEnabled="False" Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button Height="26" Padding="10,0" Click="ExitMultiSelectButton_Click" Content="完成" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyChatHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <FontIcon FontSize="22" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock x:Name="EmptyChatTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无群聊记录" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="可在下方记录群成员发言或我方回复，支持截图快速提取文字" />
                </StackPanel>

                <ListView x:Name="MessagesListView" Grid.Row="1" Padding="18,14" IsItemClickEnabled="True" ItemClick="MessagesListView_ItemClick" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubbleItem">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,4,10,0"
                                    VerticalAlignment="Top"
                                    Click="BubbleCheckBox_Click"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    Visibility="{x:Bind SelectionCheckVisibility, Mode=OneWay}" />

                                <Grid Grid.Column="1">
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind IncomingVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="{x:Bind SenderInitial}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="460" Spacing="3">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SenderName}" Visibility="{x:Bind SenderNameVisibility}" />
                                            <Border Padding="12,9" Background="{StaticResource ChatIncomingBgBrush}" BorderBrush="{StaticResource ChatIncomingBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <TextBlock FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="10" Visibility="{x:Bind OutgoingVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="460" Spacing="3">
                                            <Border Padding="12,9" Background="{StaticResource ChatOutgoingBgBrush}" CornerRadius="10,4,10,10">
                                                <Border.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="CopyBubbleMenuItem_Click" Text="复制内容">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="MultiSelectFromBubbleMenuItem_Click" Text="多选消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="DeleteBubbleMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="删除消息">
                                                            <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Border.ContextFlyout>
                                                <TextBlock FontSize="13.5" Foreground="{StaticResource ChatOutgoingTextBrush}" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Text="我" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Draggable Horizontal Splitter -->
            <controls:HorizontalResizeSplitter
                x:Name="ComposerSplitter"
                Grid.Row="2"
                Background="{StaticResource AppChatCanvasBgBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                ToolTipService.ToolTip="上下拖动可调整输入框高度">
                <Border Width="40" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource AppSplitterGripBrush}" CornerRadius="2" />
            </controls:HorizontalResizeSplitter>

            <!-- Bottom Group Composer -->
            <Border Grid.Row="3" Padding="14,10,14,12" Background="{StaticResource AppSurfaceBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <RadioButton x:Name="DirOutgoingRadio" Content="我方发出" GroupName="GroupMsgDir" IsChecked="True" />
                            <RadioButton x:Name="DirIncomingRadio" Content="群成员" GroupName="GroupMsgDir" />
                            <TextBox x:Name="SenderNameBox" Width="88" Height="28" Padding="8,4" FontSize="12" PlaceholderText="发言人" Style="{StaticResource SoftTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ImportChatScreenshotButton" Height="28" Padding="9,0" Click="ImportChatScreenshotButton_Click" Content="截图导入对话" FontSize="11.5" IsEnabled="False" Style="{StaticResource PrimaryVioletButtonStyle}" />
                            <Button Height="28" Padding="9,0" Click="OcrChatClipboardButton_Click" Content="粘贴提取单条" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="MessageInputBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Background="{StaticResource AppInputBgBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,7"
                        PlaceholderText="输入群消息内容，或粘贴群聊截图自动提取文字..."
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ComposerHintText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="内容将保存至当前群组沟通记录" />
                        <Button
                            x:Name="SendMessageButton"
                            HorizontalAlignment="Right"
                            Height="30"
                            Padding="18,0"
                            Click="SendMessageButton_Click"
                            Content="发送记录"
                            FontSize="12.5"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Column 3: Right Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Dedicated Right Group Profile Panel (View / Edit / Save / Employee Notes / Delete) -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="群组信息" />

                        <StackPanel x:Name="ViewActionsBar" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditGroupButton" Height="30" Padding="12,0" Click="EditGroupButton_Click" Content="编辑" FontSize="12" IsEnabled="False" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="DeleteGroupButton" Height="30" Padding="12,0" Click="DeleteGroupButton_Click" Content="删除" FontSize="12" IsEnabled="False" Style="{StaticResource DangerOutlineButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="EditActionsBar" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button Height="30" Padding="12,0" Click="CancelEditButton_Click" Content="取消" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button x:Name="SaveGroupButton" Height="30" Padding="14,0" Click="SaveGroupButton_Click" Content="保存" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty Selection -->
                <StackPanel x:Name="EmptyDetailHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Spacing="10">
                    <Border Width="48" Height="48" HorizontalAlignment="Center" Background="{StaticResource InfoBgBrush}" CornerRadius="12">
                        <FontIcon FontSize="20" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE716;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未选择群组" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="选择左侧群组查看群成员与员工备注，或点左上角「+」截图导入新群。" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Group Detail Content -->
                <ScrollViewer x:Name="DetailContentScroll" Grid.Row="1" Padding="16,14" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <Border x:Name="DetailStatusBanner" Padding="10,7" Background="{StaticResource SuccessBgBrush}" CornerRadius="7" Visibility="Collapsed">
                            <TextBlock x:Name="DetailStatusText" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Top Identity -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <TextBlock x:Name="DetailAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="群" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DetailHeaderNameText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="-" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailHeaderCountText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="成员人数：-" />
                                <TextBlock x:Name="DetailHeaderKeyText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="群标识：-" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                        <!-- VIEW MODE -->
                        <StackPanel x:Name="DetailViewModePanel" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="已采集群成员" />
                                <Border Padding="12" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <TextBlock x:Name="ViewMembersText" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" LineHeight="20" Text="-" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Dedicated Bottom Employee Notes Card -->
                            <Border Padding="14" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="员工群跟进备注" />
                                        <Border HorizontalAlignment="Right" Padding="7,2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="8">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrandPrimaryBrush}" Text="员工专属" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        x:Name="ViewGroupNoteText"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        LineHeight="20"
                                        Text="暂无员工群备注，点击「编辑」即可补充群属性与跟进计划。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- EDIT MODE -->
                        <StackPanel x:Name="DetailEditModePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="正在编辑群组信息与备注" />
                            <TextBox x:Name="EditGroupNameBox" Header="群组名称" Style="{StaticResource SoftTextBoxStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="105" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditGroupKeyBox" Grid.Column="0" Header="群标识" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="EditMemberCountBox" Grid.Column="1" Header="成员人数" Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>
                            <TextBox x:Name="EditMembersTextBox" Header="群成员列表" Height="100" AcceptsReturn="True" Style="{StaticResource SoftTextBoxStyle}" TextWrapping="Wrap" />

                            <Border Margin="0,4,0,0" Padding="12" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="员工群跟进备注" />
                                    <TextBox
                                        x:Name="EditGroupNoteBox"
                                        MinHeight="92"
                                        AcceptsReturn="True"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                        CornerRadius="7"
                                        Padding="10,8"
                                        PlaceholderText="填写客户群特点、关键联系人、待办事项..."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Module Navigation Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceAltBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="18,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="使用介绍" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="按功能模块查阅最新操作说明" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="10,12">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="10,0,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="功能模块" />

                        <Button x:Name="NavQuickStartBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="quickstart">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavQuickStartIcon" FontSize="14" Glyph="&#xE945;" />
                                <TextBlock x:Name="NavQuickStartText" FontSize="13" Text="快速上手" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavOcrBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="ocr">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavOcrIcon" FontSize="14" Glyph="&#xE895;" />
                                <TextBlock x:Name="NavOcrText" FontSize="13" Text="微信自动监听" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavCustomersBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="customers">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavCustomersIcon" FontSize="14" Glyph="&#xE77B;" />
                                <TextBlock x:Name="NavCustomersText" FontSize="13" Text="客户档案与标签" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavGroupsBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="groups">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavGroupsIcon" FontSize="14" Glyph="&#xE716;" />
                                <TextBlock x:Name="NavGroupsText" FontSize="13" Text="群组档案与群聊" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavChatBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="chat">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavChatIcon" FontSize="14" Glyph="&#xE99A;" />
                                <TextBlock x:Name="NavChatText" FontSize="13" Text="AI 助手与聊天查阅" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettingsBtn" Height="38" Padding="11,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GuideNav_Click" CornerRadius="8" Tag="settings">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <FontIcon x:Name="NavSettingsIcon" FontSize="14" Glyph="&#xE713;" />
                                <TextBlock x:Name="NavSettingsText" FontSize="13" Text="外观、快捷键与设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Module Detail Stage -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="26,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                        <FontIcon x:Name="ActiveSectionIcon" FontSize="14.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE945;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="ActiveSectionTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="快速上手" />
                        <TextBlock x:Name="ActiveSectionSubtitle" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="三步开启微信自动监听与 AI 客户工作台" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="GuideContentScroll" Grid.Row="1" Padding="28,22">
                <Grid MaxWidth="860" HorizontalAlignment="Left">

                    <!-- 1. QUICK START -->
                    <StackPanel x:Name="PanelQuickStart" Spacing="14">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="三步快速上手" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Padding="14" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="22" Height="22" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="11">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" Text="1" />
                                                </Border>
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="添加微信客户与群聊" />
                                            </StackPanel>
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" Text="登录电脑微信后，在「客户档案」或「群组档案」点左上角「+」，按标签挑选好友或勾选需要管理的群聊导入。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Padding="14" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="22" Height="22" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="11">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" Text="2" />
                                                </Border>
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="自动监听新消息" />
                                            </StackPanel>
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" Text="系统默认自动监听电脑微信消息变化，仅同步您已导入的客户和群聊，收到新消息自动更新且自动去重。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Padding="14" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="22" Height="22" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="11">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" Text="3" />
                                                </Border>
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="AI 助手自动查阅记录" />
                                            </StackPanel>
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" Text="AI 助手可直接搜索全部客户与群聊记录、按标签复盘沟通进展、排查待回复客户并起草回复话术。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="18" Background="{StaticResource BrandCardTintBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrandHighlightTextBrush}" Text="工作台三栏布局说明" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 左栏：按微信标签分组展示客户列表，或在群组页展示群头像列表，支持即时搜索与批量勾选删除。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 中栏：微信风格会话记录区，完整展示文本、表情、图片（点击查看大图）、语音时长、文件、引用与转账。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 右栏：客户/群组资料与 AI 辅助区，可在「基本资料」「AI 总结」「AI 对话」之间快速切换。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. WECHAT AUTO MONITOR -->
                    <StackPanel x:Name="PanelOcr" Spacing="14" Visibility="Collapsed">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="自动监听微信消息变化（全自动免操心）" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 仅在本地只读获取微信聊天记录，不影响电脑微信正常使用，也不修改微信自身数据。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 系统会自动检测微信消息变化，并在数秒内把您已导入的客户和群聊的最新对话同步到工作台，无需手工反复同步。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 首次连接若提示权限不足，点击提示中的「以管理员身份重启」即可恢复正常。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. CUSTOMERS -->
                    <StackPanel x:Name="PanelCustomers" Spacing="14" Visibility="Collapsed">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="按微信标签导入与管理客户" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 点击左上角「+」打开添加客户弹窗，可按微信标签分类浏览所有好友，自由勾选单个好友或一键导入整个标签下的好友。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 左侧列表按微信标签自动分组，支持折叠/展开、多选批量删除以及按备注、昵称、微信号或标签检索。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 右栏编辑保存的员工跟进备注与跟进状态受到保护，不会被后续同步覆盖。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. GROUPS -->
                    <StackPanel x:Name="PanelGroups" Spacing="14" Visibility="Collapsed">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="挑选导入群聊、展示群头像与自动更新" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 点击左上角「+」打开添加群聊弹窗，自由勾选需要管理的微信群，自动导入群头像、群成员与历史群聊记录。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 导入后自动巡检群内新消息并同步，左侧群列表支持多选全选批量删除，与客户档案保持一致操作体验。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. AI ASSISTANT -->
                    <StackPanel x:Name="PanelChat" Spacing="14" Visibility="Collapsed">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="智能查阅全部聊天记录，辅助跟进与回复" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 全文搜索聊天记录：直接问“最近谁问过报价/某项目”，AI 自动跨所有私聊与群聊检索定位。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 排查待回复客户：一键梳理近期活跃的客户与群聊，筛选出对方刚发消息尚未回复的会话。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 按标签复盘跟进：直接问“帮我总结 VIP 标签客户最近的沟通进展”，自动汇总该标签下客户聊天情况。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 支持结合企业知识库内容，直接生成得体的客户回复话术与群通知。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 6. APPEARANCE, SHORTCUTS & SETTINGS -->
                    <StackPanel x:Name="PanelSettings" Spacing="14" Visibility="Collapsed">
                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="外观模式、服务配置与运行状态" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 左下角一键切换明亮/黑夜模式，在「设置 → 通用」提供 5 套柔和浅色配色并自动记住。" TextWrapping="Wrap" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21" Text="• 在「设置 → 服务」可配置服务地址并测试连接状态，也可在运行日志中一键检测本机微信连接情况。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Padding="18" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="常用操作" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Padding="8,3" Background="{StaticResource AppInputBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="右键气泡" />
                                    </Border>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="在聊天气泡上打开快捷菜单，支持编辑、插入、复制、多选或单条删除" TextWrapping="Wrap" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Padding="8,3" Background="{StaticResource AppInputBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="点击聊天图片" />
                                    </Border>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Text="打开高清大图预览窗口，支持滚轮缩放与拖拽查看" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

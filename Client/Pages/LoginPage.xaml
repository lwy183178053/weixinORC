<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F2F3FB" />
                <GradientStop Offset="0.55" Color="#ECE9FC" />
                <GradientStop Offset="1" Color="#F7F8FC" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Invisible drag bar at top -->
        <Grid x:Name="LoginTitleDragBar" Grid.Row="0" Background="Transparent" />

        <!-- Centered Floating Split Login Card -->
        <Border
            Grid.Row="1"
            Width="900"
            Height="540"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,-18,0,0"
            Background="#FFFFFF"
            BorderBrush="#E2E5F2"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Brand Showcase Panel -->
                <Border Grid.Column="0" CornerRadius="16,0,0,16" Padding="34,36">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#5046E5" />
                            <GradientStop Offset="0.55" Color="#7C5CFC" />
                            <GradientStop Offset="1" Color="#9E7BFF" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Logo & Title -->
                        <StackPanel Grid.Row="0" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border
                                    Width="42"
                                    Height="42"
                                    Background="#2BFFFFFF"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#FFFFFF"
                                        Text="智" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="#FFFFFF"
                                        Text="智美员工 Bot" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#D8D2FF"
                                        Text="WECHAT AI WORKBENCH" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                LineHeight="34"
                                Text="微信客户管理与&#x0a;受控 OCR 智能工作台"
                                TextWrapping="Wrap" />

                            <TextBlock
                                FontSize="13"
                                Foreground="#E6E1FF"
                                LineHeight="20"
                                Text="为企业员工提供安全隔离的客户档案管理、微信窗口识别、人工核验与 AI 回复辅助。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Feature Highlights -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="0,12,0,0">
                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Text="员工身份隔离" />
                                    <TextBlock FontSize="11.5" Foreground="#E0DBFF" Text="仅访问本人负责的客户、群组与聊天记录" />
                                </StackPanel>
                            </Border>

                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Text="双引擎离线 OCR 定位" />
                                    <TextBlock FontSize="11.5" Foreground="#E0DBFF" Text="支持窗口受控截图、坐标框选与状态巡检" />
                                </StackPanel>
                            </Border>

                            <Border Background="#20FFFFFF" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Text="人工核验安全闭环" />
                                    <TextBlock FontSize="11.5" Foreground="#E0DBFF" Text="关键微信号确认后再绑定，掉线自动熔断" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer Tag -->
                        <TextBlock
                            Grid.Row="2"
                            FontSize="11.5"
                            Foreground="#CFC7FF"
                            Text="V1.0 原型 · WinUI 3 + Go 后端服务" />
                    </Grid>
                </Border>

                <!-- Right Login Form Panel -->
                <Grid Grid.Column="1" Padding="42,36,42,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header + Live Backend Status Pill -->
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="欢迎登录" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="请使用公司分配的员工账号登录工作台" />
                        </StackPanel>

                        <Button
                            x:Name="BackendStatusButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="10,5"
                            Background="{StaticResource AppInputBgBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            Click="BackendStatusButton_Click"
                            CornerRadius="14">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="#D97706" />
                                <TextBlock
                                    x:Name="HealthBadgeText"
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="检测服务中..." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Input Fields -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
                        <!-- Error Banner -->
                        <Border
                            x:Name="ErrorBanner"
                            Padding="12,9"
                            Background="{StaticResource DangerBgBrush}"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ErrorMessageText"
                                FontSize="12.5"
                                Foreground="{StaticResource DangerTextBrush}"
                                TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="员工账号" />
                            <TextBox
                                x:Name="AccountBox"
                                Height="40"
                                KeyDown="Input_KeyDown"
                                PlaceholderText="请输入员工账号（测试账号：demo）"
                                Style="{StaticResource SoftTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="登录密码" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Height="40"
                                KeyDown="Input_KeyDown"
                                PlaceholderText="请输入登录密码"
                                Style="{StaticResource SoftPasswordBoxStyle}" />
                        </StackPanel>

                        <!-- Collapsible Server URL Config -->
                        <StackPanel Spacing="6">
                            <Grid>
                                <Button
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ToggleServerConfigButton_Click"
                                    Foreground="{StaticResource BrandPrimaryBrush}">
                                    <TextBlock x:Name="ServerConfigToggleText" FontSize="12" Text="▸ 后端服务地址配置 (127.0.0.1:8080)" />
                                </Button>

                                <Button
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="FillDemoButton_Click"
                                    Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock FontSize="12" Text="填入本地测试账号" />
                                </Button>
                            </Grid>

                            <Grid x:Name="ServerConfigPanel" ColumnSpacing="8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ServerUrlBox"
                                    Height="36"
                                    PlaceholderText="http://127.0.0.1:8080"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    Text="http://127.0.0.1:8080" />
                                <Button
                                    Grid.Column="1"
                                    Height="36"
                                    Click="BackendStatusButton_Click"
                                    Content="测连通"
                                    Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            </Grid>
                        </StackPanel>

                        <!-- Primary Violet Submit CTA -->
                        <Button
                            x:Name="LoginButton"
                            Height="44"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            Click="LoginButton_Click"
                            CornerRadius="8"
                            Style="{StaticResource PrimaryVioletButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="LoginSpinner"
                                    Width="16"
                                    Height="16"
                                    Foreground="#FFFFFF"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="LoginButtonText" FontSize="14.5" FontWeight="SemiBold" Text="立即登录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer Hint -->
                    <Border
                        Grid.Row="2"
                        Padding="12,8"
                        Background="{StaticResource AppCanvasBgBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="不开放员工自行注册，登录凭证由甲方“智美员工Bot”接口统一校验。本地联调默认模拟账号：demo / demo123"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

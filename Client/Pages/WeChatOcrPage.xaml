<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WeChatOcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="268" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="450" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="368" MinWidth="290" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: WeChat Window Monitor Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="14,14,14,8">
                    <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="微信窗口监控" />
                    <Border HorizontalAlignment="Right" Padding="7,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="10">
                        <TextBlock x:Name="WindowCountPill" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Padding="14,4,14,10" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="WindowSearchBox"
                            Height="34"
                            Padding="10,6"
                            FontSize="12.5"
                            PlaceholderText="筛选窗口标题或进程..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="WindowSearchBox_TextChanged" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Click="RefreshWindowsButton_Click"
                            CornerRadius="7"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="刷新窗口列表">
                            <FontIcon FontSize="14" Foreground="#FFFFFF" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <CheckBox
                        x:Name="ShowAllWindowsCheck"
                        MinHeight="24"
                        Checked="ShowAllWindowsCheck_Changed"
                        Unchecked="ShowAllWindowsCheck_Changed">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="包含全部桌面窗口（无微信时调试）" />
                    </CheckBox>
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBlock
                        x:Name="EmptyWindowListHint"
                        Margin="20,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="未检测到运行中的微信/企业微信，可勾选上方“包含全部桌面窗口”或直接粘贴/导入截图。"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <ListView
                        x:Name="WindowsListView"
                        Padding="8,0,8,8"
                        SelectionChanged="WindowsListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:WeChatWindowInfo">
                                <Border Padding="6,8" CornerRadius="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Margin="0,2,0,0"
                                            Padding="5,2"
                                            Background="{StaticResource BrandSoftBgBrush}"
                                            CornerRadius="4">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind ShortTag}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SummaryLine}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border
                    Grid.Row="3"
                    Padding="12"
                    Background="{StaticResource AppCanvasBgBrush}"
                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ShowWindowButton"
                            Grid.Column="0"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="ShowWindowButton_Click"
                            Content="显示窗口"
                            FontSize="12.5"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button
                            x:Name="HideWindowButton"
                            Grid.Column="1"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="HideWindowButton_Click"
                            Content="隐藏暂停"
                            FontSize="12.5"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Column 1: Left Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: Action Bar & RapidOCR Preview Stage -->
        <Grid Grid.Column="2" Background="{StaticResource AppSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="16,12"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="8,5" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="6">
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="窗口识别" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        x:Name="PreviewMetaText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="选择左侧窗口截图，或粘贴剪贴板截图 / 导入本地图片"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="CaptureAndOcrButton"
                            Height="34"
                            Click="CaptureAndOcrButton_Click"
                            Content="截取窗口识别"
                            FontSize="12.5"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                        <Button
                            x:Name="PasteClipboardButton"
                            Height="34"
                            Click="PasteClipboardButton_Click"
                            Content="粘贴截图"
                            FontSize="12.5"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        <Button
                            x:Name="LoadImageButton"
                            Height="34"
                            Click="LoadImageButton_Click"
                            Content="导入图片"
                            FontSize="12.5"
                            Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="StatusBanner"
                Grid.Row="1"
                Margin="16,12,16,0"
                Padding="12,8"
                Background="{StaticResource BrandSoftBgBrush}"
                BorderBrush="{StaticResource BrandSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="StatusBannerText" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Right" Padding="6,2" Background="Transparent" BorderThickness="0" Click="CloseBannerButton_Click" Content="✕" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Padding="16">
                <Border Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="14,8"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0">
                            <Grid>
                                <TextBlock x:Name="EngineNoteText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <CheckBox
                                    x:Name="ShowOverlayCheck"
                                    HorizontalAlignment="Right"
                                    MinHeight="24"
                                    IsChecked="True"
                                    Checked="ShowOverlayCheck_Changed"
                                    Unchecked="ShowOverlayCheck_Changed">
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="显示识别区域框" />
                                </CheckBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Padding="14">
                            <StackPanel x:Name="EmptyPreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="56" Height="56" HorizontalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="14">
                                    <FontIcon FontSize="24" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8FE;" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="窗口识别已就绪" />
                                <TextBlock MaxWidth="360" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="选中左侧微信窗口点击“截取窗口识别”，或点“粘贴截图” / “导入图片”快速识别客户资料。" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" Visibility="Collapsed">
                                <Grid x:Name="PreviewSurface">
                                    <Image x:Name="PreviewImage" Stretch="Fill" />
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Column 3: Right Vertical Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Inspector Panel -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,10,16,0" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <Button Padding="0,0,0,10" Background="Transparent" BorderThickness="0" Click="InspectorTab_Click" Tag="verify">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TabVerifyText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="状态与人工核验" />
                                <Border x:Name="TabVerifyUnderline" Height="2" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="1" />
                            </StackPanel>
                        </Button>
                        <Button Padding="0,0,0,10" Background="Transparent" BorderThickness="0" Click="InspectorTab_Click" Tag="lines">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TabLinesText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="识别文本 (0)" />
                                <Border x:Name="TabLinesUnderline" Height="2" Background="Transparent" CornerRadius="1" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="VerifyPanel" Grid.Row="1" Padding="16">
                    <StackPanel Spacing="12">
                        <Border Padding="12" Background="{StaticResource AppCanvasBgBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="界面状态判定" />
                                    <Border x:Name="StatePillBorder" HorizontalAlignment="Right" Padding="8,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="10">
                                        <TextBlock x:Name="InferredStateText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="待识别" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="InferredReasonText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="执行一次识别后自动判定微信状态。" TextWrapping="Wrap" />
                                <TextBlock x:Name="OcrTimingText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="耗时: - · 文本行: 0" />
                            </StackPanel>
                        </Border>

                        <Border Padding="14" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="9">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="客户资料人工核验与入库" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CandidateRemarkBox" Grid.Column="0" Header="微信备注" PlaceholderText="微信备注名" Style="{StaticResource SoftTextBoxStyle}" />
                                    <TextBox x:Name="CandidateNameBox" Grid.Column="1" Header="微信昵称" PlaceholderText="自动提取或手填" Style="{StaticResource SoftTextBoxStyle}" />
                                </Grid>
                                <TextBox x:Name="CandidateAccountBox" Header="微信号" PlaceholderText="核验后绑定" Style="{StaticResource SoftTextBoxStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CandidateRegionBox" Grid.Column="0" Header="地区" PlaceholderText="如 江苏 常州" Style="{StaticResource SoftTextBoxStyle}" />
                                    <TextBox x:Name="CandidatePhoneBox" Grid.Column="1" Header="电话" PlaceholderText="手机号" Style="{StaticResource SoftTextBoxStyle}" />
                                </Grid>
                                <TextBox x:Name="CandidateSignatureBox" Header="个性签名" PlaceholderText="自动提取" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="CandidateSourceBox" Header="来源" PlaceholderText="如 通过搜索手机号添加" Style="{StaticResource SoftTextBoxStyle}" />
                                <TextBox x:Name="CandidateNoteBox" Header="员工备注" PlaceholderText="补充跟进备注" Style="{StaticResource SoftTextBoxStyle}" />
                                <Button
                                    x:Name="SaveCustomerButton"
                                    Height="38"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="SaveCustomerButton_Click"
                                    Content="人工确认并保存到客户档案"
                                    Style="{StaticResource PrimaryVioletButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LinesPanel" Grid.Row="1" Padding="14" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="OcrStatsText" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="共 0 行识别结果" />
                        <Button HorizontalAlignment="Right" Height="30" Padding="10,0" Click="CopyAllTextButton_Click" Content="复制全文" FontSize="12" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="OcrLinesListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OcrLineResult">
                                    <Border Padding="4,8" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind Text}" TextWrapping="Wrap" />
                                            <Border HorizontalAlignment="Left" Padding="6,1" Background="{StaticResource AppInputBgBrush}" CornerRadius="4">
                                                <TextBlock FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind BoundsLabel}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

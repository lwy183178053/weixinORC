<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WeChatSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Unified Dual-Monitor Header -->
        <Border
            Grid.Row="0"
            Padding="24,14"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextMutedBrush}" />
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="双端实时监听" />
                            <Border Padding="8,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="9">
                                <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="检测中" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="并列监控个人微信与企业微信运行状态、登录账号及消息变化，无 Hook 纯只读同步" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="RelaunchAdminButton"
                        Height="32"
                        Padding="12,0"
                        Click="RelaunchAdminButton_Click"
                        Content="以管理员身份重启"
                        FontSize="12"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="SyncBothButton"
                        Height="32"
                        Padding="14,0"
                        Click="SyncBothButton_Click"
                        FontSize="12"
                        Style="{StaticResource PrimaryVioletButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontSize="12.5" Foreground="#FFFFFF" Glyph="&#xE895;" />
                            <TextBlock Text="刷新同步双端" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Main Content -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid Padding="24,18">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="14">

                    <!-- Row 1: Side-by-Side Equal Weight Cards (Personal WeChat | Enterprise WeCom) -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT CARD: Personal WeChat 4.x -->
                        <Border
                            Grid.Column="0"
                            Padding="18,16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="12">
                                <!-- Card Header -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Background="{StaticResource SuccessBgBrush}" CornerRadius="7">
                                            <FontIcon FontSize="13.5" Foreground="{StaticResource SuccessTextBrush}" Glyph="&#xE8BD;" />
                                        </Border>
                                        <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="个人微信" />
                                        <Border
                                            x:Name="CurrentAccountStatusBadge"
                                            Padding="7,2"
                                            Background="{StaticResource AppInputBgBrush}"
                                            CornerRadius="9">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Ellipse x:Name="CurrentAccountStatusDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="CurrentAccountStatusText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="检测中" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="AutoWatchToggle"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        OffContent="暂停"
                                        OnContent="监听中"
                                        Toggled="AutoWatchToggle_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <!-- Identity Block -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="46"
                                        Height="46"
                                        Background="{StaticResource BrandSoftBgBrush}"
                                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid>
                                            <TextBlock x:Name="CurrentAccountAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="微" />
                                            <Image x:Name="CurrentAccountAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="CurrentAccountNameText" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="等待识别个人微信" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CurrentAccountIdText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="登录电脑微信后自动识别头像与账号资料" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="CurrentAccountBioText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>

                                <!-- Metrics Row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="已托管档案" />
                                            <TextBlock x:Name="KpiMonitoredText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="0 客户 · 0 群" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="上次同步" />
                                            <TextBlock x:Name="KpiLastSyncText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="等待新消息" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Unified Footer Actions -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WatchStatusSummaryText" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="自动监听待命中" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Height="28" Padding="10,0" Click="OpenWeChatPersonal_Click" Content="微信个人" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button Height="28" Padding="10,0" Click="OpenWeChatGroups_Click" Content="微信群聊" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT CARD: Enterprise WeCom 5.x -->
                        <Border
                            Grid.Column="1"
                            Padding="18,16"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource BrandSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <StackPanel Spacing="12">
                                <!-- Card Header -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="7">
                                            <FontIcon FontSize="13.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE731;" />
                                        </Border>
                                        <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="企业微信" />
                                        <Border
                                            x:Name="WeComStatusBadge"
                                            Padding="7,2"
                                            Background="{StaticResource AppInputBgBrush}"
                                            CornerRadius="9">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Ellipse x:Name="WeComStatusDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="WeComStatusBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="检测中" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <ToggleSwitch
                                        x:Name="WeComWatchToggle"
                                        MinWidth="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        OffContent="暂停"
                                        OnContent="监听中"
                                        Toggled="WeComWatchToggle_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                                <!-- Identity Block -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="46"
                                        Height="46"
                                        Background="{StaticResource InfoBgBrush}"
                                        BorderBrush="{StaticResource InfoBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock x:Name="WeComAvatarInitialText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="企" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="WeComPrimaryNameText" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="等待识别企业微信" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="WeComPrimarySubText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="自动读取本机企业微信全部企业空间" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="WeComCorpsSummaryText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- Metrics Row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="已识别企业与账号" />
                                            <TextBlock x:Name="WeComKpiCorpsText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="0 家企业" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="已导入托管" />
                                            <TextBlock x:Name="WeComKpiTotalsText" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="0 联系人 · 0 群" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Unified Footer Actions -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WeComWatchSummaryText" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="只读监听本地企微数据库" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Height="28" Padding="10,0" Click="OpenWeComPersonal_Click" Content="企微个人" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                        <Button Height="28" Padding="10,0" Click="OpenWeComGroups_Click" Content="企微群聊" FontSize="11.5" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Side-by-Side Account & Enterprise Directories -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Linked Personal WeChat Accounts -->
                        <Border
                            Grid.Column="0"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontSize="13" Foreground="{StaticResource SuccessTextBrush}" Glyph="&#xE77B;" />
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="已关联个人微信号" />
                                        <Border Padding="6,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                            <TextBlock x:Name="LinkedAccountsCountText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <TextBlock
                                        x:Name="EmptyAccountsHint"
                                        Margin="14,18"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="暂未关联个人微信账号，点击右上角「刷新同步双端」即可自动登记。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />

                                    <ListView
                                        x:Name="LinkedAccountsListView"
                                        MaxHeight="220"
                                        Padding="10,6"
                                        SelectionMode="None"
                                        Visibility="Collapsed">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0,3" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:WeChatAccountDto">
                                                <Border Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="34" Height="34" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="7">
                                                            <Grid>
                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind AvatarInitial}" Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                                <Image Source="{x:Bind AvatarImage, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                                <Border Padding="5,1" Background="{x:Bind StatusBadgeBgBrush, Mode=OneWay}" CornerRadius="6">
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind StatusBadgeFgBrush, Mode=OneWay}" Text="{x:Bind StatusLabel}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind CountsSummary}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: Discovered WeCom Enterprise Spaces -->
                        <Border
                            Grid.Column="1"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontSize="13" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE731;" />
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="已识别企业微信空间" />
                                        <Border Padding="6,1" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                            <TextBlock x:Name="WeComCorpsCountText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <TextBlock
                                        x:Name="EmptyWeComCorpsHint"
                                        Margin="14,18"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="暂未读取到企业微信空间，确认企业微信已登录后点击右上角「刷新同步双端」。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />

                                    <ListView
                                        x:Name="WeComCorpsListView"
                                        MaxHeight="220"
                                        Padding="10,6"
                                        SelectionMode="None"
                                        Visibility="Collapsed">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0,3" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Padding="10,8" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 3: Auto-Accept WeChat Friend Requests (OCR + Win32 RPA) -->
                    <Border
                        Padding="18,15"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <!-- Header -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                        <FontIcon FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE8FA;" />
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="自动同意微信好友申请（OCR 自动点击）" />
                                            <Border x:Name="AutoAcceptStatusBadge" Padding="7,2" Background="{StaticResource AppInputBgBrush}" CornerRadius="9">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Ellipse x:Name="AutoAcceptStatusDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" />
                                                    <TextBlock x:Name="AutoAcceptStatusText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="未开启" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="自动切入微信「通讯录 → 新的朋友」，通过 OCR 识别待验证申请并在「通过朋友验证」弹窗自动点击确定（操作期间按 ESC 随时中止）"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button
                                        x:Name="RunAutoAcceptNowButton"
                                        Height="30"
                                        Padding="12,0"
                                        Click="RunAutoAcceptNowButton_Click"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                                        ToolTipService.ToolTip="立即唤起电脑微信，通过 OCR 检查「新的朋友」并自动同意申请">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE768;" />
                                            <TextBlock Text="立即检测并同意" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleSwitch
                                        x:Name="AutoAcceptFriendToggle"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        OffContent="关闭"
                                        OnContent="开启"
                                        Toggled="AutoAcceptFriendToggle_Toggled" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource AppBorderSubtleBrush}" />

                            <!-- Settings Grid -->
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox
                                    x:Name="AutoAcceptModeCombo"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Header="触发方式"
                                    SelectionChanged="AutoAcceptConfig_Changed">
                                    <ComboBoxItem Content="智能免打扰（仅在微信有新动态时检测，推荐）" Tag="smart" />
                                    <ComboBoxItem Content="定时巡检（每 30 秒检查一次）" Tag="interval_30" />
                                    <ComboBoxItem Content="定时巡检（每 60 秒检查一次）" Tag="interval_60" />
                                    <ComboBoxItem Content="定时巡检（每 120 秒检查一次）" Tag="interval_120" />
                                </ComboBox>

                                <ComboBox
                                    x:Name="AutoAcceptPermissionCombo"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Header="通过后的朋友权限"
                                    SelectionChanged="AutoAcceptConfig_Changed">
                                    <ComboBoxItem Content="聊天、朋友圈、微信运动等（默认）" Tag="full" />
                                    <ComboBoxItem Content="仅聊天" Tag="chat_only" />
                                </ComboBox>

                                <TextBox
                                    x:Name="AutoAcceptRemarkBox"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Header="自动备注前缀（可选）"
                                    PlaceholderText="留空保持默认昵称，例如：新客-"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextChanged="AutoAcceptText_Changed" />

                                <TextBox
                                    x:Name="AutoAcceptTagBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Header="自动打标签（可选）"
                                    PlaceholderText="留空不设标签，例如：微信新好友"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextChanged="AutoAcceptText_Changed" />

                                <TextBox
                                    x:Name="AutoAcceptKeywordBox"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Header="验证消息关键词过滤（可选）"
                                    PlaceholderText="留空自动同意全部新好友申请；填写关键词则仅同意验证消息命中的申请（逗号分隔，如：咨询,合作,进群）"
                                    Style="{StaticResource SoftTextBoxStyle}"
                                    TextChanged="AutoAcceptText_Changed" />
                            </Grid>

                            <!-- Behavior Checkboxes -->
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <CheckBox x:Name="AutoAcceptIdleCheck" Content="仅在键鼠空闲时自动执行" IsChecked="True" Checked="AutoAcceptConfig_Changed" Unchecked="AutoAcceptConfig_Changed" />
                                <CheckBox x:Name="AutoAcceptReturnChatCheck" Content="完成后切回「聊天」页签" IsChecked="True" Checked="AutoAcceptConfig_Changed" Unchecked="AutoAcceptConfig_Changed" />
                                <CheckBox x:Name="AutoAcceptOverlayCheck" Content="显示点击位置指示" IsChecked="True" Checked="AutoAcceptConfig_Changed" Unchecked="AutoAcceptConfig_Changed" />
                                <CheckBox x:Name="AutoAcceptIncludeExpiredCheck" Content="同时处理「已过期」申请（前往验证）" IsChecked="False" Checked="AutoAcceptConfig_Changed" Unchecked="AutoAcceptConfig_Changed" />
                            </StackPanel>

                            <!-- Execution Summary & Records -->
                            <Border
                                Padding="12,8"
                                Background="{StaticResource AppSurfaceAltBrush}"
                                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock x:Name="AutoAcceptStatsText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="累计已自动同意 0 位好友 · 上次检测：尚未执行" />
                                        <Button Height="24" Padding="8,0" HorizontalAlignment="Right" Click="ClearAutoAcceptLogs_Click" Content="清空记录" FontSize="11" Style="{StaticResource SecondaryOutlineButtonStyle}" />
                                    </Grid>
                                    <ListView x:Name="AutoAcceptLogListView" MaxHeight="125" SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0,2" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Row 4: Sync Preferences + Live Activity Log -->
                    <Border
                        Padding="16,12"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <CheckBox x:Name="OptImagesCheck" Content="自动同步聊天图片" IsChecked="True" Checked="OptCheck_Changed" Unchecked="OptCheck_Changed" />
                            <CheckBox x:Name="OptAvatarsCheck" Content="自动同步好友与群头像" IsChecked="True" Checked="OptCheck_Changed" Unchecked="OptCheck_Changed" />
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="双端实时监听动态" />
                            </Border>

                            <ListView
                                x:Name="ActivityLogListView"
                                Grid.Row="1"
                                MinHeight="160"
                                MaxHeight="280"
                                Padding="14,8"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,3" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

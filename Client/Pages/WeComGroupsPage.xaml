<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WeComGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Client.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootThreePaneGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="278" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="CenterPaneColumn" Width="*" MinWidth="440" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="346" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: Enterprise-Grouped Imported WeCom Groups Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource AppSurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search + Multi-Select + Unified "+" Import Button -->
                <Border
                    Grid.Row="0"
                    Padding="10,0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Height="32"
                            Padding="8,5"
                            FontSize="12"
                            PlaceholderText="搜索已导入企微群..."
                            Style="{StaticResource SoftTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <Button
                            x:Name="MultiSelectGroupsButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="MultiSelectGroupsButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource SecondaryOutlineButtonStyle}"
                            ToolTipService.ToolTip="多选批量移除群聊">
                            <FontIcon x:Name="MultiSelectGroupsIcon" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE762;" />
                        </Button>
                        <Button
                            x:Name="AddWeComGroupButton"
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Click="AddWeComGroupButton_Click"
                            CornerRadius="6"
                            Style="{StaticResource PrimaryVioletButtonStyle}"
                            ToolTipService.ToolTip="从企业微信选择群聊导入">
                            <FontIcon FontSize="13" Foreground="#FFFFFF" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Compact Batch Remove Bar (Visible in Multi-Select Mode) -->
                <Border
                    x:Name="GroupMultiSelectBar"
                    Grid.Row="1"
                    Padding="8,5"
                    Background="{StaticResource BrandSoftBgBrush}"
                    BorderBrush="{StaticResource BrandSoftBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="4">
                        <TextBlock
                            x:Name="SelectedGroupsCountText"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandHighlightTextBrush}"
                            Text="已选 0" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button
                                Height="24"
                                Padding="7,0"
                                Click="SelectAllGroupsButton_Click"
                                Content="全选"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                            <Button
                                x:Name="RemoveSelectedGroupsButton"
                                Height="24"
                                Padding="7,0"
                                Click="RemoveSelectedGroupsButton_Click"
                                Content="移除"
                                FontSize="11"
                                IsEnabled="False"
                                Style="{StaticResource DangerOutlineButtonStyle}" />
                            <Button
                                Height="24"
                                Padding="7,0"
                                Click="ExitMultiSelectButton_Click"
                                Content="取消"
                                FontSize="11"
                                Style="{StaticResource SecondaryOutlineButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Enterprise Summary Strip -->
                <Border
                    Grid.Row="2"
                    Padding="10,6"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                    <TextBlock
                        x:Name="SidebarSummaryText"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="点击右上角「+」按企业导入监控群聊"
                        TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Enterprise-Grouped Collapsible Group List -->
                <Grid Grid.Row="3">
                    <ListView
                        x:Name="GroupsListView"
                        Padding="6,4"
                        IsItemClickEnabled="True"
                        ItemClick="GroupsListView_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:WeComSidebarRow">
                                <Grid>
                                    <!-- Enterprise Group Header -->
                                    <Border
                                        Margin="0,5,0,2"
                                        Padding="7,5"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{x:Bind CorpHeaderVisibility}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                            <FontIcon Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE731;" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind CorpName}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="3" Padding="6,1" VerticalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind CorpCountText}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Group Row -->
                                    <Border
                                        Margin="0,1"
                                        Padding="6,6"
                                        Background="{x:Bind RowBackground, Mode=OneWay}"
                                        BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Visibility="{x:Bind ItemRowVisibility}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Click="MultiSelectRowMenuItem_Click" Text="多选批量管理">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE762;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Click="RemoveGroupRowMenuItem_Click" Foreground="{StaticResource DangerTextBrush}" Text="从监控列表移除">
                                                    <MenuFlyoutItem.Icon><FontIcon Foreground="{StaticResource DangerTextBrush}" Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="GroupRowCheckBox_Click"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Visibility="{x:Bind ItemCheckVisibility, Mode=OneWay}" />

                                            <Border
                                                Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                Background="{StaticResource InfoBgBrush}"
                                                BorderBrush="{StaticResource InfoBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InfoTextBrush}" Text="{x:Bind AvatarInitial}" Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                                    <Image Source="{x:Bind AvatarImage, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon FontSize="9.5" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE718;" Visibility="{x:Bind PinnedVisibility}" />
                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <Border Padding="4,0.5" VerticalAlignment="Center" Background="{StaticResource AppBorderSubtleBrush}" CornerRadius="4" Visibility="{x:Bind TagBadgeVisibility}">
                                                            <TextBlock FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind TagBadgeText}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeShort}" />
                                                </Grid>

                                                <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind PreviewLine}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptySidebarHint" Margin="20,44" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="10" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂未导入企微群聊" />
                        <TextBlock x:Name="EmptySidebarText" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="点击下方或左上角「+」，按企业勾选要管理的企微群导入群成员与聊天记录。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Center" Height="32" Click="AddWeComGroupButton_Click" Content="从企业微信选择群聊导入" FontSize="12" Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Column 1: Left Splitter -->
        <controls:VerticalResizeSplitter x:Name="LeftPaneSplitter" Grid.Column="1" />

        <!-- Column 2: Group Chat Messages + Direct RPA Send -->
        <Grid Grid.Column="2" Background="{StaticResource AppChatCanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="132" />
            </Grid.RowDefinitions>

            <!-- Group Header -->
            <Border
                Grid.Row="0"
                Padding="18,0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveGroupTitle" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="请选择左侧企微群聊" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="ActiveCorpBadge" Padding="7,2" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="8" Visibility="Collapsed">
                                <TextBlock x:Name="ActiveCorpBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ActiveGroupMeta" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="点击左上角「+」按企业挑选并导入群聊，导入后按企业分组实时监听" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        x:Name="ReloadChatButton"
                        Grid.Column="1"
                        Height="30"
                        Padding="11,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}"
                        ToolTipService.ToolTip="刷新已导入企业微信群聊的最新群消息与群成员">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="12" Foreground="{StaticResource BrandPrimaryBrush}" Glyph="&#xE895;" />
                            <TextBlock Text="刷新同步" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Group Bubbles -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="EmptyChatHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <FontIcon FontSize="22" Foreground="{StaticResource InfoTextBrush}" Glyph="&#xE902;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="暂无群聊消息记录" />
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="从左侧选择已导入的企业群聊即可实时查看群消息" />
                </StackPanel>

                <ListView x:Name="MessagesListView" Padding="18,14" IsItemClickEnabled="False" SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatBubbleItem">
                            <Grid>
                                <!-- Incoming Group Message (Left with Sender Name) -->
                                <Grid ColumnSpacing="10" Visibility="{x:Bind IncomingVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind SenderInitial}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" MaxWidth="460" Spacing="3">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind SenderName, Mode=OneWay}" />
                                        <Border Padding="12,9" Background="{StaticResource ChatIncomingBgBrush}" BorderBrush="{StaticResource ChatIncomingBorderBrush}" BorderThickness="1" CornerRadius="4,10,10,10">
                                            <StackPanel Spacing="6">
                                                <controls:WeChatMessageContentView IsOutgoing="False" Text="{x:Bind Content, Mode=OneWay}" Visibility="{x:Bind ContentVisibility, Mode=OneWay}" />
                                                <Image MaxWidth="260" MaxHeight="220" Source="{x:Bind BubbleImage, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Outgoing Group Message (Right) -->
                                <Grid ColumnSpacing="10" Visibility="{x:Bind OutgoingVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Right" MaxWidth="460" Spacing="3">
                                        <Border Padding="12,9" Background="{StaticResource ChatOutgoingBgBrush}" CornerRadius="10,4,10,10">
                                            <StackPanel Spacing="6">
                                                <controls:WeChatMessageContentView IsOutgoing="True" Text="{x:Bind Content, Mode=OneWay}" Visibility="{x:Bind ContentVisibility, Mode=OneWay}" />
                                                <Image MaxWidth="260" MaxHeight="220" Source="{x:Bind BubbleImage, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind BubbleImageVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind TimeLabel, Mode=OneWay}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Text="我" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Bottom Direct RPA Group Composer -->
            <Border
                Grid.Row="2"
                Padding="14,10"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="SendInputBox"
                        Grid.Row="0"
                        AcceptsReturn="True"
                        FontSize="13"
                        PlaceholderText="输入要通过无 Hook RPA 发送到该企微群聊的消息..."
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="SendStatusText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="只读监听本地企业微信群库 · 发送时通过 OCR+RPA 自动确权" />
                        <Button
                            x:Name="SendMessageButton"
                            Height="30"
                            Padding="16,0"
                            HorizontalAlignment="Right"
                            Click="SendMessageButton_Click"
                            Content="发送到企微群"
                            FontSize="12"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryVioletButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Column 3: Right Splitter -->
        <controls:VerticalResizeSplitter x:Name="RightPaneSplitter" Grid.Column="3" />

        <!-- Column 4: Group Details & Members List -->
        <Border Grid.Column="4" Background="{StaticResource AppSurfaceBrush}">
            <Grid Padding="16,14" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Group Metadata Card -->
                <Border
                    Grid.Row="0"
                    Padding="13"
                    Background="{StaticResource AppSurfaceAltBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="7">
                        <TextBlock x:Name="ProfileGroupNameText" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="企微群聊档案" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProfileOwnerCorpText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="归属企业：-" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProfileRoomIdText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" IsTextSelectionEnabled="True" Text="chat_room_id: -" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProfileStatsText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="群成员 0 人 · 本地消息 0 条" />
                        <Border x:Name="AnnouncementCard" Padding="9,7" Background="{StaticResource BrandSoftBgBrush}" BorderBrush="{StaticResource BrandSoftBorderBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="群公告" />
                                <TextBlock x:Name="AnnouncementText" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Member Filter Header -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MembersHeaderText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="群成员 (0)" />
                    <TextBox
                        x:Name="MemberSearchBox"
                        Grid.Column="1"
                        Height="28"
                        Padding="8,4"
                        FontSize="11.5"
                        PlaceholderText="筛选成员..."
                        Style="{StaticResource SoftTextBoxStyle}"
                        TextChanged="MemberSearchBox_TextChanged" />
                </Grid>

                <!-- Members List -->
                <ListView x:Name="MembersListView" Grid.Row="2" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,3" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:WeComGroupMemberRow">
                            <Border Padding="8,6" Background="{StaticResource AppSurfaceAltBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="6">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind AvatarInitial}" Visibility="{x:Bind AvatarInitialVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind AvatarImage, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind AvatarImageVisibility, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Text="{x:Bind SubText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="5,1" VerticalAlignment="Center" Background="{StaticResource BrandSoftBgBrush}" CornerRadius="5" Visibility="{x:Bind RoleVisibility}">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Text="{x:Bind RoleText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

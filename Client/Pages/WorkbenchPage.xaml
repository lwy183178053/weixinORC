<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Apifox-style Top Workspace Chrome -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AppChromeBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Brand & Workspace Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border
                        Width="26"
                        Height="26"
                        Background="{StaticResource BrandPrimaryBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="智" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="智美员工工作台" />

                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource AppBorderBrush}" />

                    <!-- Active Workspace Tab Pill -->
                    <Border
                        Padding="12,5"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrandPrimaryBrush}" />
                            <TextBlock
                                x:Name="ActiveTabTitleText"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="微信监控与 OCR" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Draggable Center Title Bar Region -->
                <Grid x:Name="WorkbenchDragRegion" Grid.Column="1" Background="Transparent" />

                <!-- Right: Backend Env Pill + Employee Chip + Logout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border
                        Padding="10,4"
                        Background="{StaticResource BrandSoftBgBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                            <TextBlock
                                x:Name="TopBackendText"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandPrimaryBrush}"
                                Text="Go 后端 · 127.0.0.1:8080" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,3,10,3"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border
                                Width="20"
                                Height="20"
                                Background="{StaticResource BrandPrimaryBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="EmployeeInitialText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Text="M" />
                            </Border>
                            <TextBlock
                                x:Name="TopEmployeeNameText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="员工" />
                        </StackPanel>
                    </Border>

                    <Button
                        Height="28"
                        Padding="10,0"
                        Click="LogoutButton_Click"
                        Content="退出登录"
                        FontSize="12"
                        Style="{StaticResource SecondaryOutlineButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Primary Icon Rail + Active Module Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Apifox-style Left Narrow Icon Rail -->
            <Border
                Grid.Column="0"
                Background="{StaticResource AppRailBgBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
                        <Button
                            x:Name="RailOcrButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="ocr">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon x:Name="RailOcrIcon" FontSize="18" Glyph="&#xE8FE;" />
                                <TextBlock
                                    x:Name="RailOcrLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="微信OCR" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RailCustomersButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="customers">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon x:Name="RailCustomersIcon" FontSize="18" Glyph="&#xE716;" />
                                <TextBlock
                                    x:Name="RailCustomersLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="客户档案" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RailAboutButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="about">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon x:Name="RailAboutIcon" FontSize="18" Glyph="&#xE9D9;" />
                                <TextBlock
                                    x:Name="RailAboutLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Text="引擎状态" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="6">
                        <Button
                            Click="LogoutButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="退出登录并返回登录界面">
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Glyph="&#xF3B1;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="退出" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Module Frame -->
            <Frame x:Name="WorkspaceFrame" Grid.Column="1" />
        </Grid>

        <!-- Row 2: Apifox-style Thin Bottom Status Bar -->
        <Border
            Grid.Row="2"
            Padding="14,0"
            Background="#F7F8FC"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="在线" />
                    </StackPanel>
                    <TextBlock
                        x:Name="FooterEmployeeText"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="员工 ID: -" />
                    <TextBlock
                        x:Name="FooterOcrText"
                        FontSize="11.5"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="OCR 引擎: 加载中..." />
                </StackPanel>

                <TextBlock
                    x:Name="FooterRightText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="受控桌面识别模式 · 人工核验后落库" />
            </Grid>
        </Border>
    </Grid>
</Page>

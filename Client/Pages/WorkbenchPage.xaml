<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Workspace Chrome -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AppChromeBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image
                        Width="26"
                        Height="26"
                        Source="ms-appx:///Assets/AppIcon.png"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="智美员工工作台" />

                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource AppBorderBrush}" />

                    <Border
                        Padding="12,5"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrandPrimaryBrush}" />
                            <TextBlock
                                x:Name="ActiveTabTitleText"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="客户档案" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="WorkbenchDragRegion" Grid.Column="1" Background="Transparent" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border
                        x:Name="TopServerBadge"
                        Padding="10,4"
                        Background="{StaticResource BrandSoftBgBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                            <TextBlock
                                x:Name="TopBackendText"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandPrimaryBrush}"
                                Text="服务已连接" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,3,10,3"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border
                                Width="20"
                                Height="20"
                                Background="{StaticResource BrandPrimaryBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="EmployeeInitialText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Text="M" />
                            </Border>
                            <TextBlock
                                x:Name="TopEmployeeNameText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="员工" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Refined Slim Icon Rail + Active Module -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource AppRailBgBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="0,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="5">
                        <Button
                            x:Name="RailCustomersButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="customers"
                            ToolTipService.ToolTip="客户档案">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="RailCustomersIcon" FontSize="15" Glyph="&#xE77B;" />
                                <TextBlock x:Name="RailCustomersLabel" HorizontalAlignment="Center" FontSize="9.5" Text="客户档案" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RailGroupsButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="groups"
                            ToolTipService.ToolTip="群组档案">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="RailGroupsIcon" FontSize="15" Glyph="&#xE716;" />
                                <TextBlock x:Name="RailGroupsLabel" HorizontalAlignment="Center" FontSize="9.5" Text="群组档案" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RailOcrButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="ocr"
                            ToolTipService.ToolTip="微信监控">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="RailOcrIcon" FontSize="15" Glyph="&#xE7F4;" />
                                <TextBlock x:Name="RailOcrLabel" HorizontalAlignment="Center" FontSize="9.5" Text="微信监控" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RailGuideButton"
                            Click="RailNav_Click"
                            Style="{StaticResource RailButtonStyle}"
                            Tag="guide"
                            ToolTipService.ToolTip="使用介绍">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="RailGuideIcon" FontSize="15" Glyph="&#xE897;" />
                                <TextBlock x:Name="RailGuideLabel" HorizontalAlignment="Center" FontSize="9.5" Text="使用介绍" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Utility Cluster: Logout -> Theme Toggle -> Settings -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                        <Button
                            Click="LogoutButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="退出登录并返回登录界面">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xF3B1;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="退出" />
                            </StackPanel>
                        </Button>

                        <Border Width="26" Height="1" Margin="0,1" Background="{StaticResource AppBorderBrush}" />

                        <Button
                            x:Name="ThemeToggleButton"
                            Click="ThemeToggleButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="切换明亮 / 黑夜模式">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="ThemeToggleIcon" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE708;" />
                                <TextBlock x:Name="ThemeToggleLabel" HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="黑夜" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="打开应用设置">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE713;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="WorkspaceFrame" Grid.Column="1" />
        </Grid>

        <!-- Row 2: Bottom Status Bar -->
        <Border
            Grid.Row="2"
            Padding="14,0"
            Background="{StaticResource AppFooterBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="在线" />
                    </StackPanel>
                    <TextBlock x:Name="FooterEmployeeText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="员工 ID: -" />
                    <TextBlock x:Name="FooterOcrText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="识别服务: 就绪" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="Ctrl+V 快捷导入截图" />
            </Grid>
        </Border>
    </Grid>
</Page>

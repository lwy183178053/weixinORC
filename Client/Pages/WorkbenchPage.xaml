<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Client.Pages.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppCanvasBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Workspace Chrome -->
        <Border
            Grid.Row="0"
            Background="{StaticResource AppChromeBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image
                        Width="26"
                        Height="26"
                        Source="ms-appx:///Assets/AppIcon.png"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="智美员工工作台" />

                    <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource AppBorderBrush}" />

                    <Border
                        Padding="12,5"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrandPrimaryBrush}" />
                            <TextBlock
                                x:Name="ActiveTabTitleText"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="微信 · 微信个人" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="WorkbenchDragRegion" Grid.Column="1" Background="Transparent" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border
                        x:Name="TopServerBadge"
                        Padding="10,4"
                        Background="{StaticResource BrandSoftBgBrush}"
                        BorderBrush="{StaticResource BrandSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                            <TextBlock
                                x:Name="TopBackendText"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandPrimaryBrush}"
                                Text="服务已连接" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,3,10,3"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border
                                Width="20"
                                Height="20"
                                Background="{StaticResource BrandPrimaryBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="EmployeeInitialText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="#FFFFFF"
                                    Text="M" />
                            </Border>
                            <TextBlock
                                x:Name="TopEmployeeNameText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="员工" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Refined Slim Icon Rail (3 System Sections: WeChat / WeCom / Connector) + Active Module -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource AppRailBgBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="0,8,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <!-- Section 1: 微信（个微 + 企微 并列整体） -->
                            <TextBlock
                                Margin="0,2,0,1"
                                HorizontalAlignment="Center"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="微 信" />

                            <Button
                                x:Name="RailCustomersButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="customers"
                                ToolTipService.ToolTip="个人微信 · 客户监控与聊天记录">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailCustomersIcon" FontSize="14.5" Glyph="&#xE77B;" />
                                    <TextBlock x:Name="RailCustomersLabel" HorizontalAlignment="Center" FontSize="9.5" Text="微信个人" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RailGroupsButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="groups"
                                ToolTipService.ToolTip="个人微信 · 群聊监控与群组档案">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailGroupsIcon" FontSize="14.5" Glyph="&#xE716;" />
                                    <TextBlock x:Name="RailGroupsLabel" HorizontalAlignment="Center" FontSize="9.5" Text="微信群聊" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RailWeComContactsButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="wecom_contacts"
                                ToolTipService.ToolTip="企业微信 · 按企业分组的个人联系人监控">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailWeComContactsIcon" FontSize="14.5" Glyph="&#xE731;" />
                                    <TextBlock x:Name="RailWeComContactsLabel" HorizontalAlignment="Center" FontSize="9.5" Text="企微个人" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RailWeComGroupsButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="wecom_groups"
                                ToolTipService.ToolTip="企业微信 · 按企业分组的群聊监控">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailWeComGroupsIcon" FontSize="14.5" Glyph="&#xE902;" />
                                    <TextBlock x:Name="RailWeComGroupsLabel" HorizontalAlignment="Center" FontSize="9.5" Text="企微群聊" />
                                </StackPanel>
                            </Button>

                            <!-- Section 2: 监控与智能（拆出独立区块：双端监听 + AI 助手 + 自动回复） -->
                            <Border Width="28" Height="1" Margin="0,4,0,2" Background="{StaticResource AppBorderBrush}" />
                            <TextBlock
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="监 控" />

                            <Button
                                x:Name="RailOcrButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="ocr"
                                ToolTipService.ToolTip="个人微信与企业微信并列实时监听总览">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailOcrIcon" FontSize="14.5" Glyph="&#xE895;" />
                                    <TextBlock x:Name="RailOcrLabel" HorizontalAlignment="Center" FontSize="9.5" Text="双端监听" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RailAiButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="ai"
                                ToolTipService.ToolTip="AI 智能助手">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailAiIcon" FontSize="14.5" Glyph="&#xE99A;" />
                                    <TextBlock x:Name="RailAiLabel" HorizontalAlignment="Center" FontSize="9.5" Text="AI 助手" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="RailAutoReplyButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="autoreply"
                                ToolTipService.ToolTip="群 @ AI 自动回复配置与日志">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailAutoReplyIcon" FontSize="14.5" Glyph="&#xE97A;" />
                                    <TextBlock x:Name="RailAutoReplyLabel" HorizontalAlignment="Center" FontSize="9.5" Text="自动回复" />
                                </StackPanel>
                            </Button>

                            <!-- Section 3: 甲方接口服务（8990 个微 / 8989 企微） -->
                            <Border Width="28" Height="1" Margin="0,4,0,2" Background="{StaticResource AppBorderBrush}" />
                            <TextBlock
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="接 口" />

                            <Button
                                x:Name="RailBridgeButton"
                                Click="RailNav_Click"
                                Style="{StaticResource RailButtonStyle}"
                                Tag="bridge"
                                ToolTipService.ToolTip="甲方双端口接口服务（8990 个人微信 / 8989 企业微信）">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <FontIcon x:Name="RailBridgeIcon" FontSize="14.5" Glyph="&#xE968;" />
                                    <TextBlock x:Name="RailBridgeLabel" HorizontalAlignment="Center" FontSize="9.5" Text="接口服务" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Utility Cluster: Logout -> Theme Toggle -> Settings -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                        <Button
                            Click="LogoutButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="退出登录并返回登录界面">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xF3B1;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="退出" />
                            </StackPanel>
                        </Button>

                        <Border Width="26" Height="1" Margin="0,1" Background="{StaticResource AppBorderBrush}" />

                        <Button
                            x:Name="ThemeToggleButton"
                            Click="ThemeToggleButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="切换明亮 / 黑夜模式">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon x:Name="ThemeToggleIcon" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE708;" />
                                <TextBlock x:Name="ThemeToggleLabel" HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="黑夜" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTipService.ToolTip="打开应用设置">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <FontIcon FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" Glyph="&#xE713;" />
                                <TextBlock HorizontalAlignment="Center" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Frame x:Name="WorkspaceFrame" />

                <!-- Global Floating Toast Notification (Non-blocking, single-slot deduplicated, auto-dismiss) -->
                <Border
                    x:Name="GlobalToastBorder"
                    MaxWidth="560"
                    MinWidth="220"
                    Margin="20,12,20,0"
                    Padding="14,9,10,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource SuccessBgBrush}"
                    BorderBrush="{StaticResource SuccessTextBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="100"
                    CornerRadius="10"
                    Opacity="0"
                    Translation="0,0,28"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="GlobalToastIcon"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13.5"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            x:Name="GlobalToastText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            FontWeight="Medium"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            MaxLines="3"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DismissToastButton_Click"
                            CornerRadius="5"
                            ToolTipService.ToolTip="关闭提示">
                            <FontIcon FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Glyph="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 2: Bottom Status Bar -->
        <Border
            Grid.Row="2"
            Padding="14,0"
            Background="{StaticResource AppFooterBgBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="在线" />
                    </StackPanel>
                    <TextBlock x:Name="FooterEmployeeText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="员工 ID: -" />
                    <TextBlock x:Name="FooterOcrText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="微信自动监听: 启动中..." />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="个微与企微双端协同 · 实时只读监听消息变化" />
            </Grid>
        </Border>
    </Grid>
</Page>
